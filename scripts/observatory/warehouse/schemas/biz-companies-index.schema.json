{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tompickup.co.uk/schemas/observatory/biz-companies-index.schema.json",
  "title": "biz-companies-index.json",
  "description": "The dossier directory. hasWebsite must agree with the dossiers themselves, which is the invariant that correctly blocked the 8 August deploy; validate_outputs.py owns that cross-file check and the schema owns the shape.",
  "type": "object",
  "required": [
    "$meta",
    "companies"
  ],
  "properties": {
    "$meta": {
      "type": "object",
      "required": [
        "generated"
      ],
      "properties": {
        "generated": {
          "type": "string"
        },
        "criteria": {
          "type": "string",
          "minLength": 20
        },
        "websites": {
          "type": "object",
          "properties": {
            "verified": {
              "type": "integer",
              "minimum": 0
            },
            "ofCompanies": {
              "type": "integer",
              "minimum": 0
            },
            "matchRatePct": {
              "$ref": "#/$defs/pct"
            }
          }
        }
      }
    },
    "companies": {
      "type": "array",
      "minItems": 500,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "crn",
          "name"
        ],
        "properties": {
          "crn": {
            "$ref": "#/$defs/crn"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "lad": {
            "type": [
              "string",
              "null"
            ]
          },
          "hasWebsite": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": [
        "generated"
      ],
      "properties": {
        "generated": {
          "type": "string",
          "minLength": 4
        },
        "methodologyVersion": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "description": "Gate V-R3 wants asAt AND retrievedAt AND licence on every entry. The live contract carries name, url, retrieved and licence and no asAt at all, so the schema requires the fields the contract has and check_schemas.py counts the gap. Raising asAt to required here would block every deploy over a change that moves published files.",
            "required": [
              "name",
              "licence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string"
              },
              "retrieved": {
                "type": "string"
              },
              "asAt": {
                "type": "string"
              },
              "licence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "pct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "crn": {
      "type": "string",
      "pattern": "^[0-9A-Z]{8}$",
      "description": "Every Companies House registered number is exactly eight uppercase alphanumerics. The narrower two-letters-plus-six-digits test rejects 99 real companies, 93 of them pre-1922 Northern Ireland R-prefix registrations (DATA-INTEGRITY s9.3)."
    }
  }
}

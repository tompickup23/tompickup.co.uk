{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tompickup.co.uk/schemas/observatory/biz-watch.schema.json",
  "title": "biz-watch.json",
  "description": "Distress watch: verbatim register and Gazette facts with their source link, no commentary fields. The winding-up petition suppression is a LEGAL.md blocker and is asserted here so a petition cannot reach the file even if an upstream filter regresses.",
  "type": "object",
  "required": [
    "$meta",
    "summary",
    "notices",
    "strikeOffs"
  ],
  "properties": {
    "$meta": {
      "$ref": "#/$defs/meta"
    },
    "summary": {
      "type": "object"
    },
    "notices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/notice"
      }
    },
    "strikeOffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/strikeOff"
      }
    },
    "strikeOffTotal": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": [
        "generated"
      ],
      "properties": {
        "generated": {
          "type": "string",
          "minLength": 4
        },
        "methodologyVersion": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "description": "Gate V-R3 wants asAt AND retrievedAt AND licence on every entry. The live contract carries name, url, retrieved and licence and no asAt at all, so the schema requires the fields the contract has and check_schemas.py counts the gap. Raising asAt to required here would block every deploy over a change that moves published files.",
            "required": [
              "name",
              "licence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string"
              },
              "retrieved": {
                "type": "string"
              },
              "asAt": {
                "type": "string"
              },
              "licence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "pct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "crn": {
      "type": "string",
      "pattern": "^[0-9A-Z]{8}$",
      "description": "Every Companies House registered number is exactly eight uppercase alphanumerics. The narrower two-letters-plus-six-digits test rejects 99 real companies, 93 of them pre-1922 Northern Ireland R-prefix registrations (DATA-INTEGRITY s9.3)."
    },
    "notice": {
      "type": "object",
      "required": [
        "date",
        "type",
        "company",
        "uri"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(?i)petition"
          },
          "description": "LEGAL.md red: winding-up petitions are suppressed until an outcome is recorded."
        },
        "company": {
          "type": "string",
          "minLength": 1
        },
        "crn": {
          "type": [
            "string",
            "null"
          ]
        },
        "lad": {
          "type": [
            "string",
            "null"
          ]
        },
        "sic2": {
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "type": "string",
          "pattern": "^https://www\\.thegazette\\.co\\.uk/",
          "description": "A notice without its own Gazette link is not a verbatim extract, it is an assertion."
        }
      }
    },
    "strikeOff": {
      "type": "object",
      "required": [
        "company",
        "status",
        "asAt"
      ],
      "properties": {
        "company": {
          "type": "string",
          "minLength": 1
        },
        "crn": {
          "type": [
            "string",
            "null"
          ]
        },
        "lad": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "asAt": {
          "type": "string",
          "minLength": 4,
          "description": "s4: a register status is a dated fact or it is nothing."
        }
      }
    }
  }
}

---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieNotice from '../components/CookieNotice.astro';
import { person } from '../data/person';
import { DEFAULT_OG_IMAGE, DEFAULT_OG_IMAGE_ALT } from '../data/seo';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/400-italic.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/source-serif-4/600-italic.css';
import sansLatin400 from '@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url';
import serifLatin600 from '@fontsource/source-serif-4/files/source-serif-4-latin-600-normal.woff2?url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /* Describes the share image for screen readers on platforms that show it. */
  ogImageAlt?: string;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  /* Page-specific structured data. When set it replaces the automatic
     WebPage node; the BreadcrumbList is still emitted alongside it. */
  schema?: Record<string, unknown>;
  /* Overrides the last breadcrumb label, which is otherwise derived from the URL. */
  breadcrumbLabel?: string;
  /* Keeps the old dark styling inside <main>, for the LGR pages until they are
     rebuilt on the light design. */
  legacyDark?: boolean;
}

const {
  title,
  description = 'Tom Pickup, Reform UK county councillor for Padiham and Burnley West and Cabinet Member for Adult Social Care. Investigations into how public money is spent in Lancashire.',
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt,
  article = false,
  publishedTime,
  modifiedTime,
  tags = [],
  schema,
  breadcrumbLabel,
  legacyDark = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Search Console ownership. tompickup.co.uk's DNS is at one.com, so this is the
// HTML-tag method rather than a TXT record. The token is public (it ships in the
// HTML of every verified site) and is hard-coded on purpose: this site deploys by
// hand, and a build that quietly missed a .env would silently unverify the
// property. Removing this tag breaks verification. Env var overrides if ever needed.
const GOOGLE_SITE_VERIFICATION = 'vb4uNee1F78RASgAx6LVTwfRdyWz2XkrMoCc4RfJjKU';
const googleSiteVerification =
  import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || GOOGLE_SITE_VERIFICATION;

const isHome = Astro.url.pathname === '/';
/* The LGR pages keep their dark styling until they are rebuilt on the finished
   LGR work. Matched by path so those files need no edit in the meantime. */
const keepDark = legacyDark || Astro.url.pathname.startsWith('/lgr');
const isComingSoon = Astro.url.pathname === '/coming-soon' || Astro.url.pathname === '/coming-soon/';
const maintenanceMode = false;

/* Structured data for ordinary pages.

   Articles bring their own NewsArticle + BreadcrumbList from BlogPost.astro and the
   home page has its WebSite + Person graph, but until now every other page on the
   site emitted no JSON-LD at all: /about/, /contact/, the whole DOGE section, the
   LGR pages, and the legal pages. Rather than patch each one, the default is built
   here from the URL, so a page added later cannot quietly regress. */
const SEGMENT_LABELS: Record<string, string> = {
  doge: 'DOGE',
  lgr: 'Local Government Reorganisation',
  lancs: 'Lancashire',
  'burnley-council': 'Burnley Borough Council',
  news: 'News',
};

function labelFor(segment: string): string {
  if (SEGMENT_LABELS[segment]) return SEGMENT_LABELS[segment];
  /* A financial year like 2025-26 is not a phrase to title case. */
  if (/^\d{4}-\d{2}$/.test(segment)) return segment.replace('-', '/');
  return segment
    .split('-')
    .map((w) => (w.length > 2 ? w[0].toUpperCase() + w.slice(1) : w))
    .join(' ');
}

const segments = Astro.url.pathname.split('/').filter(Boolean);

const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tompickup.co.uk/' },
  ...segments.map((segment, i) => {
    const isLast = i === segments.length - 1;
    return {
      '@type': 'ListItem',
      position: i + 2,
      name: isLast && breadcrumbLabel ? breadcrumbLabel : labelFor(segment),
      item: `https://tompickup.co.uk/${segments.slice(0, i + 1).join('/')}/`,
    };
  }),
];

/* Home and articles are already covered elsewhere; adding a second WebPage node
   for them would describe the same URL twice. */
const emitDefaultSchema = !isHome && !article;

const pageSchema = schema ?? {
  '@type': 'WebPage',
  '@id': canonicalURL.href,
  url: canonicalURL.href,
  name: title,
  description,
  inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://tompickup.co.uk/#website' },
  about: { '@id': 'https://tompickup.co.uk/#person' },
};

const defaultGraph = {
  '@context': 'https://schema.org',
  '@graph': [pageSchema, { '@type': 'BreadcrumbList', itemListElement: breadcrumbItems }],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#faf9f5" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}

    {/* Large image previews are a precondition for Google Discover and Top Stories
        image treatment. Without this Google assumes a thumbnail-sized preview. */}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Feed autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title="Tom Pickup" href="https://tompickup.co.uk/rss.xml" />

    {/* MAINTENANCE MODE: Redirect all pages to coming-soon */}
    {maintenanceMode && !isComingSoon && (
      <meta http-equiv="refresh" content="0;url=/coming-soon" />
    )}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Marks JS as running; scroll-reveal hidden states are gated on html.js
         so content is never invisible when scripts fail or load slowly -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Cloudflare Web Analytics --><script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "d166519fc11d4f12b9bd7b7d91ceac40"}'></script><!-- End Cloudflare Web Analytics -->

    {/* Source Sans 3 and Source Serif 4 are self-hosted via @fontsource (imported in
        the frontmatter): no third-party font request. The two faces every page uses
        above the fold are preloaded so the swap happens before first paint. */}
    <link rel="preload" href={sansLatin400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin600} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    {ogImage === DEFAULT_OG_IMAGE && <meta property="og:image:width" content="1200" />}
    {ogImage === DEFAULT_OG_IMAGE && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt ?? (ogImage === DEFAULT_OG_IMAGE ? DEFAULT_OG_IMAGE_ALT : title)} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Tom Pickup" />

    {/* Article-specific OG tags for Google News / Facebook */}
    {article && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {article && (modifiedTime || publishedTime) && (
      <meta property="article:modified_time" content={modifiedTime || publishedTime} />
    )}
    {article && (
      <meta property="article:author" content="https://tompickup.co.uk/about/" />
    )}
    {article && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@tompickup" />
    <meta name="twitter:creator" content="@tompickup" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? (ogImage === DEFAULT_OG_IMAGE ? DEFAULT_OG_IMAGE_ALT : title)} />

    {emitDefaultSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(defaultGraph)} />
    )}

    {/* Site identity graph, home page only.
        WebSite.name is what Google uses to pick the site name shown in search and,
        since Publisher Center stopped gating it, the publication title in Google News.
        The Person node is the author entity every NewsArticle points back to. */}
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': 'https://tompickup.co.uk/#website',
            name: 'Tom Pickup',
            alternateName: 'Tom Pickup, Lancashire',
            url: 'https://tompickup.co.uk/',
            inLanguage: 'en-GB',
            publisher: { '@id': 'https://tompickup.co.uk/#person' },
          },
          person,
        ],
      })} />
    )}
  </head>
  <body>
    <a href="#main" class="skip-to-content">Skip to content</a>

    <Header />

    <main id="main" class:list={[{ 'legacy-dark': keepDark }]}>
      <slot />
    </main>

    <Footer />
    <CookieNotice />

    <!-- Scroll reveal observer -->
    <script>
      if (typeof IntersectionObserver !== 'undefined') {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );

        document.querySelectorAll('.reveal').forEach((el) => {
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* Page content clears the fixed header */
  main {
    padding-top: 64px;
    min-height: calc(100dvh - 64px);
  }
</style>

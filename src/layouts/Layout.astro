---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieNotice from '../components/CookieNotice.astro';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
}

const {
  title,
  description = 'Tom Pickup, Reform UK county councillor for Padiham and Burnley West and Cabinet Member for Adult Social Care. Investigations into how public money is spent in Lancashire.',
  ogImage = '/images/headshot.jpg',
  article = false,
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Search Console ownership. tompickup.co.uk's DNS is at one.com, so this is the
// HTML-tag method rather than a TXT record. The token is public (it ships in the
// HTML of every verified site) and is hard-coded on purpose: this site deploys by
// hand, and a build that quietly missed a .env would silently unverify the
// property. Removing this tag breaks verification. Env var overrides if ever needed.
const GOOGLE_SITE_VERIFICATION = 'vb4uNee1F78RASgAx6LVTwfRdyWz2XkrMoCc4RfJjKU';
const googleSiteVerification =
  import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || GOOGLE_SITE_VERIFICATION;
const isHome = Astro.url.pathname === '/';
const isComingSoon = Astro.url.pathname === '/coming-soon' || Astro.url.pathname === '/coming-soon/';
const maintenanceMode = false;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}

    {/* Large image previews are a precondition for Google Discover and Top Stories
        image treatment. Without this Google assumes a thumbnail-sized preview. */}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Feed autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title="Tom Pickup" href="https://tompickup.co.uk/rss.xml" />

    {/* MAINTENANCE MODE: Redirect all pages to coming-soon */}
    {maintenanceMode && !isComingSoon && (
      <meta http-equiv="refresh" content="0;url=/coming-soon" />
    )}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Marks JS as running; scroll-reveal hidden states are gated on html.js
         so content is never invisible when scripts fail or load slowly -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Cloudflare Web Analytics --><script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "d166519fc11d4f12b9bd7b7d91ceac40"}'></script><!-- End Cloudflare Web Analytics -->

    {/* Inter is self-hosted via @fontsource (imported in the frontmatter):
        no third-party font request, no render-blocking round-trip, no swap flash */}

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Tom Pickup" />

    {/* Article-specific OG tags for Google News / Facebook */}
    {article && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {article && (modifiedTime || publishedTime) && (
      <meta property="article:modified_time" content={modifiedTime || publishedTime} />
    )}
    {article && (
      <meta property="article:author" content="https://tompickup.co.uk/about/" />
    )}
    {article && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@tompickup" />
    <meta name="twitter:creator" content="@tompickup" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    {/* Site identity graph, home page only.
        WebSite.name is what Google uses to pick the site name shown in search and,
        since Publisher Center stopped gating it, the publication title in Google News.
        The Person node is the author entity every NewsArticle points back to. */}
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': 'https://tompickup.co.uk/#website',
            name: 'Tom Pickup',
            alternateName: 'Tom Pickup, Lancashire',
            url: 'https://tompickup.co.uk/',
            inLanguage: 'en-GB',
            publisher: { '@id': 'https://tompickup.co.uk/#person' },
            potentialAction: {
              '@type': 'SearchAction',
              target: {
                '@type': 'EntryPoint',
                urlTemplate: 'https://tompickup.co.uk/news/?q={search_term_string}',
              },
              'query-input': 'required name=search_term_string',
            },
          },
          {
            '@type': 'Person',
            '@id': 'https://tompickup.co.uk/#person',
            name: 'Tom Pickup',
            url: 'https://tompickup.co.uk/',
            image: 'https://tompickup.co.uk/images/headshot.jpg',
            jobTitle: 'County Councillor for Padiham and Burnley West',
            worksFor: {
              '@type': 'GovernmentOrganization',
              name: 'Lancashire County Council',
              url: 'https://www.lancashire.gov.uk/',
            },
            memberOf: { '@type': 'PoliticalParty', name: 'Reform UK' },
            knowsAbout: [
              'Local government finance',
              'Adult social care',
              'Public spending transparency',
              'Lancashire',
            ],
            sameAs: [
              'https://x.com/tompickup',
              'https://www.facebook.com/tompickupburnley',
              'https://www.instagram.com/tompickupburnley',
            ],
          },
        ],
      })} />
    )}
  </head>
  <body>
    <a href="#main" class="skip-to-content">Skip to content</a>

    <Header />

    <main id="main" class="noise-overlay">
      <slot />
    </main>

    <Footer />
    <CookieNotice />

    <!-- Scroll reveal observer -->
    <script>
      if (typeof IntersectionObserver !== 'undefined') {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );

        document.querySelectorAll('.reveal').forEach((el) => {
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* Ambient gradient orbs - decorative background.
     blur(100px) on two fixed full-viewport layers is a continuous GPU cost, so
     the orbs are dropped on small screens: most mobile traffic arrives via the
     Facebook in-app browser on mid-range phones, where this costs scroll frames. */
  body::before,
  body::after {
    content: '';
    position: fixed;
    border-radius: 50%;
    pointer-events: none;
    z-index: -1;
    filter: blur(100px);
  }

  @media (max-width: 768px) {
    body::before,
    body::after {
      display: none;
    }
  }

  body::before {
    top: -15%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(18, 182, 207, 0.12) 0%, transparent 70%);
    animation: gradientShift 20s ease-in-out infinite;
  }

  body::after {
    bottom: -10%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(18, 182, 207, 0.08) 0%, transparent 70%);
    animation: gradientShift 25s ease-in-out infinite reverse;
  }

  /* Page content needs padding for fixed header */
  main {
    padding-top: 72px;
    min-height: calc(100dvh - 72px);
  }
</style>

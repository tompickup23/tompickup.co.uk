---
import Layout from './Layout.astro';
import { DEFAULT_OG_IMAGE } from '../data/seo';
import { isoDate } from '../lib/dates';
import EmailSignup from '../components/EmailSignup.astro';
import AuthorBox from '../components/AuthorBox.astro';
import DataBox from '../components/DataBox.astro';
import Sources from '../components/Sources.astro';
import { person } from '../data/person';
import { Image } from 'astro:assets';
import { articleImage, imageQuality, shareImageUrl } from '../lib/images';

interface Props {
  frontmatter: {
    title: string;
    date: Date;
    description: string;
    tags: string[];
    featured?: boolean;
    updated?: Date;
    image?: string;
    imageAlt?: string;
    imageUncropped?: boolean;
    ogImage?: string;
    imageCredit?: string;
    category?: string;
    subcategory?: string;
    sources?: { text: string; url: string }[];
    data?: {
      links: { label: string; url: string }[];
      csv?: string;
      method?: string;
      doi?: string;
      title?: string;
      year?: number;
    };
  };
}

const { frontmatter } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(frontmatter.date);

const currentUrl = Astro.url.href;
const fullUrl = new URL(Astro.url.pathname, Astro.site).href;
const twitterShareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(frontmatter.title)}&url=${encodeURIComponent(fullUrl)}`;
const facebookShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(fullUrl)}`;
const whatsappShareUrl = `https://wa.me/?text=${encodeURIComponent(frontmatter.title + ' ' + fullUrl)}`;

// Estimate reading time from slot content
const wordsPerMinute = 220;
const rawContent = await Astro.slots.render('default');
const textContent = rawContent.replace(/<[^>]*>/g, '');
const wordCount = textContent.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / wordsPerMinute));

/* Google truncates the title around 60 characters, and the brand suffix is the
   least useful part of it: the site name is already carried by the WebSite node
   and shown separately in search results. So append it only when it fits, rather
   than pushing a headline out to 104 characters and losing the end of the claim. */
const heroMeta = articleImage(frontmatter.image);
const heroAlt = frontmatter.imageAlt || `Lead image for the article: ${frontmatter.title}`;
const shareImage =
  frontmatter.ogImage || (await shareImageUrl(frontmatter.image)) || DEFAULT_OG_IMAGE;

const BRAND_SUFFIX = ' | Tom Pickup';
const pageTitle =
  frontmatter.title.length + BRAND_SUFFIX.length <= 60
    ? frontmatter.title + BRAND_SUFFIX
    : frontmatter.title;
---

<Layout
  title={pageTitle}
  description={frontmatter.description}
  article={true}
  ogImage={shareImage}
  ogImageAlt={frontmatter.ogImage ? undefined : frontmatter.imageAlt}
  publishedTime={isoDate(frontmatter.date)}
  modifiedTime={isoDate(frontmatter.updated || frontmatter.date)}
  tags={frontmatter.tags}
>
  <!-- NewsArticle structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': new URL(`/news/${Astro.params.slug || ''}/`, Astro.site).href,
    },
    headline: frontmatter.title,
    description: frontmatter.description,
    datePublished: isoDate(frontmatter.date),
    dateModified: isoDate(frontmatter.updated || frontmatter.date),
    image: [new URL(shareImage, Astro.site).href],
    /* The full Person node is on / and /about/ (src/data/person.ts); the @id
       joins them. Name and url stay inline because Google reads author per page. */
    author: {
      '@type': 'Person',
      '@id': person['@id'],
      name: person.name,
      url: person.url,
      jobTitle: person.jobTitle,
    },
    publisher: {
      '@type': 'Person',
      '@id': person['@id'],
      name: person.name,
      url: person.url,
    },
    isAccessibleForFree: true,
    wordCount: wordCount,
    keywords: frontmatter.tags.join(', '),
    inLanguage: 'en-GB',
    ...(frontmatter.category ? { articleSection: frontmatter.subcategory
      ? `${frontmatter.category} / ${frontmatter.subcategory}`
      : frontmatter.category } : {}),
    /* Local relevance is one of the factors Google names for News ranking.
       Nearly everything here is about the same place, so say so. */
    contentLocation: {
      '@type': 'Place',
      name: 'Lancashire, England',
      address: {
        '@type': 'PostalAddress',
        addressRegion: 'Lancashire',
        addressCountry: 'GB',
      },
    },
  })} />

  {/* A deposited dataset gets its own Dataset node, which Google Dataset Search
      indexes. Only once it has a DOI: before that there is no stable record to point at. */}
  {frontmatter.data?.doi && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      '@id': `https://doi.org/${frontmatter.data.doi}`,
      name: frontmatter.data.title ?? frontmatter.title,
      description: frontmatter.data.method ?? frontmatter.description,
      url: `https://doi.org/${frontmatter.data.doi}`,
      identifier: `https://doi.org/${frontmatter.data.doi}`,
      creator: { '@id': person['@id'] },
      license: 'https://creativecommons.org/licenses/by/4.0/',
      isAccessibleForFree: true,
      inLanguage: 'en-GB',
      isBasedOn: frontmatter.data.links.map((link) => link.url),
      subjectOf: { '@id': new URL(`/news/${Astro.params.slug || ''}/`, Astro.site).href },
      ...(frontmatter.data.year ? { datePublished: String(frontmatter.data.year) } : {}),
    })} />
  )}

  <!-- BreadcrumbList structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tompickup.co.uk/' },
      { '@type': 'ListItem', position: 2, name: 'News', item: 'https://tompickup.co.uk/news/' },
      { '@type': 'ListItem', position: 3, name: frontmatter.title },
    ],
  })} />

  <div class="blog-post">
    <header class="article-header">
      <a href="/news/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to News
      </a>

      {(frontmatter.category || frontmatter.subcategory) && (
        <p class="article-category">{frontmatter.subcategory === 'Public debates'
          ? <>{frontmatter.category && `${frontmatter.category} › `}<a href="/news/public-debates/">Public debates</a></>
          : [frontmatter.category, frontmatter.subcategory].filter(Boolean).join(' › ')}</p>
      )}

      <h1 class="article-title">{frontmatter.title}</h1>

      <div class="article-meta">
        <time datetime={isoDate(frontmatter.date)}>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4.5 1V3M9.5 1V3M1 5.5H13M2 2.5H12C12.5523 2.5 13 2.94772 13 3.5V12C13 12.5523 12.5523 13 12 13H2C1.44772 13 1 12.5523 1 12V3.5C1 2.94772 1.44772 2.5 2 2.5Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {formattedDate}
        </time>

        <span class="reading-time">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2"/>
            <path d="M7 3.5V7L9.5 8.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {readingTime} min read
        </span>
      </div>

      {frontmatter.tags.length > 0 && (
        <div class="article-tags">
          {frontmatter.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    {frontmatter.image && (
      <div class:list={['article-hero-image', { 'hero-uncropped': frontmatter.imageUncropped }]}>
        {heroMeta ? (
          <Image
            src={heroMeta}
            alt={heroAlt}
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 800px) calc(100vw - 40px), 760px"
            format="webp"
            quality={imageQuality(frontmatter.image)}
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <img src={frontmatter.image} alt={heroAlt} loading="eager" decoding="async" />
        )}
        {frontmatter.imageCredit && <span class="hero-credit">{frontmatter.imageCredit}</span>}
      </div>
    )}

    <article class="prose">
      <slot />
    </article>

    {frontmatter.data && <DataBox {...frontmatter.data} />}
    {frontmatter.sources && <Sources items={frontmatter.sources} />}

    <footer class="article-footer">
      <AuthorBox />

      <div class="share-buttons">
        <span class="share-label">Share this post:</span>
        <button class="share-btn" id="copy-link-btn" data-url={currentUrl} aria-label="Copy link to clipboard">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6.5 8.5C6.82588 8.94689 7.2444 9.31528 7.72717 9.58157C8.20994 9.84787 8.74512 10.0059 9.29489 10.0446C9.84467 10.0833 10.3961 10.0018 10.9104 9.80585C11.4246 9.6099 11.889 9.30412 12.272 8.91L14.272 6.91C14.9635 6.19113 15.3444 5.23175 15.3332 4.23537C15.322 3.23899 14.9195 2.28836 14.2116 1.58437C13.5037 0.880387 12.5508 0.483587 11.5544 0.478745C10.558 0.473903 9.60153 0.861263 8.886 1.556L7.706 2.728" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9.5 7.5C9.17412 7.05311 8.7556 6.68472 8.27283 6.41843C7.79006 6.15213 7.25488 5.99413 6.70511 5.95541C6.15533 5.9167 5.60389 5.99821 5.08964 6.19415C4.57539 6.3901 4.11098 6.69588 3.728 7.09L1.728 9.09C1.03647 9.80887 0.655554 10.7683 0.666757 11.7646C0.67796 12.761 1.08045 13.7116 1.78836 14.4156C2.49627 15.1196 3.44924 15.5164 4.44563 15.5213C5.44201 15.5261 6.39847 15.1387 7.114 14.444L8.286 13.272" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="btn-text">Copy link</span>
        </button>

        <a href={twitterShareUrl} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Share on X / Twitter">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12.6 0H15.05L9.69 6.08L16 14.77H11.06L7.19 9.61L2.77 14.77H0.31L6.05 8.26L0 0H5.07L8.56 4.73L12.6 0ZM11.74 13.28H13.1L4.32 1.38H2.87L11.74 13.28Z" fill="currentColor"/>
          </svg>
          <span class="btn-text">Share on X</span>
        </a>

        <a href={facebookShareUrl} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Share on Facebook">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M16 8C16 3.58 12.42 0 8 0S0 3.58 0 8c0 3.99 2.93 7.3 6.75 7.9v-5.59H4.72V8h2.03V6.24c0-2 1.19-3.11 3.02-3.11.87 0 1.79.16 1.79.16v1.97h-1.01c-.99 0-1.3.62-1.3 1.25V8h2.22l-.36 2.31h-1.86v5.59C13.07 15.3 16 11.99 16 8z" fill="currentColor"/>
          </svg>
          <span class="btn-text">Facebook</span>
        </a>

        <a href={whatsappShareUrl} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Share on WhatsApp">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M13.6 2.33A7.93 7.93 0 008.01 0C3.63 0 .08 3.53.07 7.87a7.81 7.81 0 001.07 3.96L0 16l4.28-1.12a7.95 7.95 0 003.72.95h0c4.38 0 7.93-3.53 7.94-7.88a7.83 7.83 0 00-2.34-5.62zM8.01 14.41a6.6 6.6 0 01-3.36-.92l-.24-.14-2.5.65.67-2.43-.16-.25a6.53 6.53 0 01-1.01-3.46A6.52 6.52 0 018 1.36a6.48 6.48 0 014.6 1.9 6.46 6.46 0 011.91 4.62c0 3.59-2.93 6.53-6.5 6.53zm3.57-4.89c-.2-.1-1.16-.57-1.34-.63-.18-.07-.31-.1-.44.1-.13.2-.5.63-.62.77-.11.13-.23.15-.43.05-.2-.1-.83-.31-1.59-.98-.59-.52-.98-1.17-1.1-1.37-.11-.2-.01-.3.09-.4.09-.1.2-.25.3-.37.1-.13.13-.22.2-.37.07-.14.03-.27-.02-.37-.05-.1-.44-1.06-.6-1.46-.16-.38-.32-.33-.44-.34h-.38c-.13 0-.34.05-.52.25s-.68.66-.68 1.62.7 1.88.8 2.01c.1.13 1.37 2.1 3.33 2.94.47.2.83.32 1.11.41.47.15.89.13 1.23.08.37-.06 1.16-.47 1.32-.93.17-.46.17-.85.12-.93-.05-.09-.18-.13-.38-.23z" fill="currentColor"/>
          </svg>
          <span class="btn-text">WhatsApp</span>
        </a>
      </div>

      <!-- What You Can Do -->
      <div class="action-box">
        <h3>What you can do</h3>
        <ul class="action-list">
          <li><a href="/contact/">Get in touch</a></li>
          <li><a href="/news/">Read the latest news</a></li>
        </ul>
      </div>

      <!-- Email Signup -->
      <EmailSignup variant="inline" />

      <a href="/news/" class="back-link back-link-bottom">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to all news
      </a>
    </footer>
  </div>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.getAttribute('data-url') || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        const textEl = copyBtn.querySelector('.btn-text');
        if (textEl) {
          const original = textEl.textContent;
          textEl.textContent = 'Copied!';
          setTimeout(() => { textEl.textContent = original; }, 2000);
        }
      } catch {
        // Fallback for older browsers
        const textarea = document.createElement('textarea');
        textarea.value = url;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }
    });
  }
</script>

<style>
  .blog-post {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem var(--gutter) 4rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--touch);
    color: var(--muted);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 600;
  }

  .back-link:hover {
    color: var(--teal);
  }

  .article-header {
    max-width: 720px;
    margin: 0 auto 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .article-hero-image {
    position: relative;
    margin: 0 0 2.5rem;
  }

  .article-hero-image :global(img) {
    width: 100%;
    height: auto;
    display: block;
    max-height: 440px;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .hero-uncropped :global(img) { max-height: none; }

  .hero-credit {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .article-category {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--teal);
    margin: 1rem 0 0;
  }

  .article-category a {
    color: inherit;
  }

  .article-title {
    font-size: clamp(2rem, 4.6vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0.75rem 0 1.25rem;
    max-width: 22ch;
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--muted);
    font-size: 1rem;
  }

  .article-meta time,
  .article-meta .reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin-top: 0.75rem;
  }

  .tag {
    display: inline-block;
    padding: 0.1rem 0.5rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
  }

  /* ---- Prose ---- */
  .prose {
    max-width: 720px;
    margin: 0 auto;
    color: var(--ink);
    font-size: 1.1875rem;
    line-height: 1.7;
  }

  .prose :global(p) {
    margin-bottom: 1.35rem;
  }

  .prose :global(h2) {
    font-size: 1.75rem;
    line-height: 1.2;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    color: var(--ink);
    scroll-margin-top: 88px;
  }

  .prose :global(h3) {
    font-size: 1.375rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--ink);
    scroll-margin-top: 88px;
  }

  .prose :global(h4) {
    font-family: var(--font-sans);
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: 0;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--ink);
  }

  .prose :global(a) {
    color: var(--teal);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .prose :global(a:hover) {
    color: var(--ink);
    text-decoration-thickness: 2px;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }

  .prose :global(em) {
    font-style: italic;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--gold);
    padding: 0.25rem 0 0.25rem 1.25rem;
    margin: 1.75rem 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.55;
  }

  .prose :global(blockquote p) {
    margin-bottom: 0.5rem;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(ul li) { list-style-type: disc; }
  .prose :global(ol li) { list-style-type: decimal; }
  .prose :global(li::marker) { color: var(--muted); }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--panel);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    color: var(--ink);
  }

  .prose :global(pre) {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    overflow-x: auto;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    margin: 2rem 0;
  }

  .prose :global(figcaption) {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .prose :global(.article-photo-gallery) {
    columns: 2;
    column-gap: 1rem;
    margin: 1.5rem 0 2.5rem;
  }

  .prose :global(.article-photo-gallery figure) {
    break-inside: avoid;
    margin: 0 0 1rem;
    padding: 0;
  }

  .prose :global(.article-photo-gallery a) {
    display: block;
    border: 0;
  }

  .prose :global(.article-photo-gallery img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }

  .prose :global(.article-photo-gallery figcaption) {
    margin-top: 0.4rem;
    font-size: 0.875rem;
  }

  @media (max-width: 600px) {
    .prose :global(.article-photo-gallery) { columns: 1; }
  }

  /* Video embeds */
  .prose :global(.article-video) {
    margin: 2rem auto;
    max-width: 360px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .prose :global(.article-video video) {
    width: 100%;
    display: block;
  }

  .prose :global(.article-video-label) {
    text-align: center;
    font-size: 0.9375rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  /* Share-card images shown in the article body */
  .prose :global(.article-data-viz) {
    margin: 1.75rem auto;
    max-width: 560px;
  }

  .prose :global(.article-data-viz a) {
    display: block;
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .prose :global(.article-data-viz a:hover) {
    border-color: var(--teal);
  }

  .prose :global(.article-data-viz img) {
    width: 100%;
    height: auto;
    display: block;
    margin: 0;
    border-radius: 0;
  }

  .prose :global(.article-data-viz .download-hint) {
    display: block;
    text-align: center;
    font-size: 0.9375rem;
    color: var(--teal);
    padding: 10px;
    border-top: 1px solid var(--line);
    background: var(--surface);
    font-weight: 600;
  }

  .prose :global(.shareable-assets) {
    margin: 1rem auto;
    max-width: 360px;
  }

  .prose :global(.shareable-assets summary) {
    cursor: pointer;
    min-height: var(--touch);
    font-size: 1rem;
    color: var(--teal);
    font-weight: 600;
    text-align: center;
    padding: 0.6rem;
  }

  .prose :global(.share-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .prose :global(.share-grid a) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch);
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    color: var(--teal);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .prose :global(.share-grid a:hover) {
    border-color: var(--teal);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 2.5rem 0;
  }

  /* ---- Tables: flat, ruled, numbers aligned ---- */
  .prose :global(table) {
    width: 100%;
    table-layout: auto;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 1rem;
    line-height: 1.45;
    font-variant-numeric: tabular-nums;
  }

  .prose :global(th) {
    padding: 0.6rem 0.75rem;
    font-weight: 600;
    color: var(--ink);
    font-size: 0.9375rem;
    text-align: left;
    vertical-align: bottom;
    border-bottom: 2px solid var(--ink);
  }

  .prose :global(td) {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    vertical-align: top;
  }

  .prose :global(th:first-child),
  .prose :global(td:first-child) { padding-left: 0; text-align: left; width: auto; }
  .prose :global(th:last-child),
  .prose :global(td:last-child) { padding-right: 0; text-align: right; }

  .prose :global(td strong) { color: var(--ink); }

  .prose :global(.reform-row td) {
    color: var(--teal) !important;
    font-weight: 600;
    background: rgba(23, 100, 94, 0.06);
  }

  .prose :global(.reform-row td strong) { color: var(--teal) !important; }

  /* ---- Citations ---- */
  .prose :global(sup.cite) {
    font-size: 0.7em;
    line-height: 0;
    margin-left: 0.1em;
  }

  .prose :global(sup.cite a) {
    color: var(--teal);
    text-decoration: none;
    font-weight: 600;
    padding: 0 0.1em;
  }

  .prose :global(sup.cite a:hover) {
    color: var(--ink);
    text-decoration: underline;
  }

  /* ---- Article footer ---- */
  .article-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .share-buttons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .share-label {
    font-size: 1rem;
    color: var(--muted);
    font-weight: 600;
    margin-right: 0.25rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--touch);
    padding: 0 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    text-decoration: none;
    background: transparent;
  }

  .share-btn:hover {
    border-color: var(--teal);
    color: var(--teal);
  }

  .action-box {
    border-left: 3px solid var(--teal);
    padding: 0.25rem 0 0.25rem 1.25rem;
    margin: 2rem 0;
  }

  .action-box h3 {
    font-size: 1.25rem;
    margin: 0 0 0.25rem;
  }

  .action-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  .action-list li { margin: 0; }

  .action-list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    color: var(--teal);
    font-size: 1rem;
    font-weight: 600;
  }

  .back-link-bottom {
    margin-top: 1rem;
  }

  /* ============================================================
     Article visualisation classes
     Hand-built charts in the markdown use these, never inline colours.
     Panels are white with a fine rule: the chart marks are validated
     against white and paper, and read as figures, not decoration.
     ============================================================ */

  /* Panels */
  .prose :global(.viz-panel),
  .prose :global(.viz-panel-reform),
  .prose :global(.viz-callout),
  .prose :global(.viz-progress),
  .prose :global(.viz-hero),
  .prose :global(.person-quote) {
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: 1rem;
    line-height: 1.55;
  }

  .prose :global(.viz-panel-reform),
  .prose :global(.viz-callout),
  .prose :global(.viz-hero) {
    border-top: 3px solid var(--teal);
  }

  .prose :global(.viz-panel-gradient) { border-top: 3px solid var(--teal); }
  .prose :global(.viz-panel-alert) { border-top: 3px solid var(--chart-2); }
  .prose :global(.viz-panel-success) { border-top: 3px solid var(--chart-good); }

  .prose :global(.viz-panel-bordered) {
    padding: 0;
    border: 1px solid var(--line);
    border-top: 3px solid var(--teal);
  }

  .prose :global(.viz-panel-bordered > .viz-panel-inner) { padding: 1.5rem; }

  .prose :global(.viz-callout),
  .prose :global(.viz-hero) {
    text-align: center;
  }

  /* Chart titles */
  .prose :global(.viz-label) {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.4;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .prose :global(.viz-label.teal) { color: var(--text-teal); }
  .prose :global(.viz-label.center) { text-align: center; }

  /* Stat grids */
  .prose :global(.viz-grid) { display: grid; gap: 12px; }
  .prose :global(.viz-grid-2) { grid-template-columns: repeat(2, 1fr); }
  .prose :global(.viz-grid-3) { grid-template-columns: repeat(3, 1fr); }
  .prose :global(.viz-grid-4) { grid-template-columns: repeat(4, 1fr); }

  /* Stat cards. The number is ink; the colour is a rule above it, which
     identifies the category without asking coloured text to carry it. */
  .prose :global(.viz-stat) {
    padding: 1.1rem 1rem 1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: 3px solid var(--line-strong);
    border-radius: var(--radius-sm);
    text-align: center;
  }

  .prose :global(.viz-stat.teal) { border-top-color: var(--chart-1); }
  .prose :global(.viz-stat.orange) { border-top-color: var(--chart-2); }
  .prose :global(.viz-stat.blue) { border-top-color: var(--chart-3); }
  .prose :global(.viz-stat.purple) { border-top-color: var(--chart-4); }
  .prose :global(.viz-stat.red) { border-top-color: var(--chart-bad); }
  .prose :global(.viz-stat.green) { border-top-color: var(--chart-good); }

  .prose :global(.viz-stat .value),
  .prose :global(.viz-callout .value),
  .prose :global(.viz-hero .value),
  .prose :global(.viz-comparison .side .value) {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums lining-nums;
    overflow-wrap: break-word;
  }

  .prose :global(.viz-stat .value) { font-size: 2.125rem; }
  .prose :global(.viz-stat .value.lg) { font-size: 2.5rem; }
  .prose :global(.viz-stat .value.xl) { font-size: 2.75rem; }

  .prose :global(.viz-stat .label) {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.35;
    margin-top: 0.5rem;
  }

  .prose :global(.viz-stat .sublabel) {
    display: block;
    font-size: 0.9375rem;
    color: var(--muted);
    margin-top: 0.3rem;
    line-height: 1.4;
  }

  /* Callout */
  .prose :global(.viz-callout .value) { font-size: 3rem; margin-bottom: 0.5rem; }

  .prose :global(.viz-callout .headline) {
    display: block;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
  }

  .prose :global(.viz-callout .subtext) {
    display: block;
    font-size: 1rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  /* Quote cards */
  .prose :global(.viz-quote) {
    padding: 0.9rem 1.1rem;
    background: var(--surface);
    border-left: 3px solid var(--teal);
    margin: 1rem 0;
  }

  .prose :global(.viz-quote.red) { border-left-color: var(--chart-bad); }
  .prose :global(.viz-quote.blue) { border-left-color: var(--chart-3); }
  .prose :global(.viz-quote.grey) { border-left-color: var(--line-strong); }

  .prose :global(.viz-quote .source) { font-size: 0.875rem; font-weight: 700; color: var(--muted); }
  .prose :global(.viz-quote .text) { display: block; font-size: 1.0625rem; color: var(--ink); margin-top: 0.4rem; line-height: 1.6; font-style: italic; }
  .prose :global(.viz-quote .context) { display: block; font-size: 0.875rem; color: var(--muted); margin-top: 0.4rem; }

  /* Source note beneath a figure */
  .prose :global(.viz-sources) {
    margin: 2rem 0 0;
    padding: 0.9rem 1.1rem;
    background: var(--panel);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  /* Info box: the scope or caveat that belongs next to the figures */
  .prose :global(.viz-info) {
    margin: 1.75rem 0;
    padding: 1rem 1.25rem;
    background: var(--panel);
    border-left: 3px solid var(--gold);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .prose :global(.viz-info p:last-child) { margin-bottom: 0; }

  /* Highlight bar */
  .prose :global(.viz-highlight) {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--line-strong);
    background: var(--panel);
  }

  .prose :global(.viz-highlight.teal) { border-left-color: var(--chart-1); }
  .prose :global(.viz-highlight.green) { border-left-color: var(--chart-good); }
  .prose :global(.viz-highlight.orange) { border-left-color: var(--chart-2); }
  .prose :global(.viz-highlight.red) { border-left-color: var(--chart-bad); }

  /* Progress bar */
  .prose :global(.viz-progress .bar-track) {
    height: 14px;
    background: var(--chart-track);
    border-radius: 2px;
    overflow: hidden;
    margin: 12px 0;
  }

  .prose :global(.viz-progress .bar-fill) {
    height: 100%;
    border-radius: 0 2px 2px 0;
    background: var(--chart-1);
  }

  /* Horizontal bar: track plus fill. Fill width is the data, set inline. */
  .prose :global(.viz-reform-bar) {
    height: 14px;
    border-radius: 2px;
    background: var(--chart-track);
    overflow: hidden;
    margin: 6px 0;
  }

  .prose :global(.viz-reform-bar .fill) {
    height: 100%;
    border-radius: 0 2px 2px 0;
    background: var(--chart-1);
  }

  .prose :global(.viz-reform-bar .fill.teal) { background: var(--chart-1); }
  .prose :global(.viz-reform-bar .fill.amber),
  .prose :global(.viz-reform-bar .fill.orange) { background: var(--chart-2); }
  .prose :global(.viz-reform-bar .fill.blue) { background: var(--chart-3); }
  .prose :global(.viz-reform-bar .fill.purple) { background: var(--chart-4); }
  .prose :global(.viz-reform-bar .fill.red) { background: var(--chart-bad); }
  .prose :global(.viz-reform-bar .fill.neutral) { background: var(--chart-neutral); }

  /* Label row above a bar: name left, value right */
  .prose :global(.viz-row) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 4px;
    font-size: 1rem;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }

  /* Stacked bar segments (one bar split into parts) */
  .prose :global(.viz-stack) {
    display: flex;
    gap: 2px;
    height: 56px;
    margin-top: 14px;
  }

  .prose :global(.viz-seg) { display: flex; align-items: center; padding: 0 12px; min-width: 0; }
  .prose :global(.viz-seg.teal) { background: var(--chart-1); }
  .prose :global(.viz-seg.orange) { background: var(--chart-2); }
  .prose :global(.text-on-fill) { color: #ffffff; font-weight: 700; }

  /* Column chart: columns carry no printed values, so each is at least 3:1
     against the white panel. The emphasised column is full teal. */
  .prose :global(.viz-col) {
    flex: 1;
    background: #599a90;
    border-radius: 2px 2px 0 0;
  }

  .prose :global(.viz-col.peak) { background: var(--chart-1); }

  .prose :global(.viz-axis) {
    flex: 1;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .prose :global(.viz-axis.peak) { color: var(--text-teal); font-weight: 700; }

  /* Reference line between groups of bars */
  .prose :global(.viz-rule-dashed) {
    border-top: 1px dashed var(--line-strong);
    padding-top: 9px;
  }

  /* Text colours for charts, each at least 6:1 on paper and white */
  .prose :global(.text-teal) { color: var(--text-teal); }
  .prose :global(.text-green) { color: var(--text-green); }
  .prose :global(.text-red) { color: var(--text-red); }
  .prose :global(.text-orange) { color: var(--text-orange); }
  .prose :global(.text-purple) { color: var(--text-purple); }
  .prose :global(.text-blue) { color: var(--text-blue); }
  .prose :global(.text-labour) { color: #b0002d; }
  .prose :global(.text-muted) { color: var(--muted); }
  .prose :global(.text-dim) { color: var(--muted); }
  .prose :global(.text-white) { color: var(--ink); }
  .prose :global(.text-bold) { font-weight: 700; }

  /* Party colour classes. The official colours are for marks; as text they
     are darkened where the official shade falls below 4.5:1 on paper. */
  .prose :global(.text-party-reform) { color: var(--text-teal); }
  .prose :global(.text-party-conservative) { color: #00609c; }
  .prose :global(.text-party-labour) { color: #b0002d; }
  .prose :global(.text-party-libdem) { color: #8a5a00; }
  .prose :global(.text-party-green) { color: #3f6b12; }
  .prose :global(.text-party-independent) { color: var(--muted); }

  .prose :global(.viz-stat.party-conservative) { border-top-color: var(--party-conservative); }
  .prose :global(.viz-stat.party-labour) { border-top-color: var(--party-labour); }
  .prose :global(.viz-stat.party-libdem) { border-top-color: var(--party-libdem); }
  .prose :global(.viz-stat.party-green) { border-top-color: var(--party-green); }
  .prose :global(.viz-stat.party-independent) { border-top-color: var(--party-independent); }
  .prose :global(.viz-stat.party-reform) { border-top-color: var(--party-reform); }

  .prose :global(.viz-panel-party-conservative) { border-top: 3px solid var(--party-conservative); }
  .prose :global(.viz-panel-party-labour) { border-top: 3px solid var(--party-labour); }
  .prose :global(.viz-panel-party-libdem) { border-top: 3px solid var(--party-libdem); }
  .prose :global(.viz-panel-party-green) { border-top: 3px solid var(--party-green); }
  .prose :global(.viz-panel-party-independent) { border-top: 3px solid var(--party-independent); }
  .prose :global(.viz-panel-party-reform) { border-top: 3px solid var(--party-reform); }

  /* Headline figure */
  .prose :global(.viz-hero) { padding: 2.5rem 1.5rem; }
  .prose :global(.viz-hero .value) { font-size: 4rem; }
  .prose :global(.viz-hero .headline) {
    display: block;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--ink);
    margin-top: 0.75rem;
  }
  .prose :global(.viz-hero .subtext) {
    display: block;
    font-size: 1rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  /* Small label */
  .prose :global(.viz-badge) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: var(--radius-sm);
  }

  .prose :global(.viz-badge.teal) { color: var(--text-teal); border-color: var(--accent-border); }
  .prose :global(.viz-badge.green) { color: var(--text-green); border-color: rgba(46, 107, 48, 0.35); }
  .prose :global(.viz-badge.orange) { color: var(--text-orange); border-color: rgba(153, 73, 11, 0.35); }

  .prose :global(.viz-marquee) {
    margin: 2rem 0;
    padding: 0.75rem 1.25rem;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    font-size: 1rem;
    text-align: center;
  }

  /* Then and now */
  .prose :global(.viz-comparison) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 2rem 0;
  }

  .prose :global(.viz-comparison .side) {
    padding: 1.25rem 1rem;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--line-strong);
    border-radius: var(--radius-sm);
  }

  .prose :global(.viz-comparison .side.after) { border-top-color: var(--chart-1); }
  .prose :global(.viz-comparison .side .value) { font-size: 2.5rem; }

  .prose :global(.viz-comparison .side .label) {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  /* Person quote */
  .prose :global(.person-quote) { text-align: center; border-top: 3px solid var(--gold); }
  .prose :global(.person-quote .photo) {
    width: 96px; height: 96px; border-radius: 50%; object-fit: cover; margin: 0 auto 1rem; display: block;
  }
  .prose :global(.person-quote .quote-mark) { display: none; }
  .prose :global(.person-quote .quote-text) {
    font-family: var(--font-display); font-size: 1.25rem; color: var(--ink); line-height: 1.5;
    max-width: 540px; margin: 0 auto 0.75rem;
  }
  .prose :global(.person-quote .attribution) { font-size: 1rem; font-weight: 700; color: var(--ink); }
  .prose :global(.person-quote .role) { font-size: 0.9375rem; color: var(--muted); margin-top: 2px; }

  /* Photo banner */
  .prose :global(.photo-banner) {
    margin: 2rem 0;
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    min-height: 260px;
    display: flex;
    align-items: flex-end;
  }

  .prose :global(.photo-banner img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; margin: 0;
  }

  .prose :global(.photo-banner .overlay) {
    position: relative; z-index: 1; width: 100%; padding: 2.5rem 1.5rem 1.25rem;
    background: linear-gradient(to top, rgba(27, 48, 53, 0.92) 0%, rgba(27, 48, 53, 0.6) 60%, transparent 100%);
  }

  .prose :global(.photo-banner .overlay h3) { font-size: 1.5rem; color: #faf9f5; margin: 0 0 6px; }
  .prose :global(.photo-banner .overlay p) { font-size: 1rem; color: #e8ece9; margin: 0; }

  /* ---- Responsive ---- */
  @media (max-width: 960px) {
    .prose :global(.viz-grid-4) { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .prose :global(.viz-grid-3),
    .prose :global(.viz-grid-4) { grid-template-columns: repeat(2, 1fr); }

    .prose :global(.viz-stat .value) { font-size: 1.875rem; }
    .prose :global(.viz-stat .value.lg) { font-size: 2.125rem; }
    .prose :global(.viz-stat .value.xl) { font-size: 2.25rem; }
    .prose :global(.viz-hero .value) { font-size: 3rem; }
    .prose :global(.viz-comparison .side .value) { font-size: 2rem; }

    /* Force inline 4 and 3 column grids to 2 columns on tablet */
    .prose :global(div[style*="repeat(4"]),
    .prose :global(div[style*="repeat(3"]) { grid-template-columns: repeat(2, 1fr) !important; }

    .prose :global(span[style*="font-size: 4.5rem"]) { font-size: 3rem !important; }

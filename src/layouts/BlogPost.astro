---
import Layout from './Layout.astro';
import { DEFAULT_OG_IMAGE } from '../data/seo';
import { isoDate } from '../lib/dates';
import EmailSignup from '../components/EmailSignup.astro';
import AuthorBox from '../components/AuthorBox.astro';
import DataBox from '../components/DataBox.astro';
import Sources from '../components/Sources.astro';
import ListenToArticle from '../components/ListenToArticle.astro';
import { isoDuration } from '../lib/audio';
import { person } from '../data/person';
import { Image } from 'astro:assets';
import { articleImage, imageQuality, shareImageUrl } from '../lib/images';
import type { NextRead } from '../lib/next-reads';

interface Props {
  frontmatter: {
    title: string;
    date: Date;
    description: string;
    seoTitle?: string;
    seoDescription?: string;
    tags: string[];
    featured?: boolean;
    updated?: Date;
    image?: string;
    imageAlt?: string;
    imageUncropped?: boolean;
    ogImage?: string;
    imageCredit?: string;
    category?: string;
    subcategory?: string;
    sources?: { text: string; url: string }[];
    data?: {
      links: { label: string; url: string }[];
      csv?: string;
      method?: string;
      doi?: string;
      title?: string;
      year?: number;
    };
  };
  /* Level-two headings, for the contents list on long pieces. */
  headings?: { depth: number; slug: string; text: string }[];
  area?: { id: string; title: string };
  topic?: { id: string; title: string };
  nextReads?: NextRead[];
  /* Set only when the narration still matches the text (see pages/news/[...slug].astro). */
  audio?: { src: string; duration: number; voice: string; generated: Date };
}

const { frontmatter, headings = [], area, topic, nextReads = [], audio } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(frontmatter.date);

/* Shown only when the article was revised on a later day than it was published. */
const formattedUpdated =
  frontmatter.updated && frontmatter.updated.toISOString().slice(0, 10) !== frontmatter.date.toISOString().slice(0, 10)
    ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(frontmatter.updated)
    : null;

// Estimate reading time from slot content
const wordsPerMinute = 220;
const rawContent = await Astro.slots.render('default');
const textContent = rawContent.replace(/<[^>]*>/g, '');
const wordCount = textContent.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / wordsPerMinute));

/* A contents list only earns its place on a long piece with several sections.
   Short reports and award notes stay free of navigation. */
const showToc = headings.length >= 4 && wordCount >= 900;

/* Google truncates the title around 60 characters, and the brand suffix is the
   least useful part of it: the site name is already carried by the WebSite node
   and shown separately in search results. So append it only when it fits, rather
   than pushing a headline out to 104 characters and losing the end of the claim. */
const heroMeta = articleImage(frontmatter.image);
const heroAlt = frontmatter.imageAlt || `Lead image for the article: ${frontmatter.title}`;
const shareImage =
  frontmatter.ogImage || (await shareImageUrl(frontmatter.image)) || DEFAULT_OG_IMAGE;

const BRAND_SUFFIX = ' | Tom Pickup';
const baseTitle = frontmatter.seoTitle ?? frontmatter.title;
const pageTitle =
  baseTitle.length + BRAND_SUFFIX.length <= 60
    ? baseTitle + BRAND_SUFFIX
    : baseTitle;
---

<Layout
  title={pageTitle}
  description={frontmatter.seoDescription ?? frontmatter.description}
  article={true}
  ogImage={shareImage}
  ogImageAlt={frontmatter.ogImage ? undefined : frontmatter.imageAlt}
  publishedTime={isoDate(frontmatter.date)}
  modifiedTime={isoDate(frontmatter.updated || frontmatter.date)}
  tags={frontmatter.tags}
>
  <!-- NewsArticle structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': new URL(`/news/${Astro.params.slug || ''}/`, Astro.site).href,
    },
    headline: frontmatter.title,
    description: frontmatter.description,
    datePublished: isoDate(frontmatter.date),
    dateModified: isoDate(frontmatter.updated || frontmatter.date),
    image: [new URL(shareImage, Astro.site).href],
    /* The full Person node is on / and /about/ (src/data/person.ts); the @id
       joins them. Name and url stay inline because Google reads author per page. */
    author: {
      '@type': 'Person',
      '@id': person['@id'],
      name: person.name,
      url: person.url,
      jobTitle: person.jobTitle,
    },
    publisher: {
      '@type': 'Person',
      '@id': person['@id'],
      name: person.name,
      url: person.url,
    },
    isAccessibleForFree: true,
    ...(audio ? { audio: {
      '@type': 'AudioObject',
      name: `Audio version: ${frontmatter.title}`,
      contentUrl: new URL(audio.src, Astro.site).href,
      encodingFormat: 'audio/mpeg',
      duration: isoDuration(audio.duration),
      uploadDate: isoDate(audio.generated),
      inLanguage: 'en-GB',
    } } : {}),
    wordCount: wordCount,
    keywords: frontmatter.tags.join(', '),
    inLanguage: 'en-GB',
    ...(frontmatter.category ? { articleSection: frontmatter.subcategory
      ? `${frontmatter.category} / ${frontmatter.subcategory}`
      : frontmatter.category } : {}),
    /* Local relevance is one of the factors Google names for News ranking.
       Nearly everything here is about the same place, so say so. */
    contentLocation: {
      '@type': 'Place',
      name: 'Lancashire, England',
      address: {
        '@type': 'PostalAddress',
        addressRegion: 'Lancashire',
        addressCountry: 'GB',
      },
    },
  })} />

  {/* A deposited dataset gets its own Dataset node, which Google Dataset Search
      indexes. Only once it has a DOI: before that there is no stable record to point at. */}
  {frontmatter.data?.doi && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      '@id': `https://doi.org/${frontmatter.data.doi}`,
      name: frontmatter.data.title ?? frontmatter.title,
      description: frontmatter.data.method ?? frontmatter.description,
      url: `https://doi.org/${frontmatter.data.doi}`,
      identifier: `https://doi.org/${frontmatter.data.doi}`,
      creator: { '@id': person['@id'] },
      license: 'https://creativecommons.org/licenses/by/4.0/',
      isAccessibleForFree: true,
      inLanguage: 'en-GB',
      isBasedOn: frontmatter.data.links.map((link) => link.url),
      subjectOf: { '@id': new URL(`/news/${Astro.params.slug || ''}/`, Astro.site).href },
      ...(frontmatter.data.year ? { datePublished: String(frontmatter.data.year) } : {}),
    })} />
  )}

  <!-- BreadcrumbList structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tompickup.co.uk/' },
      { '@type': 'ListItem', position: 2, name: 'News', item: 'https://tompickup.co.uk/news/' },
      { '@type': 'ListItem', position: 3, name: frontmatter.title },
    ],
  })} />

  <div class:list={['blog-post', { 'has-toc': showToc }]}>
    <div class="article-top">
      <header class="article-header">
        <nav class="article-crumbs" aria-label="Breadcrumb">
          <a href="/news/">News</a>
          {area && <><span aria-hidden="true">/</span><a href={`/news/#${area.id}`}>{area.title}</a></>}
          {topic && <><span aria-hidden="true">/</span>{topic.id === 'public-debates'
            ? <a href="/news/public-debates/">{topic.title}</a>
            : <a href={`/news/#${area?.id}-${topic.id}`}>{topic.title}</a>}</>}
        </nav>

        <h1 class="article-title">{frontmatter.title}</h1>
        <p class="article-standfirst">{frontmatter.description}</p>

        <p class="article-meta">
          <span>Published <time datetime={isoDate(frontmatter.date)}>{formattedDate}</time></span>
          {formattedUpdated && <span>Updated <time datetime={isoDate(frontmatter.updated!)}>{formattedUpdated}</time></span>}
          <span>{readingTime} min read</span>
        </p>
      </header>

      {audio && <ListenToArticle audio={audio} />}

      {frontmatter.image && (
        <figure class:list={['article-hero-image', { 'hero-uncropped': frontmatter.imageUncropped }]}>
          {heroMeta ? (
            <Image
              src={heroMeta}
              alt={heroAlt}
              widths={[640, 960, 1280, 1600]}
              sizes="(max-width: 800px) calc(100vw - 40px), 760px"
              format="webp"
              quality={imageQuality(frontmatter.image)}
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <img src={frontmatter.image} alt={heroAlt} loading="eager" decoding="async" />
          )}
          {frontmatter.imageCredit && <figcaption class="hero-credit">{frontmatter.imageCredit}</figcaption>}
        </figure>
      )}
    </div>

    <div class="article-layout">
      {showToc && (
        <nav class="article-toc" aria-labelledby="toc-heading">
          <p id="toc-heading" class="toc-heading">Contents</p>
          <ol>
            {headings.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )}

      <div class="article-main">
        <article class="prose">
          <slot />
        </article>

        <footer class="article-ending">
          {(frontmatter.data || frontmatter.sources) && (
            <div class="ending-sources">
              {frontmatter.data && <DataBox {...frontmatter.data} />}
              {frontmatter.sources && <Sources items={frontmatter.sources} />}
            </div>
          )}

          <AuthorBox />

          {nextReads.length > 0 && (
            <nav class="next-reads" aria-labelledby="next-reads-heading">
              <h2 id="next-reads-heading">Read next</h2>
              <ul>
                {nextReads.map((r) => (
                  <li>
                    <a href={r.href} {...(r.external ? { rel: 'noopener' } : {})}>
                      <span class="next-kicker">{r.kicker}</span>
                      <span class="next-title">{r.title}{r.external && <span aria-hidden="true"> ↗</span>}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          <EmailSignup variant="inline" />
        </footer>
      </div>
    </div>
  </div>
</Layout>

<style>
  .blog-post {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem var(--gutter) 4rem;
  }

  /* ---- Header: plain headline, standfirst, dates ---- */
  .article-header {
    max-width: 720px;
    margin: 0 0 2rem;
  }

  .article-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .article-crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    color: var(--teal);
    text-decoration: none;
  }

  .article-crumbs a:hover { text-decoration: underline; }

  .article-title {
    font-size: clamp(2rem, 4.6vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0.5rem 0 1rem;
    max-width: 22ch;
  }

  .article-standfirst {
    font-size: 1.3125rem;
    line-height: 1.5;
    color: var(--muted);
    max-width: 60ch;
    margin: 0 0 1.25rem;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }

  .article-meta time { color: var(--ink); }

  .article-hero-image {
    position: relative;
    margin: 0 0 2.5rem;
  }

  .article-hero-image :global(img) {
    width: 100%;
    height: auto;
    display: block;
    max-height: 440px;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .hero-uncropped :global(img) { max-height: none; }

  .hero-credit {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ---- Contents: beside the body on desktop, above it on phones ---- */
  .article-toc {
    margin: 0 0 2rem;
    padding: 0.75rem 0 1rem;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }

  .toc-heading {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.25rem;
  }

  .article-toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: toc;
  }

  .article-toc li { counter-increment: toc; }

  .article-toc a {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    align-items: baseline;
    min-height: var(--touch);
    padding: 0.5rem 0;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.4;
    text-decoration: none;
  }

  .article-toc a::before {
    content: counter(toc);
    color: var(--gold);
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .article-toc a:hover { color: var(--teal); text-decoration: underline; }

  .article-toc li + li a { border-top: 1px solid var(--line); }

  @media (min-width: 1100px) {
    .blog-post.has-toc { max-width: 1080px; }
    .has-toc .article-top { margin-left: 280px; }
    .has-toc .article-layout {
      display: grid;
      grid-template-columns: 224px minmax(0, 1fr);
      column-gap: 56px;
      align-items: start;
    }
    .has-toc .article-toc {
      position: sticky;
      top: 96px;
      max-height: calc(100vh - 120px);
      overflow-y: auto;
      margin: 0;
    }
    .has-toc .article-toc a { font-size: 0.9375rem; }
  }

  /* ---- Prose ---- */
  .prose {
    max-width: 720px;
    margin: 0;
    color: var(--ink);
    font-size: 1.1875rem;
    line-height: 1.7;
  }

  .prose :global(p) {
    margin-bottom: 1.35rem;
  }

  .prose :global(h2) {
    font-size: 1.75rem;
    line-height: 1.2;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    color: var(--ink);
    scroll-margin-top: 88px;
  }

  .prose :global(h3) {
    font-size: 1.375rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--ink);
    scroll-margin-top: 88px;
  }

  .prose :global(h4) {
    font-family: var(--font-sans);
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: 0;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--ink);
  }

  .prose :global(a) {
    color: var(--teal);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .prose :global(a:hover) {
    color: var(--ink);
    text-decoration-thickness: 2px;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }

  .prose :global(em) {
    font-style: italic;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--gold);
    padding: 0.25rem 0 0.25rem 1.25rem;
    margin: 1.75rem 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.55;
  }

  .prose :global(blockquote p) {
    margin-bottom: 0.5rem;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(ul li) { list-style-type: disc; }
  .prose :global(ol li) { list-style-type: decimal; }
  .prose :global(li::marker) { color: var(--muted); }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--panel);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    color: var(--ink);
  }

  .prose :global(pre) {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    overflow-x: auto;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    margin: 2rem 0;
  }

  .prose :global(figcaption) {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .prose :global(.article-photo-gallery) {
    columns: 2;
    column-gap: 1rem;
    margin: 1.5rem 0 2.5rem;
  }

  .prose :global(.article-photo-gallery figure) {
    break-inside: avoid;
    margin: 0 0 1rem;
    padding: 0;
  }

  .prose :global(.article-photo-gallery a) {
    display: block;
    border: 0;
  }

  .prose :global(.article-photo-gallery img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }

  .prose :global(.article-photo-gallery figcaption) {
    margin-top: 0.4rem;
    font-size: 0.875rem;
  }

  @media (max-width: 600px) {
    .prose :global(.article-photo-gallery) { columns: 1; }
  }

  /* Video embeds */
  .prose :global(.article-video) {
    margin: 2rem auto;
    max-width: 360px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .prose :global(.article-video video) {
    width: 100%;
    display: block;
  }

  .prose :global(.article-video-label) {
    text-align: center;
    font-size: 0.9375rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  /* Share-card images shown in the article body */
  .prose :global(.article-data-viz) {
    margin: 1.75rem auto;
    max-width: 560px;
  }

  .prose :global(.article-data-viz a) {
    display: block;
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .prose :global(.article-data-viz a:hover) {
    border-color: var(--teal);
  }

  .prose :global(.article-data-viz img) {
    width: 100%;
    height: auto;
    display: block;
    margin: 0;
    border-radius: 0;
  }

  .prose :global(.article-data-viz .download-hint) {
    display: block;
    text-align: center;
    font-size: 0.9375rem;
    color: var(--teal);
    padding: 10px;
    border-top: 1px solid var(--line);
    background: var(--surface);
    font-weight: 600;
  }

  .prose :global(.shareable-assets) {
    margin: 1rem auto;
    max-width: 360px;
  }

  .prose :global(.shareable-assets summary) {
    cursor: pointer;
    min-height: var(--touch);
    font-size: 1rem;
    color: var(--teal);
    font-weight: 600;
    text-align: center;
    padding: 0.6rem;
  }

  .prose :global(.share-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .prose :global(.share-grid a) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch);
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    color: var(--teal);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .prose :global(.share-grid a:hover) {
    border-color: var(--teal);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 2.5rem 0;
  }

  /* ---- Tables: flat, ruled, numbers aligned ---- */
  .prose :global(table) {
    width: 100%;
    table-layout: auto;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 1rem;
    line-height: 1.45;
    font-variant-numeric: tabular-nums;
  }

  .prose :global(th) {
    padding: 0.6rem 0.75rem;
    font-weight: 600;
    color: var(--ink);
    font-size: 0.9375rem;
    text-align: left;
    vertical-align: bottom;
    border-bottom: 2px solid var(--ink);
  }

  .prose :global(td) {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    vertical-align: top;
  }

  .prose :global(th:first-child),
  .prose :global(td:first-child) { padding-left: 0; text-align: left; width: auto; }
  .prose :global(th:last-child),
  .prose :global(td:last-child) { padding-right: 0; text-align: right; }

  .prose :global(td strong) { color: var(--ink); }

  .prose :global(.reform-row td) {
    color: var(--teal) !important;
    font-weight: 600;
    background: rgba(23, 100, 94, 0.06);
  }

  .prose :global(.reform-row td strong) { color: var(--teal) !important; }

  /* ---- Citations ---- */
  .prose :global(sup.cite) {
    font-size: 0.7em;
    line-height: 0;
    margin-left: 0.1em;
  }

  .prose :global(sup.cite a) {
    color: var(--teal);
    text-decoration: none;
    font-weight: 600;
    padding: 0 0.1em;
  }

  .prose :global(sup.cite a:hover) {
    color: var(--ink);
    text-decoration: underline;
  }

  /* ---- One ending: sources and data, author, next reads, one signup ---- */
  .article-ending {
    max-width: 720px;
    margin-top: 3rem;
  }

  .ending-sources { margin-bottom: 2rem; }

  .next-reads { margin: 2rem 0 2.5rem; }

  .next-reads h2 {
    font-size: 1.375rem;
    margin: 0 0 0.5rem;
  }

  .next-reads ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  .next-reads li { border-bottom: 1px solid var(--line); }

  .next-reads a {
    display: block;
    padding: 0.875rem 0;
    min-height: var(--touch);
    color: var(--ink);
    text-decoration: none;
  }

  .next-kicker {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal);
  }

  .next-title {
    display: block;
    margin-top: 0.125rem;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .next-reads a:hover .next-title { color: var(--teal); text-decoration: underline; }

  /* ============================================================
     Article visualisation classes
     Hand-built charts in the markdown use these, never inline colours.
     Panels are white with a fine rule: the chart marks are validated
     against white and paper, and read as figures, not decoration.
     ============================================================ */

  /* Panels */
  .prose :global(.viz-panel),
  .prose :global(.viz-panel-reform),
  .prose :global(.viz-callout),
  .prose :global(.viz-progress),
  .prose :global(.viz-hero),
  .prose :global(.person-quote) {
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: 1rem;
    line-height: 1.55;
  }

  .prose :global(.viz-panel-reform),
  .prose :global(.viz-callout),
  .prose :global(.viz-hero) {
    border-top: 3px solid var(--teal);
  }

  .prose :global(.viz-panel-gradient) { border-top: 3px solid var(--teal); }
  .prose :global(.viz-panel-alert) { border-top: 3px solid var(--chart-2); }
  .prose :global(.viz-panel-success) { border-top: 3px solid var(--chart-good); }

  .prose :global(.viz-panel-bordered) {
    padding: 0;
    border: 1px solid var(--line);
    border-top: 3px solid var(--teal);
  }

  .prose :global(.viz-panel-bordered > .viz-panel-inner) { padding: 1.5rem; }

  .prose :global(.viz-callout),
  .prose :global(.viz-hero) {
    text-align: center;
  }

  /* Chart titles */
  .prose :global(.viz-label) {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.4;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .prose :global(.viz-label.teal) { color: var(--text-teal); }
  .prose :global(.viz-label.center) { text-align: center; }

  /* Stat grids */
  .prose :global(.viz-grid) { display: grid; gap: 12px; }
  .prose :global(.viz-grid-2) { grid-template-columns: repeat(2, 1fr); }
  .prose :global(.viz-grid-3) { grid-template-columns: repeat(3, 1fr); }
  .prose :global(.viz-grid-4) { grid-template-columns: repeat(4, 1fr); }

  /* Stat cards. The number is ink; the colour is a rule above it, which
     identifies the category without asking coloured text to carry it. */
  .prose :global(.viz-stat) {
    padding: 1.1rem 1rem 1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: 3px solid var(--line-strong);
    border-radius: var(--radius-sm);
    text-align: center;
  }

  .prose :global(.viz-stat.teal) { border-top-color: var(--chart-1); }
  .prose :global(.viz-stat.orange) { border-top-color: var(--chart-2); }
  .prose :global(.viz-stat.blue) { border-top-color: var(--chart-3); }
  .prose :global(.viz-stat.purple) { border-top-color: var(--chart-4); }
  .prose :global(.viz-stat.red) { border-top-color: var(--chart-bad); }
  .prose :global(.viz-stat.green) { border-top-color: var(--chart-good); }

  .prose :global(.viz-stat .value),
  .prose :global(.viz-callout .value),
  .prose :global(.viz-hero .value),
  .prose :global(.viz-comparison .side .value) {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums lining-nums;
    overflow-wrap: break-word;
  }

  .prose :global(.viz-stat .value) { font-size: 2.125rem; }
  .prose :global(.viz-stat .value.lg) { font-size: 2.5rem; }
  .prose :global(.viz-stat .value.xl) { font-size: 2.75rem; }

  .prose :global(.viz-stat .label) {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.35;
    margin-top: 0.5rem;
  }

  .prose :global(.viz-stat .sublabel) {
    display: block;
    font-size: 0.9375rem;
    color: var(--muted);
    margin-top: 0.3rem;
    line-height: 1.4;
  }

  /* Callout */
  .prose :global(.viz-callout .value) { font-size: 3rem; margin-bottom: 0.5rem; }

  .prose :global(.viz-callout .headline) {
    display: block;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
  }

  .prose :global(.viz-callout .subtext) {
    display: block;
    font-size: 1rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  /* Quote cards */
  .prose :global(.viz-quote) {
    padding: 0.9rem 1.1rem;
    background: var(--surface);
    border-left: 3px solid var(--teal);
    margin: 1rem 0;
  }

  .prose :global(.viz-quote.red) { border-left-color: var(--chart-bad); }
  .prose :global(.viz-quote.blue) { border-left-color: var(--chart-3); }
  .prose :global(.viz-quote.grey) { border-left-color: var(--line-strong); }

  .prose :global(.viz-quote .source) { font-size: 0.875rem; font-weight: 700; color: var(--muted); }
  .prose :global(.viz-quote .text) { display: block; font-size: 1.0625rem; color: var(--ink); margin-top: 0.4rem; line-height: 1.6; font-style: italic; }
  .prose :global(.viz-quote .context) { display: block; font-size: 0.875rem; color: var(--muted); margin-top: 0.4rem; }

  /* Source note beneath a figure */
  .prose :global(.viz-sources) {
    margin: 2rem 0 0;
    padding: 0.9rem 1.1rem;
    background: var(--panel);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  /* Info box: the scope or caveat that belongs next to the figures */
  .prose :global(.viz-info) {
    margin: 1.75rem 0;
    padding: 1rem 1.25rem;
    background: var(--panel);
    border-left: 3px solid var(--gold);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .prose :global(.viz-info p:last-child) { margin-bottom: 0; }

  /* Highlight bar */
  .prose :global(.viz-highlight) {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--line-strong);
    background: var(--panel);
  }

  .prose :global(.viz-highlight.teal) { border-left-color: var(--chart-1); }
  .prose :global(.viz-highlight.green) { border-left-color: var(--chart-good); }
  .prose :global(.viz-highlight.orange) { border-left-color: var(--chart-2); }
  .prose :global(.viz-highlight.red) { border-left-color: var(--chart-bad); }

  /* Progress bar */
  .prose :global(.viz-progress .bar-track) {
    height: 14px;
    background: var(--chart-track);
    border-radius: 2px;
    overflow: hidden;
    margin: 12px 0;
  }

  .prose :global(.viz-progress .bar-fill) {
    height: 100%;
    border-radius: 0 2px 2px 0;
    background: var(--chart-1);
  }

  /* Horizontal bar: track plus fill. Fill width is the data, set inline. */
  .prose :global(.viz-reform-bar) {
    height: 14px;
    border-radius: 2px;
    background: var(--chart-track);
    overflow: hidden;
    margin: 6px 0;
  }

  .prose :global(.viz-reform-bar .fill) {
    height: 100%;
    border-radius: 0 2px 2px 0;
    background: var(--chart-1);
  }

  .prose :global(.viz-reform-bar .fill.teal) { background: var(--chart-1); }
  .prose :global(.viz-reform-bar .fill.amber),
  .prose :global(.viz-reform-bar .fill.orange) { background: var(--chart-2); }
  .prose :global(.viz-reform-bar .fill.blue) { background: var(--chart-3); }
  .prose :global(.viz-reform-bar .fill.purple) { background: var(--chart-4); }
  .prose :global(.viz-reform-bar .fill.red) { background: var(--chart-bad); }
  .prose :global(.viz-reform-bar .fill.neutral) { background: var(--chart-neutral); }

  /* Label row above a bar: name left, value right */
  .prose :global(.viz-row) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 4px;
    font-size: 1rem;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }

  /* Stacked bar segments (one bar split into parts) */
  .prose :global(.viz-stack) {
    display: flex;
    gap: 2px;
    height: 56px;
    margin-top: 14px;
  }

  .prose :global(.viz-seg) { display: flex; align-items: center; padding: 0 12px; min-width: 0; }
  .prose :global(.viz-seg.teal) { background: var(--chart-1); }
  .prose :global(.viz-seg.orange) { background: var(--chart-2); }
  .prose :global(.viz-seg.blue) { background: var(--chart-3); }
  .prose :global(.viz-seg.purple) { background: var(--chart-4); }
  .prose :global(.viz-seg.neutral) { background: var(--chart-neutral); }

  /* Thin stacked bar with a legend that carries the values (Stocks Massey
     allocations). Segments hold no text; each legend row names its category and
     amount, so identity never rests on colour alone. */
  .prose :global(.viz-stack.thin) { height: 28px; margin-top: 4px; }
  .prose :global(.viz-stack.thin .viz-seg) { padding: 0; min-width: 2px; }
  .prose :global(.viz-stack.thin .viz-seg:first-child) { border-radius: 4px 0 0 4px; }
  .prose :global(.viz-stack.thin .viz-seg:last-child) { border-radius: 0 4px 4px 0; }
  .prose :global(.viz-legend) { list-style: none; margin: 14px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 6px 24px; font-size: 0.9375rem; }
  .prose :global(.viz-legend li) { list-style: none; display: flex; align-items: center; gap: 8px; margin: 0; padding: 4px 0; border-bottom: 1px solid var(--line); }
  .prose :global(.viz-legend .swatch) { flex: none; width: 12px; height: 12px; border-radius: 2px; }
  .prose :global(.viz-legend .amount) { margin-left: auto; font-weight: 600; font-variant-numeric: tabular-nums; }
  .prose :global(.swatch.teal) { background: var(--chart-1); }
  .prose :global(.swatch.orange) { background: var(--chart-2); }
  .prose :global(.swatch.blue) { background: var(--chart-3); }
  .prose :global(.swatch.purple) { background: var(--chart-4); }
  .prose :global(.swatch.neutral) { background: var(--chart-neutral); }
  .prose :global(.text-on-fill) { color: #ffffff; font-weight: 700; }

  /* Column chart: columns carry no printed values, so each is at least 3:1
     against the white panel. The emphasised column is full teal. */
  .prose :global(.viz-col) {
    flex: 1;
    background: #599a90;
    border-radius: 2px 2px 0 0;
  }

  .prose :global(.viz-col.peak) { background: var(--chart-1); }

  .prose :global(.viz-axis) {
    flex: 1;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .prose :global(.viz-axis.peak) { color: var(--text-teal); font-weight: 700; }

  /* Reference line between groups of bars */
  .prose :global(.viz-rule-dashed) {
    border-top: 1px dashed var(--line-strong);
    padding-top: 9px;
  }

  /* Text colours for charts, each at least 6:1 on paper and white */
  .prose :global(.text-teal) { color: var(--text-teal); }
  .prose :global(.text-green) { color: var(--text-green); }
  .prose :global(.text-red) { color: var(--text-red); }
  .prose :global(.text-orange) { color: var(--text-orange); }
  .prose :global(.text-purple) { color: var(--text-purple); }
  .prose :global(.text-blue) { color: var(--text-blue); }
  .prose :global(.text-labour) { color: #b0002d; }
  .prose :global(.text-muted) { color: var(--muted); }
  .prose :global(.text-dim) { color: var(--muted); }
  .prose :global(.text-white) { color: var(--ink); }
  .prose :global(.text-bold) { font-weight: 700; }

  /* Party colour classes. The official colours are for marks; as text they
     are darkened where the official shade falls below 4.5:1 on paper. */
  .prose :global(.text-party-reform) { color: var(--text-teal); }
  .prose :global(.text-party-conservative) { color: #00609c; }
  .prose :global(.text-party-labour) { color: #b0002d; }
  .prose :global(.text-party-libdem) { color: #8a5a00; }
  .prose :global(.text-party-green) { color: #3f6b12; }
  .prose :global(.text-party-independent) { color: var(--muted); }

  .prose :global(.viz-stat.party-conservative) { border-top-color: var(--party-conservative); }
  .prose :global(.viz-stat.party-labour) { border-top-color: var(--party-labour); }
  .prose :global(.viz-stat.party-libdem) { border-top-color: var(--party-libdem); }
  .prose :global(.viz-stat.party-green) { border-top-color: var(--party-green); }
  .prose :global(.viz-stat.party-independent) { border-top-color: var(--party-independent); }
  .prose :global(.viz-stat.party-reform) { border-top-color: var(--party-reform); }

  .prose :global(.viz-panel-party-conservative) { border-top: 3px solid var(--party-conservative); }
  .prose :global(.viz-panel-party-labour) { border-top: 3px solid var(--party-labour); }
  .prose :global(.viz-panel-party-libdem) { border-top: 3px solid var(--party-libdem); }
  .prose :global(.viz-panel-party-green) { border-top: 3px solid var(--party-green); }
  .prose :global(.viz-panel-party-independent) { border-top: 3px solid var(--party-independent); }
  .prose :global(.viz-panel-party-reform) { border-top: 3px solid var(--party-reform); }

  /* Headline figure */
  .prose :global(.viz-hero) { padding: 2.5rem 1.5rem; }
  .prose :global(.viz-hero .value) { font-size: 4rem; }
  .prose :global(.viz-hero .headline) {
    display: block;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--ink);
    margin-top: 0.75rem;
  }
  .prose :global(.viz-hero .subtext) {
    display: block;
    font-size: 1rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  /* Small label */
  .prose :global(.viz-badge) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: var(--radius-sm);
  }

  .prose :global(.viz-badge.teal) { color: var(--text-teal); border-color: var(--accent-border); }
  .prose :global(.viz-badge.green) { color: var(--text-green); border-color: rgba(46, 107, 48, 0.35); }
  .prose :global(.viz-badge.orange) { color: var(--text-orange); border-color: rgba(153, 73, 11, 0.35); }

  .prose :global(.viz-marquee) {
    margin: 2rem 0;
    padding: 0.75rem 1.25rem;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    font-size: 1rem;
    text-align: center;
  }

  /* Then and now */
  .prose :global(.viz-comparison) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 2rem 0;
  }

  .prose :global(.viz-comparison .side) {
    padding: 1.25rem 1rem;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--line-strong);
    border-radius: var(--radius-sm);
  }

  .prose :global(.viz-comparison .side.after) { border-top-color: var(--chart-1); }
  .prose :global(.viz-comparison .side .value) { font-size: 2.5rem; }

  .prose :global(.viz-comparison .side .label) {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  /* Person quote */
  .prose :global(.person-quote) { text-align: center; border-top: 3px solid var(--gold); }
  .prose :global(.person-quote .photo) {
    width: 96px; height: 96px; border-radius: 50%; object-fit: cover; margin: 0 auto 1rem; display: block;
  }
  .prose :global(.person-quote .quote-mark) { display: none; }
  .prose :global(.person-quote .quote-text) {
    font-family: var(--font-display); font-size: 1.25rem; color: var(--ink); line-height: 1.5;
    max-width: 540px; margin: 0 auto 0.75rem;
  }
  .prose :global(.person-quote .attribution) { font-size: 1rem; font-weight: 700; color: var(--ink); }
  .prose :global(.person-quote .role) { font-size: 0.9375rem; color: var(--muted); margin-top: 2px; }

  /* Photo banner */
  .prose :global(.photo-banner) {
    margin: 2rem 0;
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    min-height: 260px;
    display: flex;
    align-items: flex-end;
  }

  .prose :global(.photo-banner img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; margin: 0;
  }

  .prose :global(.photo-banner .overlay) {
    position: relative; z-index: 1; width: 100%; padding: 2.5rem 1.5rem 1.25rem;
    background: linear-gradient(to top, rgba(27, 48, 53, 0.92) 0%, rgba(27, 48, 53, 0.6) 60%, transparent 100%);
  }

  .prose :global(.photo-banner .overlay h3) { font-size: 1.5rem; color: #faf9f5; margin: 0 0 6px; }
  .prose :global(.photo-banner .overlay p) { font-size: 1rem; color: #e8ece9; margin: 0; }

  /* ---- Responsive ---- */
  @media (max-width: 960px) {
    .prose :global(.viz-grid-4) { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .prose :global(.viz-grid-3),
    .prose :global(.viz-grid-4) { grid-template-columns: repeat(2, 1fr); }

    .prose :global(.viz-stat .value) { font-size: 1.875rem; }
    .prose :global(.viz-stat .value.lg) { font-size: 2.125rem; }
    .prose :global(.viz-stat .value.xl) { font-size: 2.25rem; }
    .prose :global(.viz-hero .value) { font-size: 3rem; }
    .prose :global(.viz-comparison .side .value) { font-size: 2rem; }

    /* Force inline 4 and 3 column grids to 2 columns on tablet */
    .prose :global(div[style*="repeat(4"]),
    .prose :global(div[style*="repeat(3"]) { grid-template-columns: repeat(2, 1fr) !important; }

    .prose :global(span[style*="font-size: 4.5rem"]) { font-size: 3rem !important; }
    .prose :global(span[style*="font-size: 3.5rem"]) { font-size: 2.5rem !important; }
    .prose :global(span[style*="font-size: 3rem"]) { font-size: 2.25rem !important; }
    .prose :global(span[style*="font-size: 2.5rem"]) { font-size: 1.75rem !important; }

    /* Tables scroll sideways rather than squeezing */
    .prose :global(table) {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      font-size: 0.9375rem;
    }
  }

  @media (max-width: 640px) {
    .blog-post { padding: 1.25rem var(--gutter) 3rem; }

    .article-title { font-size: 2rem; }
    .article-standfirst { font-size: 1.1875rem; }

    .prose { font-size: 1.125rem; }
    .prose :global(h2) { font-size: 1.5rem; }
    .prose :global(h3) { font-size: 1.25rem; }

    .prose :global(.viz-panel),
    .prose :global(.viz-panel-reform),
    .prose :global(.viz-callout),
    .prose :global(.viz-progress),
    .prose :global(.person-quote) { padding: 1.1rem 14px; }

    .prose :global(.viz-grid-2),
    .prose :global(.viz-grid-3),
    .prose :global(.viz-grid-4),
    .prose :global(.viz-comparison) { grid-template-columns: 1fr; }

    .prose :global(.viz-stat .value) { font-size: 1.875rem; }
    .prose :global(.viz-stat .value.lg),
    .prose :global(.viz-stat .value.xl) { font-size: 2.125rem; }
    .prose :global(.viz-hero) { padding: 1.75rem 14px; }
    .prose :global(.viz-hero .value) { font-size: 2.5rem; }

    .prose :global(.photo-banner) { min-height: 200px; }
    .prose :global(.photo-banner .overlay) { padding: 2rem 14px 1rem; }
    .prose :global(.photo-banner .overlay h3) { font-size: 1.25rem; }

    /* Force all inline multi-column grids to one column on phones */
    .prose :global(div[style*="repeat(4"]),
    .prose :global(div[style*="repeat(3"]),
    .prose :global(div[style*="repeat(2"]),
    .prose :global(div[style*="1fr 1fr"]) { grid-template-columns: 1fr !important; }

    .prose :global(span[style*="font-size: 4.5rem"]) { font-size: 2.5rem !important; }
    .prose :global(span[style*="font-size: 3.5rem"]) { font-size: 2.25rem !important; }
    .prose :global(span[style*="font-size: 3rem"]) { font-size: 2rem !important; }
    .prose :global(span[style*="font-size: 2.5rem"]) { font-size: 1.5rem !important; }

---
interface Props {
  sources?: string[];
  label?: string;
}

const {
  sources = ['LCC Budget Book 2026/27', 'LCC Cabinet Reports', 'GOV.UK MHCLG Data'],
  label = 'All figures independently verifiable from public records',
} = Astro.props;
---

<div class="trust-cert">
  <div class="trust-shield">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      <polyline points="9 12 11.5 14.5 15 9.5" stroke-width="2.5"></polyline>
    </svg>
  </div>
  <div class="trust-body">
    <h4 class="trust-title">
      <span class="trust-dot"></span>
      Data Verified
    </h4>
    <ul class="trust-sources">
      {sources.map((src) => (
        <li>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          {src}
        </li>
      ))}
    </ul>
    <span class="trust-label">{label}</span>
  </div>
</div>

<style>
  .trust-cert {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-md) 0 0;
    border-top: 1px solid var(--line);
  }

  .trust-shield {
    flex-shrink: 0;
    color: var(--text-green);
  }

  .trust-body {
    flex: 1;
    min-width: 0;
  }

  .trust-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-sm);
  }

  .trust-dot {
    display: none;
  }

  .trust-sources {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .trust-sources li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .trust-sources li svg {
    flex-shrink: 0;
    color: var(--text-green);
  }

  .trust-label {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  @media (max-width: 480px) {
    .trust-cert {
      flex-direction: column;
      gap: var(--space-sm);
    }
  }
</style>

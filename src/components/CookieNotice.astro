---
// Lightweight cookie notice — no tracking cookies are set by this site,
// but PECR requires informing users about any cookies (including third-party).
// Dismissal is stored in localStorage (not a cookie) to avoid circularity.
---

<div class="cookie-notice" id="cookie-notice" role="alert" aria-live="polite" hidden>
  <div class="cookie-notice-inner">
    <p>
      This website sets no tracking or analytics cookies. The hosting provider may set
      its own. <a href="/cookies/">Learn more</a>
    </p>
    <button class="cookie-notice-btn" id="cookie-accept" type="button">
      Got it
    </button>
  </div>
</div>

<script>
  const notice = document.getElementById('cookie-notice');
  const btn = document.getElementById('cookie-accept');
  if (notice && btn) {
    if (!localStorage.getItem('cookie_notice')) {
      notice.hidden = false;
    }
    btn.addEventListener('click', () => {
      localStorage.setItem('cookie_notice', '1');
      notice.hidden = true;
    });
  }
</script>

<style>
  .cookie-notice {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    padding: var(--space-sm) var(--gutter);
    background: var(--paper);
    border-top: 1px solid var(--line-strong);
  }

  .cookie-notice-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .cookie-notice p {
    font-size: 0.9375rem;
    color: var(--ink);
    line-height: 1.5;
    margin: 0;
    max-width: none;
  }

  .cookie-notice a {
    color: var(--teal);
    font-weight: 600;
  }

  .cookie-notice-btn {
    flex-shrink: 0;
    min-height: var(--touch);
    padding: 0 22px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--paper);
    background: var(--teal);
    border-radius: var(--radius-sm);
  }

  .cookie-notice-btn:hover {
    background: var(--ink);
  }

  @media (max-width: 600px) {
    .cookie-notice-inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-sm);
    }

    .cookie-notice-btn {
      width: 100%;
    }
  }
</style>

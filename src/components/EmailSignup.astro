---
interface Props {
  variant?: 'inline' | 'compact';
}

const { variant = 'inline' } = Astro.props;
---

<div class:list={['email-signup', `email-signup--${variant}`]}>
  <div class="email-signup-text">
    {variant === 'inline' ? (
      <>
        <h3 class="email-signup-heading">The council decisions that never make the local news</h3>
        <p class="email-signup-desc">New investigations and council decisions on Padiham, Burnley and Lancashire, each with its sources. Follow by RSS, on Substack or on X.</p>
      </>
    ) : (
      <p class="email-signup-desc">Follow new posts by RSS, on Substack or on X</p>
    )}
  </div>
  <a href="/updates/" class="email-signup-btn">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 11a9 9 0 0 1 9 9"></path>
      <path d="M4 4a16 16 0 0 1 16 16"></path>
      <circle cx="5" cy="19" r="1"></circle>
    </svg>
    Ways to follow
  </a>
</div>

<style>
  .email-signup {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-lg);
    background: var(--panel);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius-sm);
  }

  .email-signup--inline {
    justify-content: space-between;
    padding: var(--space-lg) var(--space-xl);
  }

  .email-signup--compact {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: 0;
    background: none;
    border-top: 0;
  }

  .email-signup-text {
    flex: 1;
  }

  .email-signup-heading {
    font-size: 1.375rem;
    color: var(--ink);
    margin: 0 0 var(--space-xs);
  }

  .email-signup-desc {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
    max-width: 60ch;
  }

  .email-signup-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--touch);
    padding: 0.6rem 1.25rem;
    background: var(--teal);
    color: var(--paper);
    border: 1px solid var(--teal);
    font-size: 1rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    text-decoration: none;
    white-space: nowrap;
  }

  .email-signup-btn:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  /* In the ink footer the button is outlined: paper text on a light teal fails */
  .email-signup--compact .email-signup-btn {
    background: transparent;
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .email-signup--compact .email-signup-btn:hover {
    border-color: var(--ink);
    background: transparent;
    color: var(--ink);
  }

  @media (max-width: 768px) {
    .email-signup,
    .email-signup--inline {
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-lg) 18px;
    }

    .email-signup--compact {
      padding: 0;
    }

    .email-signup-btn {
      justify-content: center;
    }
  }
</style>

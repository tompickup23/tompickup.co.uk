---
/* The numbered source list at the foot of a page. Item n has id source-n, which
   is where <Cite n={n} /> links. Each item names the publisher, the document, the
   page where there is one, and the date, so the figure can be checked without
   the reader having to hunt for it. */
export interface SourceItem {
  /* Publisher, document title, page and date, in that order. */
  text: string;
  url: string;
}

interface Props {
  items: SourceItem[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="sources" aria-labelledby="sources-heading">
    <h2 id="sources-heading">Sources</h2>
    <ol>
      {items.map((item, i) => (
        <li id={`source-${i + 1}`}>
          <a href={item.url}>{item.text}</a>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  /* Sources are for checking, so they are set to be read: body-adjacent size,
     full ink, not decorative small print. */
  .sources {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 2px solid var(--ink);
  }

  .sources h2 {
    font-size: 1.375rem;
    margin: 0 0 var(--space-sm);
  }

  .sources ol {
    margin: 0;
    padding-left: 1.75rem;
    list-style: decimal;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .sources li {
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
    scroll-margin-top: 88px;
  }

  .sources li::marker {
    color: var(--muted);
    font-weight: 600;
  }

  .sources a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.18em;
    overflow-wrap: anywhere;
  }

  .sources a:hover {
    color: var(--teal);
    text-decoration-color: currentColor;
  }

  .sources li:target {
    background: rgba(128, 92, 37, 0.1);
    outline: 2px solid rgba(128, 92, 37, 0.1);
  }
</style>

---
import Cite from './Cite.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <div class="hero-text">
      <p class="hero-eyebrow">Cabinet Member for Adult Social Care &middot; Reform UK</p>

      <h1 id="hero-title">Tom Pickup</h1>

      <p class="hero-role">
        Your councillor for <strong>Padiham &amp; Burnley West</strong>
      </p>

      <p class="hero-subtitle">
        I was Lead Member for Finance and Resources in 2025/26, the year the council's
        forecast overspend fell from &pound;27.9 million to &pound;2.99 million.<Cite n={1} />
        The 2026/27 budget set a 3.80% council tax rise, the lowest since 2015/16.<Cite n={2} /><Cite n={3} />
        Every figure on this site traces to a document you can open yourself.
      </p>

      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Get in touch</a>
        <a href="/about/" class="text-link">See the record <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <figure class="hero-portrait">
      <img
        src="/images/headshot.jpg"
        alt="Tom Pickup, Lancashire County Councillor for Padiham and Burnley West"
        width="280"
        height="320"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>Elected 2025. <a href="/about/">More about me</a></figcaption>
    </figure>
  </div>

  <dl class="hero-figures">
    <div>
      <dt>Lowest council tax rise since 2015/16</dt>
      <dd>3.80%<Cite n={3} /></dd>
    </div>
    <div>
      <dt>2025/26 overspend, forecast to outturn</dt>
      <dd>&pound;27.9M&rarr;&pound;2.99M<Cite n={1} /></dd>
    </div>
    <div>
      <dt>Reform UK seats at LCC, September 2026</dt>
      <dd>51/84<Cite n={4} /></dd>
    </div>
  </dl>
</section>

<style>
  .hero {
    /* Aligns with .container, whose 1200px includes its gutters */
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem var(--gutter) 1.5rem;
  }

  .hero-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    align-items: center;
    gap: 64px;
  }

  .hero-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--teal);
    margin: 0 0 0.75rem;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0 0 0.5rem;
  }

  .hero-role {
    font-size: 1.25rem;
    color: var(--ink);
    margin: 0 0 1rem;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 58ch;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: 1.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 22px;
    background: var(--teal);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .btn-primary:hover { background: var(--ink); color: var(--paper); }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: var(--touch);
    color: var(--teal);
    font-weight: 600;
  }

  .hero-portrait { margin: 0; }

  .hero-portrait img {
    display: block;
    width: 280px;
    height: 320px;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--radius-sm);
  }

  .hero-portrait figcaption {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .hero-portrait figcaption a { color: var(--teal); }

  .hero-figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 2rem 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .hero-figures > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 14px 20px 14px 0;
  }

  .hero-figures > div + div {
    border-left: 1px solid var(--line);
    padding-left: 20px;
  }

  .hero-figures dt {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .hero-figures dd {
    margin: 0 0 2px;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 800px) {
    .hero { padding-top: 1.75rem; }
    .hero-content {
      grid-template-columns: minmax(0, 1fr) 112px;
      gap: 20px;
      align-items: start;
    }
    .hero-text { display: contents; }
    .hero-eyebrow, h1, .hero-role { grid-column: 1; }
    .hero-portrait { grid-column: 2; grid-row: 1 / span 3; }
    .hero-portrait img { width: 112px; height: 128px; }
    .hero-portrait figcaption { font-size: 0.8125rem; }
    .hero-subtitle, .hero-actions { grid-column: 1 / -1; }
    .hero-actions { margin-top: 0.25rem; }
    h1 { font-size: 2.5rem; }
    .hero-role { font-size: 1.125rem; margin: 0; }
  }

  @media (max-width: 600px) {
    .hero-figures { grid-template-columns: 1fr; }
    .hero-figures > div,
    .hero-figures > div + div {
      padding: 10px 0;
      border-left: 0;
    }
    .hero-figures > div + div { border-top: 1px solid var(--line); }
  }
</style>

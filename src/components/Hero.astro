---
import StatCard from './StatCard.astro';
import Cite from './Cite.astro';
---

<section class="hero">
  <div class="hero-bg-glow"></div>
  <div class="hero-content">
    <div class="hero-text">
      <span class="hero-eyebrow">
        <span class="pulse-dot"></span>
        Cabinet Member for Adult Social Care &middot; Reform UK
      </span>

      <h1>
        Tom <span class="gradient">Pickup</span>
      </h1>

      <p class="hero-role">
        Your councillor for <strong>Padiham &amp; Burnley West</strong>
      </p>

      <p class="hero-subtitle">
        I was Lead Member for Finance and Resources in 2025/26, the year the council's
        forecast overspend fell from &pound;27.9 million to &pound;2.99 million.<Cite n={1} />
        The 2026/27 budget set a 3.80% council tax rise, the lowest since 2015/16.<Cite n={2} /><Cite n={3} />
        Every figure on this site traces to a document you can open yourself.
      </p>

      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          Get in Touch
        </a>
        <a href="/about/" class="btn btn-secondary">
          See the Record
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>
    </div>

    <div class="hero-photo-wrap">
      <div class="hero-photo-glow"></div>
      <div class="hero-photo">
        <img
          src="/images/headshot.jpg"
          alt="Tom Pickup, Lancashire County Councillor for Padiham and Burnley West"
          width="400"
          height="400"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero-photo-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        Elected 2025
      </div>
    </div>
  </div>

  <div class="hero-stats-wrap">
    <div class="hero-stats">
      <StatCard
        icon='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>'
        value="3.80%"
        label="Lowest Council Tax Rise Since 2015/16"
        cite={3}
        color="var(--chart-good)"
      />
      <StatCard
        icon='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>'
        value="&pound;27.9M&rarr;&pound;2.99M"
        label="2025/26 Overspend, Forecast to Outturn"
        cite={1}
        color="var(--chart-1)"
      />
      <StatCard
        icon='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>'
        value="51/84"
        label="Reform UK Seats at LCC, September 2026"
        cite={4}
        color="var(--chart-4)"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 3.5rem var(--gutter) 2.5rem;
  }

  .hero-bg-glow,
  .hero-photo-glow {
    display: none;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2xl);
    /* Aligns with .container, whose 1200px includes its gutters */
    max-width: calc(1200px - 2 * var(--gutter));
    margin: 0 auto;
    width: 100%;
  }

  .hero-text {
    min-width: 0;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--teal);
    margin-bottom: 1rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
    flex-shrink: 0;
  }

  h1 {
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0 0 0.75rem;
  }

  h1 .gradient {
    color: inherit;
  }

  .hero-role {
    font-size: 1.3125rem;
    color: var(--ink);
    margin: 0 0 1rem;
    max-width: none;
  }

  .hero-role strong {
    font-weight: 600;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--muted);
    max-width: 56ch;
    margin: 0 0 1.75rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--touch);
    padding: 0 1.35rem;
    border-radius: var(--radius-sm);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    line-height: 1;
  }

  .btn-primary {
    background: var(--teal);
    border: 1px solid var(--teal);
    color: var(--paper);
  }

  .btn-primary:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .btn-secondary {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--ink);
  }

  .btn-secondary:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .hero-photo-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-photo {
    width: 240px;
    height: 240px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-photo-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--space-md);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--muted);
  }

  .hero-photo-badge svg {
    flex-shrink: 0;
    color: var(--text-green);
  }

  .hero-stats-wrap {
    max-width: calc(1200px - 2 * var(--gutter));
    margin: 2.5rem auto 0;
    width: 100%;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 2rem var(--gutter) 1.5rem;
    }

    .hero-content {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    /* Text first on narrow screens. The photo above the claim pushed every word
       below the fold on a 375px viewport. */
    .hero-text {
      order: 1;
    }

    .hero-photo-wrap {
      order: 2;
      flex-direction: row;
      gap: var(--space-md);
      justify-content: flex-start;
    }

    .hero-photo {
      width: 96px;
      height: 96px;
    }

    .hero-photo-badge {
      margin-top: 0;
    }
  }

  @media (max-width: 768px) {
    .hero-stats {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .btn {
      justify-content: center;
    }
  }
</style>

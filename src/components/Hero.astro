---
import Cite from './Cite.astro';
import RecordReviewed from './RecordReviewed.astro';
import { HERO_FIGURES } from '../data/homepage-record';

const [tax, overspend, seats] = HERO_FIGURES;

/* The record, with its working shown: each figure carries a short reference to
   the document it comes from, linked to the full entry in the sources list at
   the foot of the page. data-fact, data-figure and .source-line follow the
   estate figure rule, so the design check can see every figure has a source. */
const LEDGER = [
  { line: tax, figure: tax.value, source: tax.cites[0], ref: 'MHCLG Band D council tax, table 4, 2026/27 edition' },
  { line: overspend, figure: overspend.value.replace('→', ' → '), source: overspend.cites[0], ref: 'LCC 2025/26 outturn report to Cabinet, p. 1, 2 July 2026' },
  { line: seats, figure: seats.value.replace('/', ' of '), source: seats.cites[0], ref: 'LCC councillors by party, checked 28 September 2026' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <div class="hero-text">
      <p class="hero-council">Lancashire County Council</p>

      <h1 id="hero-title" class="masthead">
        <span class="masthead-name">Tom Pickup</span><span class="sr-only">, </span>
        <span class="masthead-role">County councillor for Padiham &amp; Burnley West</span>
      </h1>

      <p class="hero-deck">Cabinet Member for Adult Social Care. Every figure on this site traces to a document you can open yourself.</p>

      <p class="hero-subtitle">
        I was Lead Member for Finance and Resources in 2025/26, the year the council's
        forecast overspend fell from &pound;27.9 million to &pound;2.99 million.<Cite n={1} />
        The 2026/27 budget set a 3.80% council tax rise, the lowest since 2015/16.<Cite n={2} /><Cite n={3} />
      </p>

      <div class="hero-actions">
        <a href="/contact/" class="hero-btn">Get in touch</a>
        <a href="/about/" class="hero-link">Read my record and roles</a>
      </div>
    </div>

    <figure class="hero-portrait">
      <img
        src="/images/headshot.jpg" srcset="/images/headshot-160.webp 160w, /images/headshot-320.webp 320w, /images/headshot-480.webp 480w, /images/headshot-640.webp 640w" sizes="(max-width: 860px) 104px, 320px"
        alt="Tom Pickup, Lancashire County Councillor for Padiham and Burnley West"
        width="320"
        height="360"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>Elected to Lancashire County Council in 2025.</figcaption>
    </figure>
  </div>

  <div class="ledger" role="list" aria-label="The record">
    {LEDGER.map(({ line, figure, source, ref }) => (
      <div class="ledger-item" id={line.id} role="listitem" data-fact>
        <p class="ledger-figure" data-figure>{figure}</p>
        <p class="ledger-label">{line.label}</p>
        <p class="source-line ek-meta"><a href={`#source-${source}`}>Source {source}: {ref}</a></p>
        <RecordReviewed id={line.id} reviewed={line.reviewed} />
      </div>
    ))}
  </div>
</section>

<style>
  .hero {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3.5rem var(--gutter) 2rem;
  }

  .hero-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    align-items: end;
    gap: 72px;
  }

  .hero-council {
    font-size: 1rem;
    font-weight: 600;
    color: var(--teal);
    margin: 0 0 1rem;
  }

  .masthead {
    margin: 0 0 1.25rem;
    letter-spacing: normal;
  }

  .masthead-name {
    display: block;
    font-size: clamp(3.25rem, 8vw, 6.25rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .masthead-role {
    display: block;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 2px solid var(--gold);
    max-width: 30ch;
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .hero-deck {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.1875rem, 1.8vw, 1.4375rem);
    line-height: 1.45;
    color: var(--ink);
    max-width: 44ch;
    margin: 0 0 1rem;
  }

  .hero-subtitle {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--muted);
    max-width: 60ch;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: 1.75rem;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 24px;
    background: var(--teal);
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .hero-btn:hover { background: var(--ink); color: var(--paper); }

  .hero-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    color: var(--teal);
    font-weight: 600;
  }

  .hero-portrait { margin: 0; }

  .hero-portrait img {
    display: block;
    width: 320px;
    height: 360px;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--radius-sm);
    box-shadow: 12px 12px 0 var(--panel);
  }

  .hero-portrait figcaption {
    margin-top: 18px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* The ledger: three figures, each with the document it rests on. */
  .ledger {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 3rem 0 0;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }

  .ledger-item {
    padding: 18px 24px 18px 0;
    scroll-margin-top: 88px;
  }

  .ledger-item + .ledger-item {
    border-left: 1px solid var(--line);
    padding-left: 24px;
  }

  .ledger-figure {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .ledger-label {
    margin: 6px 0 10px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.4;
  }

  .source-line {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .source-line a {
    color: var(--gold);
    text-decoration-color: rgba(128, 92, 37, 0.4);
  }

  .source-line a:hover { color: var(--ink); text-decoration-color: currentColor; }

  .ledger-item :global(.record-meta) { margin-top: 8px; }

  @media (max-width: 860px) {
    .hero { padding-top: 2rem; }
    .hero-content {
      grid-template-columns: minmax(0, 1fr) 104px;
      gap: 20px;
      align-items: start;
    }
    .hero-text { display: contents; }
    .hero-council, .masthead { grid-column: 1; }
    .hero-portrait { grid-column: 2; grid-row: 1 / span 2; }
    .hero-portrait img { width: 104px; height: 120px; box-shadow: 6px 6px 0 var(--panel); }
    .hero-portrait figcaption { display: none; }
    .hero-deck, .hero-subtitle, .hero-actions { grid-column: 1 / -1; }
    .hero-actions { margin-top: 0.5rem; }
    .masthead-role { max-width: none; }
  }

  @media (max-width: 640px) {
    .ledger { grid-template-columns: 1fr; margin-top: 2rem; }
    .ledger-item,
    .ledger-item + .ledger-item {
      padding: 14px 0;
      border-left: 0;
    }
    .ledger-item + .ledger-item { border-top: 1px solid var(--line); }
  }
</style>

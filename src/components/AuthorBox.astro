---
/* Who wrote this, shown under every article. It says who is behind the piece and
   where to check the method, which is what a reader deciding whether to trust a
   figure needs, and it links the article to /about/ for search engines as well. */
import { person } from '../data/person';
---

<aside class="author-box" aria-label="About the author">
  <img
    class="author-photo"
    src="/images/headshot.jpg"
    alt=""
    width="64"
    height="64"
    loading="lazy"
    decoding="async"
  />
  <div class="author-text">
    <p class="author-line">
      <a href="/about/" rel="author">{person.name}</a> is County Councillor for Padiham and
      Burnley West and Cabinet Member for Adult Social Care at Lancashire County Council.
    </p>
    <p class="author-line author-links">
      <a href="/about/">About me</a>
      <span aria-hidden="true">·</span>
      <a href="/press/">How I source figures and handle corrections</a>
    </p>
  </div>
</aside>

<style>
  .author-box {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1.25rem 1.5rem;
    margin: 0 0 2rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
  }

  .author-photo {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent-border);
  }

  .author-line {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .author-line + .author-line {
    margin-top: 0.375rem;
  }

  .author-line a {
    color: var(--accent);
    text-decoration: none;
  }

  .author-line a:hover {
    text-decoration: underline;
  }

  .author-line > a[rel='author'] {
    color: var(--text-primary);
    font-weight: 600;
  }

  .author-links {
    font-size: 0.875rem;
  }

  .author-links span {
    margin: 0 0.375rem;
    color: var(--text-tertiary);
  }

  @media (max-width: 480px) {
    .author-box {
      align-items: flex-start;
      padding: 1rem;
    }

    .author-photo {
      width: 48px;
      height: 48px;
    }
  }
</style>

---
/* Who wrote this, shown under every article. It says who is behind the piece and
   where to check the method, which is what a reader deciding whether to trust a
   figure needs, and it links the article to /about/ for search engines as well. */
import { person } from '../data/person';
---

<aside class="author-box" aria-label="About the author">
  <img
    class="author-photo"
    src="/images/headshot.jpg"
    alt=""
    width="64"
    height="64"
    loading="lazy"
    decoding="async"
  />
  <div class="author-text">
    <p class="author-line">
      <a href="/about/" rel="author">{person.name}</a> is County Councillor for Padiham and
      Burnley West and Cabinet Member for Adult Social Care at Lancashire County Council.
    </p>
    <p class="author-line author-links">
      <a href="/about/">About me</a>
      <span aria-hidden="true">·</span>
      <a href="/press/">How I source figures and handle corrections</a>
    </p>
  </div>
</aside>

<style>
  .author-box {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem 0;
    margin: 0 0 1.5rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .author-photo {
    flex: none;
    width: 64px;
    height: 72px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    object-position: 50% 30%;
  }

  .author-line {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink);
  }

  .author-line + .author-line {
    margin-top: 0.25rem;
  }

  .author-line a {
    color: var(--teal);
    font-weight: 600;
  }

  .author-line a:hover {
    color: var(--ink);
  }

  .author-line > a[rel='author'] {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  .author-links span {
    margin: 0 0.375rem;
    color: var(--muted);
  }

  @media (max-width: 480px) {
    .author-photo {
      width: 52px;
      height: 60px;
    }
  }
</style>

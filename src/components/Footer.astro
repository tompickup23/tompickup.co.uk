---
import EmailSignup from './EmailSignup.astro';
import { FOOTER_PROJECTS } from '../data/projects';
import { imprint as imp } from '../data/imprint';
const currentYear = new Date().getFullYear();

/* Articles end with their own signup, so the footer's is left off there:
   one invitation per page, not two. */
interface Props { signup?: boolean }
const { signup = true } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Tom Pickup">
          Tom <span class="footer-logo-accent">Pickup</span>
        </a>
        {signup && (
          <div class="footer-signup">
            <EmailSignup variant="compact" />
          </div>
        )}
      </div>

      <!-- Quick links Column -->
      <div class="footer-links">
        <h4 class="footer-heading">Quick links</h4>
        <nav aria-label="Footer navigation">
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/news/">News</a></li>
            <li><a href="/studies/">Studies</a></li>
            <li><a href="/projects/">Projects</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </nav>
      </div>

      <!-- Projects Column -->
      <div class="footer-links">
        <h4 class="footer-heading">Projects</h4>
        <nav aria-label="Projects navigation">
          <ul>
            {FOOTER_PROJECTS.map((p) => (
              <li>
                <a
                  href={p.href}
                  target={p.external ? '_blank' : undefined}
                  rel={p.external ? 'noopener noreferrer' : undefined}
                >
                  {p.title}
                  {p.external && <span class="footer-ext" aria-hidden="true">&#8599;</span>}
                </a>
              </li>
            ))}
            <li><a class="footer-all" href="/projects/">All projects</a></li>
          </ul>
        </nav>
      </div>

      <!-- Social Column -->
      <div class="footer-social">
        <h4 class="footer-heading">Follow</h4>
        <div class="social-links">
          <!-- X (Twitter) -->
          <a
            href="https://x.com/tompickup"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon"
            aria-label="Follow on X (formerly Twitter)"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>

          <!-- Facebook -->
          <a
            href="https://www.facebook.com/tompickupburnley"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon"
            aria-label="Follow on Facebook"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </a>

          <!-- Instagram -->
          <a
            href="https://www.instagram.com/tompickupburnley"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon"
            aria-label="Follow on Instagram"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Legal links -->
    <div class="footer-legal-links">
      <a href="/press/">Press</a>
      <span class="footer-dot" aria-hidden="true">&middot;</span>
      <a href="/privacy/">Privacy policy</a>
      <span class="footer-dot" aria-hidden="true">&middot;</span>
      <a href="/cookies/">No cookies set</a>
      <span class="footer-dot" aria-hidden="true">&middot;</span>
      <a href="/about/#accessibility">Accessibility</a>
    </div>

    <div class="footer-legal">
      {imp.show && (
        <p class="footer-imprint">
          Promoted by {imp.promoter} on behalf of {imp.onBehalfOf}, both at {imp.address}{imp.party ? `, and by ${imp.party}` : ''}.
        </p>
      )}
      <p class="footer-copyright">
        &copy; {currentYear} Tom Pickup. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  /* Ink footer, as in the approved prototype. The tokens are redefined for this
     block so the signup form and links inside it read on the dark ground.
     Contrast on #1b3035: #f7f4eb 12.6:1, #c5d1d0 8.8:1, #9fd6cc 8.5:1, #e0c48f 8.2:1. */
  .site-footer {
    --ink: #f7f4eb;
    --muted: #c5d1d0;
    --teal: #9fd6cc;
    --line: #3d5257;
    --line-strong: #5b7076;
    --surface: #243c42;
    --panel: #243c42;
    --text-primary: #f7f4eb;
    --text-secondary: #c5d1d0;
    --accent: #9fd6cc;
    --accent-glow: rgba(159, 214, 204, 0.08);
    --accent-border: rgba(159, 214, 204, 0.3);
    background: #1b3035;
    color: #f7f4eb;
    margin-top: var(--space-2xl);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-2xl) var(--gutter) var(--space-xl);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .footer-logo {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.015em;
    text-decoration: none;
    margin-bottom: var(--space-sm);
  }

  .footer-logo:hover {
    color: var(--ink);
  }

  .footer-logo-accent {
    color: inherit;
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #e0c48f;
    margin-bottom: var(--space-sm);
  }

  .footer-links ul {
    display: flex;
    flex-direction: column;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-size: 1rem;
    color: var(--muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .footer-ext {
    font-size: 0.8em;
    margin-left: 4px;
  }

  /* The index link, not another project. */
  .footer-links a.footer-all {
    color: var(--teal);
  }

  .social-links {
    display: flex;
    gap: var(--space-sm);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--touch);
    height: var(--touch);
    border-radius: var(--radius-sm);
    color: var(--muted);
    border: 1px solid var(--line);
    text-decoration: none;
  }

  .social-icon:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .footer-legal-links {
    border-top: 1px solid var(--line);
    padding-top: var(--space-md);
    display: flex;
    align-items: center;
    column-gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-sm);
  }

  .footer-legal-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    font-size: 0.9375rem;
    color: var(--muted);
    text-decoration: none;
  }

  .footer-legal-links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .footer-dot {
    display: none;
  }

  /* Imprint: same size and contrast as the links above it. An imprint that
     cannot be read fails at the only thing it exists to do. */
  .footer-legal {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .footer-imprint,
  .footer-copyright {
    font-size: 0.875rem;
    color: var(--muted);
    max-width: 75ch;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .footer-inner {
      padding: var(--space-xl) var(--gutter) var(--space-lg);
    }

    .footer-legal {
      flex-direction: column;
      gap: var(--space-sm);
    }
  }
</style>

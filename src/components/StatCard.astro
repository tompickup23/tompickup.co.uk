---
interface Props {
  icon: string;
  value: string;
  label: string;
  color?: string;
  /* Number in the page's <Sources /> list. */
  cite?: number;
}

import Cite from './Cite.astro';

const { icon, value, label, color = 'var(--chart-1)', cite } = Astro.props;
---

<div class="stat-card" style={`--stat-rule: ${color};`}>
  <span class="stat-icon" set:html={icon} />
  <span class="stat-value">{value}</span>
  <span class="stat-label">{label}{cite && <Cite n={cite} />}</span>
</div>

<style>
  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 1.1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--stat-rule, var(--teal));
    border-radius: var(--radius-sm);
  }

  .stat-icon {
    display: none;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variant-numeric: tabular-nums lining-nums;
    line-height: 1.1;
  }

  .stat-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--muted);
    line-height: 1.35;
  }

  @media (max-width: 768px) {
    .stat-value {
      font-size: 1.5rem;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import { articleImage, imageQuality } from '../lib/images';

interface Props {
  title: string;
  date: string;
  description: string;
  slug: string;
  tags?: string[];
  image?: string;
  headingLevel?: 'h3' | 'h4';
}

const { title, date, description, slug, tags = [], image, headingLevel: Heading = 'h3' } = Astro.props;
const imageMeta = articleImage(image);

function formatDate(dateStr: string): string {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  } catch {
    return dateStr;
  }
}
---

<a href={`/news/${slug}/`} class={`news-card ${image ? 'has-image' : ''}`}>
  <div class="news-card-overlay"></div>

  {image && (
    <div class="news-card-image">
      {imageMeta ? (
        <Image
          src={imageMeta}
          alt=""
          widths={[400, 640, 800]}
          sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 900px) 45vw, 380px"
          format="webp"
          quality={imageQuality(image)}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <img src={image} alt="" loading="lazy" decoding="async" />
      )}
    </div>
  )}

  {tags.length > 0 && (
    <div class="news-tags">
      {tags.map((tag) => (
        <span class="news-tag">{tag}</span>
      ))}
    </div>
  )}

  <Heading class="news-title">{title}</Heading>

  <time class="news-date" datetime={date}>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    {formatDate(date)}
  </time>

  <p class="news-description">{description}</p>

  <span class="read-more">
    Read more
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </span>
</a>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 0 1.25rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    height: 100%;
    box-sizing: border-box;
  }

  .news-card:hover {
    color: var(--ink);
  }

  .news-card:hover .news-title {
    color: var(--teal);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .news-card-overlay {
    display: none;
  }

  .news-card-image {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    margin-bottom: 4px;
    background: var(--panel);
    border-radius: var(--radius-sm);
  }

  .news-card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .news-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 12px;
    overflow: hidden;
    max-height: 1.5em;
  }

  .news-tag {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--teal);
  }

  .news-title {
    font-size: 1.3125rem;
    line-height: 1.25;
    margin: 0;
    color: var(--ink);
  }

  .news-date {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9375rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .news-date svg {
    display: none;
  }

  .news-description {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more {
    display: none;
  }
</style>

---
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/news/', label: 'News' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Tom Pickup, home">
      <span class="brand-text">Tom Pickup</span>
      <span class="brand-role">County Councillor, Padiham and Burnley West</span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={['nav-link', { active: isActive(link.href) }]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button
        class="mobile-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true" inert>
    <nav aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={['mobile-link', { active: isActive(link.href) }]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  function initHeader() {
    const toggle = document.querySelector('.mobile-toggle') as HTMLButtonElement;
    const menu = document.getElementById('mobile-menu') as HTMLElement;
    const header = document.querySelector('.site-header') as HTMLElement;

    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isOpen));
        toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
        menu.setAttribute('aria-hidden', String(isOpen));
        menu.inert = isOpen;
        menu.classList.toggle('is-open', !isOpen);
        header.classList.toggle('menu-open', !isOpen);
      });

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (menu.classList.contains('is-open') && !menu.contains(target) && !toggle.contains(target)) {
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open menu');
          menu.setAttribute('aria-hidden', 'true');
          menu.inert = true;
          menu.classList.remove('is-open');
          header.classList.remove('menu-open');
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu.classList.contains('is-open')) {
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open menu');
          menu.setAttribute('aria-hidden', 'true');
          menu.inert = true;
          menu.classList.remove('is-open');
          header.classList.remove('menu-open');
          toggle.focus();
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initHeader);
  initHeader();
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--blur-bg);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: 64px;
  }

  /* Wordmark */
  .brand {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: var(--touch);
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .brand-role {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 2px;
  }

  /* Desktop navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--teal);
  }

  .nav-link.active {
    border-bottom-color: var(--teal);
  }

  /* Header actions */
  .header-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* Mobile toggle */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: var(--touch);
    height: var(--touch);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-toggle:hover {
    border-color: var(--ink);
  }

  .hamburger-line {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--ink);
    transition: transform var(--transition-normal), opacity var(--transition-fast);
  }

  .site-header.menu-open .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .site-header.menu-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .site-header.menu-open .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    max-height: 0;
    overflow: hidden;
    background: var(--paper);
    transition: max-height 0.3s var(--ease-smooth), padding 0.3s var(--ease-smooth);
    padding: 0 var(--gutter);
  }

  .mobile-menu.is-open {
    max-height: 80vh;
    padding: var(--space-sm) var(--gutter) var(--space-md);
    border-top: 1px solid var(--line);
    overflow-y: auto;
  }

  .mobile-menu nav {
    display: flex;
    flex-direction: column;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    min-height: 48px;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .mobile-link:last-child {
    border-bottom: 0;
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: var(--teal);
  }

  .mobile-link.active {
    box-shadow: inset 3px 0 0 var(--teal);
    padding-left: 12px;
  }

  @media (max-width: 860px) {
    .brand-role {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .mobile-menu {
      display: block;
    }

    .brand-role {
      display: block;
      font-size: 0.6875rem;
      letter-spacing: 0.04em;
    }
  }

  @media (max-width: 360px) {
    .brand-role {
      display: none;
    }
  }
</style>

---
import type { Project } from '../data/projects';
import { PROJECT_DETAILS } from '../data/projects';
interface Props { project: Project }
const { project: p } = Astro.props;
const detail = PROJECT_DETAILS[p.title];
const location = p.external ? new URL(p.href).hostname : 'Here on tompickup.co.uk';
---

<article class="project-card" style={`--project-accent:${p.accent}`}>
  <div class="card-top">
    <span class="project-mark" aria-hidden="true">{detail.mark}</span>
    <span class="project-type">{detail.subject}</span>
  </div>
  <h3><a href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener noreferrer' : undefined}>
    {p.title}<span class="title-arrow" aria-hidden="true">{p.external ? '↗' : '→'}</span>
    {p.external && <span class="sr-only"> (opens in a new tab)</span>}
  </a></h3>
  <p class="project-description">{p.desc}</p>
  <div class="card-bottom">
    {p.source && <p class="project-source"><span>Sources:</span> {p.source}</p>}
    <p class="project-location">{location}</p>
  </div>
  {(detail.article || detail.section) && <div class="related-links">
    <span class="related-label">Also on this site</span>
    {detail.article && <a href={`/news/${detail.article.slug}/`}>{detail.article.label}<span aria-hidden="true">→</span></a>}
    {detail.section && <a href={detail.section.href}>{detail.section.label}<span aria-hidden="true">→</span></a>}
  </div>}
</article>

<style>
  /* Each project keeps its brand accent as a mark (the short rule and the
     initials tile border). Accents are too light for text on paper, so text
     stays ink, muted or teal. */
  .project-card { height: 100%; display: flex; flex-direction: column; padding: 18px 20px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); position: relative; }
  .project-card::before { content: ''; position: absolute; top: -1px; left: -1px; right: -1px; height: 3px; background: var(--project-accent); }
  .project-card:hover, .project-card:focus-within { border-color: var(--line-strong); }
  .card-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
  .project-mark { display: grid; place-items: center; width: 36px; height: 36px; flex-shrink: 0; border-radius: var(--radius-sm); color: var(--ink); background: var(--paper); border: 1px solid var(--line-strong); box-shadow: inset 0 -3px 0 var(--project-accent); font-size: 13px; font-weight: 700; }
  .project-type { color: var(--muted); font-size: 0.875rem; text-align: right; line-height: 1.4; }
  h3 { font-size: clamp(1.25rem, 1.8vw, 1.375rem); margin: 0 0 6px; }
  h3 a { display: flex; justify-content: space-between; gap: 15px; color: var(--ink); text-decoration: none; }
  h3 a:hover { color: var(--teal); text-decoration: underline; }
  .title-arrow { color: var(--teal); font-size: 1.1rem; font-weight: 400; padding-top: 3px; }
  .project-description { color: var(--muted); font-size: 1rem; line-height: 1.55; margin: 0 0 12px; }
  .card-bottom { margin-top: auto; }
  .project-source { color: var(--muted); font-size: 0.9375rem; line-height: 1.5; }
  .project-source > span { color: var(--ink); font-weight: 600; }
  .project-location { color: var(--teal); font-size: 0.9375rem; margin-top: 4px; overflow-wrap: anywhere; }
  .related-links { border-top: 1px solid var(--line); margin-top: 12px; padding-top: 8px; }
  .related-label { display: block; color: var(--ink); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 2px; }
  .related-links a { display: flex; justify-content: space-between; align-items: center; gap: 14px; min-height: var(--touch); color: var(--teal); font-size: 1rem; }
  .related-links a:hover { color: var(--ink); }
  @media (max-width: 560px) { .project-card { padding: 16px; } }
</style>

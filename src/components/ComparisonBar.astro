---
interface Props {
  title?: string;
  reformLabel?: string;
  reformValue: string;
  reformPercent: number;
  conLabel?: string;
  conValue: string;
  conPercent: number;
  annotation?: string;
  lowerIsBetter?: boolean;
}

const {
  title,
  reformLabel = 'Reform',
  reformValue,
  reformPercent,
  conLabel = 'Conservative',
  conValue,
  conPercent,
  annotation,
  lowerIsBetter = false,
} = Astro.props;

const reformWins = lowerIsBetter ? reformPercent <= conPercent : reformPercent >= conPercent;
---

<div class="cbar">
  {title && <h4 class="cbar-title">{title}</h4>}

  <div class="cbar-row">
    <div class="cbar-meta">
      <span class="cbar-label cbar-reform">{reformLabel}</span>
      <span class="cbar-value cbar-reform">
        {reformValue}
        {reformWins && (
          <svg class="cbar-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        )}
      </span>
    </div>
    <div class="cbar-track">
      <div class="cbar-fill cbar-fill-reform" style={`--fill-width: ${reformPercent}%;`}></div>
    </div>
  </div>

  <div class="cbar-row">
    <div class="cbar-meta">
      <span class="cbar-label cbar-con">{conLabel}</span>
      <span class="cbar-value cbar-con">
        {conValue}
        {!reformWins && (
          <svg class="cbar-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        )}
      </span>
    </div>
    <div class="cbar-track">
      <div class="cbar-fill cbar-fill-con" style={`--fill-width: ${conPercent}%;`}></div>
    </div>
  </div>

  {annotation && <span class="cbar-annotation">{annotation}</span>}
</div>

<style>
  /* Two years of one council, not two parties: the current year is the
     validated chart teal, the comparison year neutral grey. Values are ink. */
  .cbar {
    padding: var(--space-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .cbar-title {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: var(--space-md);
  }

  .cbar-row {
    margin-bottom: var(--space-md);
  }

  .cbar-row:last-of-type {
    margin-bottom: 0;
  }

  .cbar-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .cbar-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }

  .cbar-value {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .cbar-check {
    flex-shrink: 0;
    color: var(--text-green);
  }

  .cbar-track {
    height: 14px;
    background: var(--chart-track);
    border-radius: 2px;
    overflow: hidden;
  }

  .cbar-fill {
    height: 100%;
    border-radius: 0 2px 2px 0;
    width: var(--fill-width);
  }

  .cbar-fill-reform {
    background: var(--chart-1);
  }

  .cbar-fill-con {
    background: var(--chart-neutral);
  }

  .cbar-annotation {
    display: block;
    margin-top: var(--space-md);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }
</style>

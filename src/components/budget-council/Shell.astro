---
// Budget Council: the page frame every council's simulator shares. The council page passes its
// words; its own <script> mounts the app (src/games/budget-council/app.js) into #bc-app.
import Layout from '../../layouts/Layout.astro';
import { PROTOTYPE_NOTICE } from '../../data/prototype-notice';
import '../../games/budget-council/budget-council.css';

interface Props {
  title: string;
  pageTitle: string;
  description: string;
  ogImage: string;
  ogImageAlt: string;
  eyebrow: string;
  noscript: string;
  breadcrumbLabel?: string;
}
const { title, pageTitle, description, ogImage, ogImageAlt, eyebrow, noscript, breadcrumbLabel } = Astro.props;
---

<Layout
  title={pageTitle}
  description={description}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  ogImageWidth={1200}
  ogImageHeight={630}
  breadcrumbLabel={breadcrumbLabel || title}
  noindex
>
  <div class="bc">
    <p class="bc-proto" role="note">
      <b>Prototype</b>
      A training simulator built by Tom Pickup for his own website. Not a council service, and not council training material. Nothing you choose is collected, stored or sent.
      {PROTOTYPE_NOTICE}
    </p>
    <header class="bc-head">
      <div>
        <p class="bc-eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
      </div>
      <nav class="bc-tabs" id="bc-tabs" aria-label="Sections"></nav>
    </header>
    <main id="bc-app" class="bc-app">
      <noscript>
        <p>{noscript}</p>
      </noscript>
    </main>
    <p class="bc-sr" id="bc-sr" aria-live="polite"></p>
  </div>
</Layout>

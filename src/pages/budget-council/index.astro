  .bc .ylv-room-label { position: absolute; left: 12px; bottom: 10px; padding: 5px 12px; border-radius: 999px; background: rgba(0, 0, 0, 0.62); color: #fff; font: 700 0.95rem/1.2 var(--font-sans); pointer-events: none; }
  .bc .ylv-room-label:empty { display: none; }
  .bc-plan { width: 100%; height: auto; display: block; }
  .bc-plan .lbl { font: 600 9px var(--font-sans); letter-spacing: 0.12em; fill: #5b4a36; }
  .bc-plan .talk { fill: none; stroke: #111; stroke-width: 3; stroke-dasharray: 5 4; }
  .bc-app .bc-tools { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 0; max-width: none; }
  .bc-chip { display: inline-flex; align-items: center; min-height: var(--touch); padding: 0 14px; border: 1.5px solid var(--line-strong); border-radius: 999px; background: var(--surface); color: var(--ink); font: 600 0.9rem/1.2 var(--font-sans); cursor: pointer; }
  .bc-chip[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .bc-chip.is-note { border-style: dashed; cursor: default; }
  .bc-agenda { list-style: none; margin: 14px 0; padding: 0; display: grid; gap: 2px; font-size: 0.9rem; }
  .bc-agenda li { padding: 5px 10px; border-left: 3px solid var(--line); color: var(--muted); max-width: none; }
  .bc-agenda li.on { border-color: var(--teal); background: var(--panel); color: var(--ink); }
  .bc-agenda li.done b { text-decoration: line-through; font-weight: 600; }
  .bc-screen { background: #10201d; color: #fff; border-radius: var(--radius-xl); padding: 18px 20px; border-bottom: 5px solid #24509c; display: grid; gap: 8px; }
  .bc-screen .who { font: 600 0.8rem/1.2 var(--font-sans); letter-spacing: 0.08em; text-transform: uppercase; color: #d9bd83; }
  .bc-screen q { font: 600 1.18rem/1.45 var(--font-display); quotes: '\201C' '\201D'; }
  .bc-screen .bc-term { color: #fff; }
  .bc-plain { background: var(--panel); border-radius: var(--radius-xl); padding: 12px 16px; margin: 0; }
  .bc-term { border: 0; background: none; padding: 0; margin: 0; font: inherit; color: inherit; cursor: help; text-decoration: underline dotted; text-decoration-thickness: 2px; text-underline-offset: 4px; }

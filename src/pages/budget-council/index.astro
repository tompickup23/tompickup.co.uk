  .bc-def:empty { display: none; }
  .bc-rule { border-left: 4px solid var(--teal); background: var(--surface); padding: 10px 14px; border-radius: 0 var(--radius-lg) var(--radius-lg) 0; font-size: 0.94rem; }
  .bc-rule b { text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.1em; color: var(--teal); margin-right: 6px; }
  .bc-figs { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .bc-figs li { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-xl); padding: 10px 12px; display: grid; gap: 4px; max-width: none; }
  .bc-figs b { font: 700 1.3rem/1.1 var(--font-sans); font-variant-numeric: tabular-nums; }
  .bc-figs span { font-size: 0.86rem; }
  .bc-meters { display: grid; gap: 6px; }
  .bc-meter { display: grid; grid-template-columns: 11em 1fr 6em; gap: 10px; align-items: center; font-size: 0.88rem; }
  .bc-meter i { height: 8px; border-radius: 4px; background: linear-gradient(90deg, var(--teal) var(--w), var(--chart-track) var(--w)); }
  .bc-meter em { font-style: normal; color: var(--muted); font-variant-numeric: tabular-nums; }
  @media (max-width: 480px) { .bc-meter { grid-template-columns: 1fr 5em; } .bc-meter i { grid-column: 1 / -1; grid-row: 2; } }
  .bc-tablewrap { overflow-x: auto; max-width: 100%; }

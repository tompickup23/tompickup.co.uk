  .bc-choices { display: grid; gap: 8px; }
  .bc-choices .bc-btn { justify-content: flex-start; border-radius: var(--radius-xl); padding: 10px 16px; }
  .bc-sides, .bc-pick { border: 0; padding: 0; margin: 0; display: grid; gap: 8px; }
  .bc-pick { display: flex; flex-wrap: wrap; }
  .bc-sides legend, .bc-pick legend, .bc-parts legend { font-weight: 700; padding: 0 0 8px; }
  .bc-sides button, .bc-pick button { display: grid; gap: 2px; border: 1.5px solid var(--line-strong); background: var(--surface); border-radius: var(--radius-xl); padding: 10px 14px; min-height: var(--touch); font: inherit; color: var(--ink); text-align: left; cursor: pointer; }
  .bc-sides button span { font-size: 0.88rem; color: var(--muted); }
  .bc-sides button[aria-pressed='true'], .bc-pick button[aria-pressed='true'] { border-color: var(--teal); background: var(--teal); color: #fff; }
  .bc-sides button[aria-pressed='true'] span { color: #e6f0ee; }
  .bc-seed input, .bc-hands input { width: 7em; min-height: var(--touch); font: inherit; padding: 0 8px; border: 1.5px solid var(--line-strong); border-radius: var(--radius-lg); }
  .bc-seed .bc-small { display: block; margin-top: 4px; }
  .bc-room { position: relative; aspect-ratio: 16 / 10; border-radius: var(--radius-xl); overflow: hidden; background: #1a1512; }

  .bc-tabs button { border: 0; background: none; padding: 0 12px; min-height: var(--touch); border-radius: 999px; font: 600 0.92rem/1 var(--font-sans); color: var(--muted); white-space: nowrap; cursor: pointer; }
  .bc-tabs button[aria-current] { background: var(--ink); color: var(--paper); }
  .bc-app { padding-top: 24px; }
  .bc-app h2 { margin: 0; font-size: 1.5rem; }

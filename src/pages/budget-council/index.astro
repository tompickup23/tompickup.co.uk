  .bc-lede { font-size: 1.15rem; line-height: 1.5; }
  .bc-stack { display: grid; gap: 16px; align-content: start; min-width: 0; }
  .bc-two { display: grid; gap: 28px; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
  @media (max-width: 860px) { .bc-two { grid-template-columns: minmax(0, 1fr); } }
  .bc-meet { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); }
  @media (max-width: 860px) { .bc-meet { grid-template-columns: minmax(0, 1fr); } .bc-m-words { order: -1; } .bc-m-room .bc-room, .bc-m-room > .bc-plan { max-height: 46vh; } }
  .bc-steps { display: grid; gap: 10px; padding-left: 1.3em; margin: 0; }
  .bc-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-xl); padding: 16px 18px; min-width: 0; }
  .bc-card p { margin: 0 0 8px; }
  .bc-small { font-size: 0.86rem; color: var(--muted); }
  .bc-src { display: inline; font: 400 0.78rem/1.4 var(--font-mono); color: var(--muted); }
  .bc-btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--touch); padding: 8px 18px; border: 2px solid var(--ink); border-radius: 999px; background: var(--ink); color: var(--paper); font: 700 1rem/1.25 var(--font-sans); text-decoration: none; cursor: pointer; text-align: left; }
  .bc-btn.ghost { background: transparent; color: var(--ink); }

---
// The Padiham Job: a walking game on the real street layout of Padiham town centre.
// The game code is in src/games/padiham/. The world file in public/games/the-padiham-job/
// is built offline by scripts/padiham-game/build_world.py; do not edit it by hand.
// Uses the site Layout, so the header, footer and imprint are the same as every other page.
// Launched 11 November 2026: indexable and in the sitemap.
import Layout from '../../layouts/Layout.astro';
import { person } from '../../data/person';
import { PROTOTYPE_NOTICE } from '../../data/prototype-notice';
import { PLAQUES } from '../../games/padiham/history.js';

const title = 'The Padiham Job';
const description = 'A free browser game set on the real streets of Padiham. Take jobs around town, call in at the pubs and try not to upset the pigeons.';
const ogImage = 'https://tompickup.co.uk/images/share/the-padiham-job.png';
const schema = {
  '@type': 'WebApplication',
  '@id': 'https://tompickup.co.uk/the-padiham-job/#app',
  name: title,
  url: 'https://tompickup.co.uk/the-padiham-job/',
  description,
  image: ogImage,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web browser',
  isAccessibleForFree: true,
  inLanguage: 'en-GB',
  author: { '@id': person['@id'] },
  creator: { '@id': person['@id'] },
};
---

<Layout
  title={`${title} | Tom Pickup`}
  description={description}
  ogImage={ogImage}
  ogImageAlt="The Padiham Job, a browser game set on the streets of Padiham"
  ogImageWidth={1200}
  ogImageHeight={630}
  schema={schema}
  breadcrumbLabel={title}
>
  <section class="sop-page">
    <header class="sop-intro">
      <h1>The Padiham Job</h1>
    </header>

    <div id="sop-stage" class="sop" data-world="/games/the-padiham-job/world.json">
      <canvas id="sop-view" tabindex="-1" role="img" aria-label="The game view: a figure walking the streets of Padiham"></canvas>

      <div id="sop-cash" class="sop-hud">
        £<span id="sop-money">0</span>
        <small id="sop-done">0 jobs done</small>
      </div>
      <div class="sop-buttons">
        <button id="sop-menuBtn" type="button">Menu</button>
        <button id="sop-whereBtn" type="button">Where next?</button>
        <button id="sop-again" type="button">Walk it again</button>
        <button id="sop-busBtn" type="button" hidden>Bus stop</button>
      </div>
      <div id="sop-job" class="sop-hud">
        <div class="t" id="sop-jobTitle">Loading Padiham</div>
        <div class="d" id="sop-jobText">Fetching the streets</div>
        <div class="m">
          <svg id="sop-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 L20 20 L12 15 L4 20 Z" fill="#ffcf33" stroke="#14161a" stroke-width="1.5" stroke-linejoin="round"></path></svg>
          <span id="sop-dist"></span><span id="sop-timer"></span>
        </div>
      </div>
      <button id="sop-map" class="sop-hud" type="button" aria-label="Open the full map"><canvas id="sop-mini" width="272" height="272"></canvas></button>
      <div id="sop-street" class="sop-hud">Padiham</div>
      <div id="sop-toast" class="sop-hud" role="status"></div>
      <div id="sop-hint" class="sop-hud" role="status"></div>
      <div id="sop-plaque" class="sop-hud" role="status">
        <div class="t" id="sop-plaqueTitle"></div>
        <div class="d" id="sop-plaqueText"></div>
        <div class="s" id="sop-plaqueSource"></div>
      </div>
      <div id="sop-ride" class="sop-hud" role="status">
        <div class="d" id="sop-rideText"></div>
        <div id="sop-askBtns"></div>
        <button id="sop-bell" type="button" hidden>Ring the bell</button>
      </div>
      <div id="sop-say" class="sop-sr" role="status" aria-live="polite"></div>
      <div id="sop-fade"></div>

      <div id="sop-stick"><div id="sop-knob"></div></div>
      <button id="sop-run" type="button" aria-label="Pace: walk. Press to change">WALK</button>
      <button id="sop-jump" type="button">JUMP</button>
      <button id="sop-hello" type="button" aria-label="Say hello">HI</button>

      <div id="sop-busMenu">
        <div class="box" role="dialog" aria-modal="true" aria-labelledby="sop-busStopName">
          <p class="name" id="sop-busStopName">Bus stop</p>
          <p class="sop-help">Pick your bus by its number and where it is going. Then wait at the stop.</p>
          <div id="sop-busList"></div>
          <p id="sop-busNone" class="sop-help" hidden>No bus from this stop goes on to another stop in the town centre. Try the stop across the road.</p>
          <div class="acts"><button id="sop-busClose" type="button">Not now</button></div>
        </div>
      </div>

      <div id="sop-big">
        <div class="box" role="dialog" aria-modal="true" aria-labelledby="sop-bigName">
          <div class="head">
            <p class="name" id="sop-bigName">Map of Padiham</p>
            <button id="sop-bigClose" type="button">Close</button>
          </div>
          <p id="sop-bigText" class="sop-help" role="status"></p>
          <canvas id="sop-bigMap" role="img" aria-label="Map of the town centre. Your place, the next place and the way between them are described in the line above"></canvas>
          <div class="acts">
            <button id="sop-bigIn" type="button">Zoom in</button>
            <button id="sop-bigOut" type="button">Zoom out</button>
            <button id="sop-bigMe" type="button">Find me</button>
          </div>
          <ul class="key" aria-label="Key">
            <li><i class="you"></i>You</li>
            <li><i class="next"></i>Next place</li>
            <li><i class="way"></i>Your way</li>
            <li><i class="stop"></i>Bus stop</li>
            <li class="not-practice"><i class="plq"></i>Plaque found</li>
          </ul>
        </div>
      </div>

      <div id="sop-trip">
        <div class="box" role="dialog" aria-modal="true" aria-labelledby="sop-tripName">
          <p class="name" id="sop-tripName">Practise a trip</p>
          <p class="sop-help">Pick where the trip starts and ends, and how. The game then shows one step at a time, with no clock and no score. It is for getting to know a journey. It does not teach road safety: the game has no traffic.</p>
          <label class="lab" for="sop-tripFrom">From</label>
          <select id="sop-tripFrom"></select>
          <label class="lab" for="sop-tripTo">To</label>
          <select id="sop-tripTo"></select>
          <p class="lab" id="sop-tripHow">How</p>
          <div id="sop-tripWays" role="radiogroup" aria-labelledby="sop-tripHow"></div>
          <div class="acts">
            <button id="sop-tripGo" type="button">Start this trip</button>
            <button id="sop-tripCopy" type="button">Copy the link</button>
            <button id="sop-tripClose" type="button">Close</button>
          </div>
          <p id="sop-tripNote" class="sop-help" role="status"></p>
          <input id="sop-tripLink" type="text" readonly hidden aria-label="Trip link" />
          <p class="sop-help">The link holds the two places and the bus, as short codes, and nothing else. It sits after the # in the address, a part that browsers do not send to the website.</p>
        </div>
      </div>

      <div id="sop-menu">
        <div class="box" role="dialog" aria-modal="true" aria-label="Game menu">
          <p class="name">Paused</p>
          <div class="acts">
            <button id="sop-resume" type="button">Carry on</button>
            <button id="sop-modeBtn" type="button" class="not-practice">Take jobs</button>
            <button id="sop-mapBtn" type="button">Map</button>
            <button id="sop-daily" type="button">Today's job</button>
            <button id="sop-dailyShare" type="button" hidden>Share today's result</button>
            <button id="sop-card" type="button">Take a postcard</button>
            <button id="sop-share" type="button">Share my score</button>
            <button id="sop-mute" type="button">Sound is on</button>
            <button id="sop-full" type="button">Full screen</button>
            <button id="sop-tripBtn" type="button">Practise a trip</button>
            <button id="sop-leave" type="button" class="only-practice">Back to the main game</button>
            <button id="sop-newGame" type="button" class="not-practice">Start a new game</button>
          </div>
          <p id="sop-menuNote" role="status"></p>
          <p id="sop-last"></p>
          <h3>How you look</h3>
          <div id="sop-lookSlot"></div>
          <h3>Settings</h3>
          <div id="sop-setSlot"></div>
          <div id="sop-routeMaker">
            <h3>Make a practice route</h3>
            <p class="sop-help">For a parent, teacher or travel trainer. Walk the route in the game. At the start, and at each turning point, open this menu and add the spot. The link you copy holds the spots and nothing else.</p>
            <div class="acts">
              <button id="sop-routeAdd" type="button">Add where I am standing</button>
              <button id="sop-routeClear" type="button">Start again</button>
              <button id="sop-routeCopy" type="button" disabled>Copy the link</button>
            </div>
            <p id="sop-routeNote" class="sop-help" role="status"></p>
            <input id="sop-routeLink" type="text" readonly hidden aria-label="Practice route link" />
          </div>
          <div id="sop-extras">
          <h3>Stamps: <span id="sop-scount"></span></h3>
          <p id="sop-tally"></p>
          <ul id="sop-stamps" class="sop-stamps"></ul>
          <h3>Plaques found: <span id="sop-jcount"></span></h3>
          <ul id="sop-journal"></ul>
          </div>
          <p class="sop-credit">
            Map data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors,
            Open Database Licence. Contains OS data © Crown copyright and database right 2026.
            Ground heights: © Environment Agency copyright and/or database right 2022. All rights reserved.
            <a href="#disclaimer">Disclaimer and removal requests</a>.
          </p>
        </div>
      </div>

      <div id="sop-start">
        <div class="box" role="dialog" aria-label="Start The Padiham Job">
          <p class="name">The <span>Padiham</span> Job</p>
          <p class="not-practice lead">The real streets of Padiham. Pick how to play.</p>
          <p class="only-practice">A practice trip has been set for you. Follow the markers one at a time. There is no clock and no score, and you can do it as many times as you like.</p>
          <ol id="sop-plan" class="only-practice" aria-label="Your trip, step by step"></ol>
          <p class="only-practice sop-warn">This is for getting to know a route. It does not teach road safety: the game has no traffic. On real roads, stop and cross the way you have been taught.</p>
          <button id="sop-play" type="button" disabled>Loading</button>
          <div id="sop-modes">
            <button id="sop-modeExplore" class="mode" type="button" disabled><b>Explore</b><span>Wander the town. Find the plaques, pick up litter, say hello. No clock.</span></button>
            <button id="sop-modeJobs" class="mode" type="button" disabled><b>Jobs</b><span>Deliveries around town, one after another.</span></button>
            <div class="jobsRow">
              <label><input type="checkbox" data-set="clock" /> Against the clock</label>
              <button id="sop-modeDaily" type="button" disabled>Today's job</button>
            </div>
            <button id="sop-tripOpen" class="mode" type="button" hidden><b>Get somewhere</b><span>Pick a place and practise getting there, on foot or by bus.</span></button>
          </div>
          <details class="sop-set-wrap">
            <summary>Change how you look</summary>
            <div id="sop-look">
              <canvas id="sop-lookPic" width="120" height="150" role="img" aria-label="Your character"></canvas>
              <div id="sop-lookOpts"></div>
            </div>
          </details>
          <details class="sop-set-wrap">
            <summary>Settings and controls</summary>
            <div id="sop-settings" class="sop-set">
              <label><input type="checkbox" data-set="calm" /> Calm: fewer people, softer sound, no clock</label>
              <label class="not-practice"><input type="checkbox" data-set="clock" /> Jobs against the clock, with a bonus for being quick</label>
              <label><input type="checkbox" data-set="reduce" /> Less movement on screen</label>
              <label><input type="checkbox" data-set="contrast" /> Stronger contrast on the panels</label>
              <label><input type="checkbox" data-set="hold" /> Messages stay until I close them</label>
              <label><input type="checkbox" data-set="follow" /> Camera turns to follow me</label>
              <label class="only-touch"><input type="checkbox" data-set="lefty" /> Thumbstick on the right</label>
              <div class="row" role="group" aria-label="Text size">
                <span>Text size</span>
                <button type="button" data-text="0">Standard</button>
                <button type="button" data-text="1">Large</button>
                <button type="button" data-text="2">Largest</button>
              </div>
            </div>
            <ul>
              <li class="only-keys"><b>Move:</b> W A S D or the arrow keys</li>
              <li class="only-keys"><b>Pace:</b> press R to change between walk, run and sprint. Hold Shift to go one faster</li>
              <li class="only-keys"><b>Jump and wave:</b> Space to jump, or for a wheelie or a spin in a chair. H to say hello to someone nearby</li>
              <li class="only-keys"><b>Look around:</b> click and drag, or press Q and E to turn</li>
              <li class="only-keys"><b>Where next:</b> press G to be told the way, or M for the map</li>
              <li class="only-touch"><b>Move:</b> put a thumb down on the lower left and push. The thumbstick comes to your thumb</li>
              <li class="only-touch"><b>Pace:</b> tap WALK to change to run, then sprint</li>
              <li class="only-touch"><b>Jump and wave:</b> tap JUMP (WHEELIE or SPIN in a chair), or HI to say hello to someone nearby</li>
              <li class="only-touch"><b>Look around:</b> drag anywhere else on the screen</li>
              <li><b>Buses:</b> stand at a bus stop and choose Bus stop<span class="only-keys">, or press B</span>. Ring the bell before your stop</li>
              <li class="not-practice"><b>Pubs:</b> step on a blue ring to go inside</li>
              <li class="not-practice"><b>History:</b> walk up to a blue plaque to read it. The menu keeps the ones you have found</li>
              <li class="not-practice"><b>Litter:</b> walk over any you see to pick it up. The menu keeps your stamps</li>
              <li><b>The way:</b> the arrow and the yellow line on the map follow the streets to the next place<span class="only-touch">. Tap the small map to open the full one</span></li>
              <li class="only-keys"><b>Pause:</b> press Esc or click Menu</li>
              <li class="only-touch"><b>Pause:</b> tap Menu</li>
            </ul>
          </details>
          <p class="sop-credit">
            Map data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors,
            Open Database Licence. Contains OS data © Crown copyright and database right 2026.
            Ground heights: © Environment Agency copyright and/or database right 2022. All rights reserved.
            <a href="#disclaimer">Disclaimer and removal requests</a>.
          </p>
        </div>
      </div>
    </div>

    <div class="sop-notes">
      <h2>About the game</h2>
      <p class="sop-proto" role="note"><strong>Prototype.</strong> {PROTOTYPE_NOTICE}</p>
      <p>
        A game set on the real streets of Padiham town centre. Explore, take jobs around town, or practise getting
        somewhere on foot or by bus. It is free, it runs in your browser and it is still being built.
      </p>
      <p>
        The streets, the river, the building outlines and the named pubs, shops and landmarks are real. The jobs are
        made up for fun, the plain shop fronts carry made-up trades, and nothing here is endorsed by any business
        shown. The people behind the bars are not real people. The figure taking a selfie outside the Town Hall is a
        light-hearted caricature of the town's MP. You choose how your own character looks, and some of the people you
        pass wear claret and blue with the number ten of Andy Payton, the Padiham Predator.
      </p>
      <p>
        Your progress is kept in your own browser. The game asks for no name or account and has no chat.
      </p>
      <h2>Local history in the game</h2>
      <p>The blue plaques around the town each carry one fact. These are the plaques and where each fact comes from.</p>
      <ul class="sop-history">
        {PLAQUES.map((p) => (
          <li>
            <strong>{p.title}.</strong> {p.text} <span class="src">Source: {p.url ? <a href={p.url}>{p.source}</a> : p.source}.</span>
          </li>
        ))}
      </ul>
      <h2>Sources</h2>
      <p>
        Map data © OpenStreetMap contributors, Open Database Licence. Building outlines contain OS data © Crown
        copyright and database right 2026 (OS OpenMap Local, Open Government Licence). The hills and the building
        heights come from the Environment Agency's LIDAR Composite, 1 metre terrain and surface models (Open
        Government Licence): © Environment Agency copyright and/or database right 2022. All rights reserved. Building details were read
        from photographs published on Geograph and Wikimedia Commons under Creative Commons licences, and from
        photographs of the Starkie Arms and the Flying Dutchman. The business centre and the black shop front on
        Burnley Road, the white horse, the Bridge Inn, the leisure centre on Park Road and the corner of Church
        Street and Alma Street follow reference pictures the site owner supplied. They were placed, and some
        businesses named, using the Food Standards Agency's food hygiene register (Open Government Licence, read
        11 November 2026). No photograph is reproduced in the game.
      </p>
      <h2 id="todo">Things to do</h2>
      <p>
        Jobs pay, and every third delivery is a good turn for a neighbour that pays nothing but thanks. Litter lies
        on the pavements: walk over it to pick it up. Say hello and the nearest passer-by waves back. You can walk,
        run or sprint, and jump for the fun of it. The menu keeps a set of stamps for what you have done, and
        counts how far you have gone. None of it leaves your browser.
      </p>
      <p>
        You choose how your character gets about: on foot, in a wheelchair or in a powerchair. It changes how
        you look and nothing else. Every pace, place and job is the same, some of the people you pass use
        wheelchairs too, and the jump button becomes a wheelie or a turn on the spot. The two chairs were drawn
        without advice from a wheelchair user. If something about them is wrong, please
        <a href="/contact/">say so</a> and it will be changed.
      </p>
      <h2 id="buses">Catching a bus</h2>
      <p>
        Most of the bus stops in the town centre work. Each one that works has a tall blue sign, a blue circle on
        the ground and its name above it. Stand at one and choose Bus stop. A stop near the edge of
        the map, where no bus goes on to another stop in the game, is there to look at and offers nothing. You are shown the buses that call
        there, each with its number and where it is going. Pick one, wait, and it comes. The driver says hello and
        you choose what to say back: show your pass or ask for a single. Either is fine. On the bus the game tells
        you the next stop, and you ring the bell before the one you want. If you do not ring, the bus carries on
        to its last stop on the map.
      </p>
      <p>
        The stops, the numbers and the order of the stops come from OpenStreetMap and may be out of date. The game
        shows no times and no fares, and the bus is a plain white one, not any company's. It is for getting to
        know the steps of a bus journey. For a real journey, check the timetable. There is no other traffic in the
        game.
      </p>
      <h2 id="daily">Today's job</h2>
      <p>
        The menu has a job that changes each day and is the same three stops for everyone, starting outside the
        Town Hall. When you finish, the menu offers a short result to share: the date, three coloured squares and
        your time, with nothing about the route. It is a first version. Nothing is sent anywhere unless you choose
        to share it, and in the calm setting it has no clock.
      </p>
      <h2 id="options">Quieter and plainer versions</h2>
      <p>
        Two links change how the game starts. Nothing is saved or sent by either.
        <a href="?calm=1">The calm version</a> has fewer people on the streets, softer sound and no clock on the jobs.
        Calm can also be switched on and off in the game's own settings.
        <a href="?edition=clean">The plain version</a> leaves out the selfie taker and keeps the pub doors shut.
        <a href="?calm=1&amp;edition=clean">Both together</a> also works.
      </p>
      <h2 id="practice">Practice routes</h2>
      <p>
        A parent, teacher or travel trainer can set a route for someone to walk in the game before they walk it
        for real. Walk the route yourself, and at the start and at each turning point open the menu and choose
        Add where I am standing. Then copy the link and pass it on. Whoever opens it starts at the first spot and
        is shown one marker at a time, in the same order every time, with no clock, no score, no pubs and
        nothing else going on. A route can include a bus: add a spot at the stop where they get on and another
        near the stop where they get off. The game counts how many times the route has been walked and keeps that count
        in the browser it was played in.
      </p>
      <p>
        You can also set a trip without walking it first. Choose Practise a trip on the start screen or in the
        menu, pick where it starts and ends from the named places and bus stops, and choose whether part of it
        is by bus. The game lists the steps before it starts, then shows them one at a time. It is a first
        version: the way is shown as a straight line and an arrow, not yet along the streets.
      </p>
      <p>
        The link holds the spots on the map, or the short codes for the places and the bus, and nothing else: no name and no words. It sits after the # in the
        address, a part that browsers do not send to the website. The game covers the town
        centre only. It is for getting to know a route, as preparation for a walk with someone, and it does not
        teach road safety: there is no traffic in the game. It has not been tried with learners yet. If you use
        it, please <a href="/contact/">say how it went</a>.
        <a href="/news/the-padiham-job-what-it-does-and-who-it-could-help/">What the game does and who it could help</a>
        says more.
      </p>
      <h2 id="access">Playing with a disability</h2>
      <p>
        The start screen and the menu both have settings for comfort and access: a calm town with no clock, less
        movement on screen, larger text, stronger contrast, messages that stay until you close them, and a camera
        that stays where you put it. Your choices are kept in your own browser. If your device is set to reduce
        motion or to increase contrast, the game starts that way.
      </p>
      <p>
        The whole game can be played from the keyboard: W A S D or the arrow keys to move, Q and E to turn the view,
        Page Up and Page Down to tilt it, R to change pace between walk, run and sprint, Space to jump, H to say hello,
        B at a bus stop to catch a bus and B again on the bus to ring the bell,
        G to be told the way to the next place, Esc for the menu and Enter to close a message. A game controller should also work, though it has not yet been
        tested on one. The way to the next place is given in words as well as by the arrow, and a screen reader will
        read it out along with the messages and the plaques.
      </p>
      <p>
        What does not work yet: the game cannot be played by sound alone, the keys cannot be changed, and there is no
        one-button or eye-gaze way to play. If something gets in your way, please <a href="/contact/">say so</a>. It
        will be read and it will shape what is built next.
      </p>
      <h2 id="disclaimer">Disclaimer and removal requests</h2>
      <p>
        {PROTOTYPE_NOTICE}
      </p>
      <p>
        The Padiham Job is a free game made for fun. It is not a commercial product and it carries no advertising.
        It is a simplified model of the town, not an accurate map, and it should not be relied on for directions,
        opening times or anything else. The jobs, the deliveries and the things people say in the game are made up.
      </p>
      <p>
        The names of pubs, shops, clubs, churches and other places come from OpenStreetMap, a public map, and from
        the Food Standards Agency's public food hygiene register, and are shown only so that the town is
        recognisable. No hygiene rating is shown or implied. No business or organisation shown has sponsored, endorsed or
        approved the game, and nothing in it is a statement about any of them, their staff or their customers. All
        names and trade marks belong to their owners. Andy Payton and Burnley Football Club have no connection with
        the game and have not endorsed it.
      </p>
      <p>
        If you own or run a business or premises shown here and would like it renamed, changed or taken out, or if
        you have spotted a mistake, please <a href="/contact/">get in touch</a>. Removal requests from the owner or
        operator of a business will be honoured, with no reason needed, as soon as it can be done.
      </p>
    </div>
  </section>
</Layout>

<script>
  import '../../games/padiham/game.js';
</script>

<style is:global>
  .sop-page { max-width: 1180px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  .sop-intro h1 { margin: 0 0 0.5rem; font-size: 1.6rem; line-height: 1.2; }
  .sop-notes { max-width: 68ch; margin-top: 2rem; }

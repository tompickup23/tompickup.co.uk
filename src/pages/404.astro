---
/* GitHub Pages serves dist/404.html, with a 404 status, for any URL that does not
   exist. Without this page it showed GitHub's own. Old /lancs/ and /doge/ links
   land here too, which is intended: those sections are parked.

   The page is one file for every wrong address, so it cannot know at build time
   what was asked for. The shared NotFound component (vendored base layer) reads
   the address in the browser, shows it back, names the closest pages that do
   exist and says what happened to the two retired sections. Without script the
   reader still has the sentence and the main links. */
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import NotFound from '../vendor/estate-kit/base/NotFound.astro';
import { ALL_PROJECTS } from '../data/projects';

const posts = await getCollection('news', ({ data }) => !data.draft);
const pages = [
  { url: '/', title: 'Home' },
  { url: '/news/', title: 'News and investigations' },
  { url: '/news/public-debates/', title: 'Public debates' },
  { url: '/lgr/', title: 'Local government reorganisation in Lancashire' },
  { url: '/burnley-economy/', title: 'Burnley economy' },
  { url: '/lcc-budget-game/', title: 'Lancashire County Council budget game' },
  { url: '/burnley-budget-game/', title: 'Burnley Borough Council budget game' },
  { url: '/projects/', title: 'Projects' },
  { url: '/about/', title: 'About Tom Pickup' },
  { url: '/contact/', title: 'Contact' },
  { url: '/press/', title: 'Press' },
  { url: '/studies/', title: 'Studies and papers' },
  { url: '/stocks-massey/', title: 'The Stocks Massey Bequest' },
  { url: '/updates/', title: 'Updates by email' },
  ...posts.map((post) => ({ url: `/news/${post.id}/`, title: post.data.title })),
];

const retired = [
  {
    prefix: '/lancs',
    message: 'The Lancashire Business Observatory was retired from this site in September 2026.',
  },
  {
    prefix: '/doge',
    message: 'The Burnley spending explorer was retired from this site in September 2026. The same payments, checked against the council\'s files, are on AI DOGE.',
    href: 'https://aidoge.co.uk/councils/burnley/',
    label: 'Burnley on AI DOGE',
  },
];
---

<Layout
  title="Page not found | Tom Pickup"
  description="This page does not exist on tompickup.co.uk. Try the news, projects or about pages."
>
  <div class="container-narrow not-found">
    <NotFound
      pages={pages}
      retired={retired}
      links={[
        { href: '/', label: 'Home' },
        { href: '/news/', label: 'News and investigations', note: `${posts.length} articles` },
        { href: '/projects/', label: 'Projects', note: `${ALL_PROJECTS.length} projects` },
        { href: '/about/', label: 'About' },
        { href: '/contact/', label: 'Contact' },
      ]}
    >
      It may have moved, or the link may be wrong.
    </NotFound>
  </div>
</Layout>

<style>
  .not-found {
    padding-top: 2rem;
  }
</style>

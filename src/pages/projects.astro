---
import Layout from '../layouts/Layout.astro';
import { ON_THIS_SITE, DATA_PROJECTS } from '../data/projects';

// One hub instead of several nav slots. Every project keeps its URL; this page
// is where they are found, labelled in plain English by what a visitor wants
// rather than by project codename.
//
// Two groups, because they are two different things. The first is councillor
// work published here. The second is separate publications on their own
// domains, each with its own method and corrections route, and a visitor
// clicking one is leaving this site.
//
// The list itself lives in src/data/projects.ts so the footer column and this
// page cannot drift apart.
const GROUPS = [
  {
    heading: 'On this site',
    blurb: 'Built as part of the council work, and published here.',
    items: ON_THIS_SITE,
  },
  {
    heading: 'The data projects',
    blurb:
      'Separate publications, each on its own site. Each one states its sources and carries a route to correct it.',
    items: DATA_PROJECTS,
  },
];
---

<Layout
  title="Projects | Tom Pickup"
  description="The tools and investigations: Lancashire's new councils modelled, council spending traced line by line, plus AI DOGE, UK Demographics, UK Elections and Asylum Stats."
>
  <section class="projects-page">
    <div class="container">
      <h1>Projects</h1>
      <p class="projects-intro">
        The tools and investigations behind the numbers I publish. Everything here is
        built from documents you can check.
      </p>

      {GROUPS.map((group) => (
        <section class="projects-group">
          <h2 class="group-heading">{group.heading}</h2>
          <p class="group-blurb">{group.blurb}</p>

          <div class="projects-grid">
            {group.items.map((p) => (
              <a
                href={p.href}
                class="project-card"
                style={`--card-accent:${p.accent}`}
                target={p.external ? '_blank' : undefined}
                rel={p.external ? 'noopener noreferrer' : undefined}
              >
                <h3 class="project-title">
                  {p.title}
                  {p.external && <span class="ext" aria-hidden="true"> &#8599;</span>}
                </h3>
                <p class="project-desc">{p.desc}</p>
                <span class="project-meta">{p.meta}</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</Layout>

<style>
  .projects-page {
    padding: 7rem 0 var(--space-2xl);
  }

  .projects-page h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-sm);
  }

  .projects-intro {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-2xl);
    max-width: 560px;
  }

  .projects-group + .projects-group {
    margin-top: var(--space-2xl);
  }

  .group-heading {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary, #8e8e93);
    margin: 0 0 var(--space-2xs, 0.25rem);
  }

  .group-blurb {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0 0 var(--space-md);
    max-width: 560px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg);
    background: var(--bg-secondary, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--separator);
    border-left: 3px solid var(--card-accent);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--card-accent);
    transform: translateY(-2px);
  }

  .project-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }

  .ext {
    color: var(--text-tertiary);
    font-size: 0.9em;
  }

  .project-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0;
    flex-grow: 1;
    line-height: 1.6;
  }

  .project-meta {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--card-accent);
  }

  @media (max-width: 768px) {
    .projects-page {
      padding: 6rem 0 var(--space-xl);
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

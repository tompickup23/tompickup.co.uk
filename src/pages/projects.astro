---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { Image } from 'astro:assets';
import { articleImage } from '../lib/images';
import { newsArea, newsTopic } from '../lib/news-categories';
import { ALL_PROJECTS, PROJECT_GROUPS, PROJECT_DETAILS, LOCAL_READING } from '../data/projects';

const posts = await getCollection('news', ({ data }) => !data.draft);
const groupedProjects = PROJECT_GROUPS.flatMap(group => group.projects);
if (groupedProjects.length !== ALL_PROJECTS.length || new Set(groupedProjects).size !== ALL_PROJECTS.length) {
  throw new Error('Each portfolio project must appear in exactly one category.');
}
const postMap = new Map(posts.map(post => [post.id, post]));
// A removed or unpublished article must not leave a dead link in the portfolio.
const readingSlugs = [
  ...Object.values(LOCAL_READING).flat(),
  ...Object.values(PROJECT_DETAILS).flatMap(detail => detail.article ? [detail.article.slug] : []),
];
for (const slug of readingSlugs) {
  if (!postMap.has(slug)) throw new Error(`Portfolio article is not published: ${slug}`);
}
for (const [area, slugs] of Object.entries(LOCAL_READING)) {
  for (const slug of slugs) {
    if (newsArea(postMap.get(slug)!) !== area) throw new Error(`Portfolio article is in the wrong area: ${slug}`);
  }
}
const description = 'Explore Tom Pickup’s data projects, everyday tools and Lancashire council work, with the investigations and explainers behind them.';
const schema = {
  '@type': 'CollectionPage', '@id': 'https://tompickup.co.uk/projects/',
  url: 'https://tompickup.co.uk/projects/', name: 'Projects | Tom Pickup', description,
  mainEntity: {
    '@type': 'ItemList', numberOfItems: ALL_PROJECTS.length,
    itemListElement: ALL_PROJECTS.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title, url: new URL(p.href, 'https://tompickup.co.uk').href })),
  },
};
---

<Layout title="Projects | Tom Pickup" description={description} schema={schema}>
  <div class="portfolio">
    <header class="portfolio-hero">
      <div class="hero-copy">
        <p class="eyebrow"><span class="small-rule"></span> Projects by Tom Pickup</p>
        <h1>Public records.<br /><span>Practical tools.</span></h1>
        <p class="hero-intro">I build websites that make public information easier to find, understand and use. Explore the projects, or read the investigations behind them.</p>
        <a href="#public-data" class="hero-link">Explore the projects <span aria-hidden="true">↓</span></a>
      </div>
      <nav class="portfolio-index" aria-label="On this page">
        <div class="index-heading"><span>Explore the collection</span><span>{ALL_PROJECTS.length} projects</span></div>
        {PROJECT_GROUPS.map((group, i) => <a href={`#${group.id}`}>
          <span class="index-number">0{i + 1}</span><span>{group.shortTitle}</span><span class="index-count">{group.projects.length}</span><span aria-hidden="true">↘</span>
        </a>)}
        <p>Independent data publications, local tools and selected writing, in one place.</p>
      </nav>
    </header>

    <div class="portfolio-body">
      {PROJECT_GROUPS.map((group, i) => <section class="project-section" id={group.id} aria-labelledby={`${group.id}-title`}>
        <header class="portfolio-section-heading">
          <div class="section-kicker"><span>0{i + 1}</span><span>{group.projects.length} {group.projects.length === 1 ? 'project' : 'projects'}{LOCAL_READING[group.id] ? ' & selected writing' : ''}</span></div>
          <h2 id={`${group.id}-title`}>{group.title}</h2>
          <p>{group.description}</p>
        </header>
        <div class:list={['group-content', { 'local-layout': LOCAL_READING[group.id] }]}>
          <ul class="project-grid">
            {group.projects.map(project => <li><ProjectCard project={project} /></li>)}
          </ul>
          {LOCAL_READING[group.id] && <aside class="local-reading" aria-label={`${group.title} news and investigations`}>
            <div class="local-reading-heading"><h3>News &amp; investigations</h3><a href={`/news/#${group.id}`}>All {group.title} articles <span aria-hidden="true">↗</span></a></div>
            {LOCAL_READING[group.id].map(slug => {
              const post = postMap.get(slug)!;
              return <article class="local-story">
                <a href={`/news/${post.id}/`}>
                  {articleImage(post.data.image)
                    ? <Image src={articleImage(post.data.image)!} alt="" width={164} densities={[1]} format="webp" quality={70} loading="lazy" decoding="async" />
                    : post.data.image && <img src={post.data.image} alt="" width="104" height="90" loading="lazy" decoding="async" />}
                  <div><p class="reading-topic">{newsTopic(post).title}</p><h4>{post.data.title}</h4></div>
                  <span class="story-arrow" aria-hidden="true">→</span>
                </a>
                {post.data.imageCredit && <p class="image-credit">{post.data.imageCredit}</p>}
              </article>;
            })}
          </aside>}
        </div>
      </section>)}

      <aside class="more-work" aria-label="More on this site">
        <div><p class="eyebrow">Keep exploring</p><h2>More about the work.</h2></div>
        <div class="more-links"><a href="/news/">All news &amp; investigations <span aria-hidden="true">→</span></a><a href="/about/">About me <span aria-hidden="true">→</span></a><a href="/updates/">Subscribe for updates <span aria-hidden="true">→</span></a><a href="/contact/">Get in touch <span aria-hidden="true">→</span></a></div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .portfolio { max-width: 1200px; margin: 0 auto; padding: 32px var(--gutter) 20px; color: var(--ink); }
  .portfolio-hero { display: grid; grid-template-columns: 1.4fr 1fr; gap: 72px; align-items: end; padding: 36px 0 56px; border-bottom: 1px solid var(--line); }
  .eyebrow { display: flex; align-items: center; gap: 12px; color: var(--teal); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8125rem; font-weight: 600; }
  .small-rule { width: 28px; height: 2px; background: var(--gold); }
  h1 { font-size: clamp(2.5rem, 5.4vw, 4.25rem); line-height: 1.06; margin: 18px 0; text-wrap: initial; }
  h1 > span { color: var(--muted); }
  .hero-intro { color: var(--muted); font-size: 1.125rem; line-height: 1.65; max-width: 48ch; }
  .hero-link { display: inline-flex; align-items: center; gap: 24px; min-height: var(--touch); margin-top: 20px; font-size: 1rem; font-weight: 600; color: var(--ink); text-decoration: none; border-bottom: 2px solid var(--teal); }
  .hero-link span { color: var(--teal); }
  .portfolio-index { padding: 22px 24px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); }
  .index-heading { display: flex; justify-content: space-between; gap: 10px; color: var(--muted); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; padding-bottom: 14px; }
  .portfolio-index > a { display: grid; grid-template-columns: 26px 1fr 20px 12px; align-items: center; gap: 12px; min-height: var(--touch); padding: 8px 0; border-top: 1px solid var(--line); color: var(--ink); font-size: 1rem; text-decoration: none; }
  .portfolio-index > a:hover { color: var(--teal); }
  .index-number, .index-count { color: var(--muted); font-size: 0.875rem; font-variant-numeric: tabular-nums; }
  .portfolio-index > p { margin-top: 12px; color: var(--muted); font-size: 0.9375rem; line-height: 1.55; max-width: 38ch; }
  .project-section { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 48px; padding: 52px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 80px; }
  .portfolio-section-heading { padding-top: 4px; }
  .section-kicker { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; color: var(--muted); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .section-kicker > span:first-child { color: var(--gold); border-right: 1px solid var(--line-strong); padding-right: 12px; }
  .portfolio-section-heading h2 { font-size: 1.75rem; line-height: 1.15; margin-bottom: 12px; }
  .portfolio-section-heading > p { color: var(--muted); font-size: 1rem; line-height: 1.6; max-width: 30ch; }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
  .project-grid > li { min-width: 0; }
  .group-content { min-width: 0; }
  .local-layout { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .local-layout .project-grid { grid-template-columns: 1fr; }
  .local-reading { min-width: 0; }
  .local-reading-heading { padding: 4px 0 14px; border-bottom: 2px solid var(--ink); }
  .local-reading-heading h3 { font-size: 1.25rem; margin-bottom: 4px; }
  .local-reading-heading > a { color: var(--teal); font-size: 0.9375rem; font-weight: 600; }
  .local-story { padding: 16px 0; border-bottom: 1px solid var(--line); }
  .local-story > a { display: grid; grid-template-columns: 82px minmax(0, 1fr) 14px; gap: 14px; align-items: start; color: var(--ink); text-decoration: none; }
  .local-story > a:hover h4 { color: var(--teal); text-decoration: underline; }
  .local-story :global(img) { width: 82px; height: 82px; object-fit: cover; border-radius: var(--radius-sm); }
  .local-story h4 { font-family: var(--font-sans); font-size: 1.0625rem; font-weight: 600; line-height: 1.4; letter-spacing: 0; text-wrap: initial; }
  .reading-topic { color: var(--teal); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 4px; }
  .story-arrow { color: var(--teal); }
  .image-credit { color: var(--muted); font-size: 0.8125rem; line-height: 1.45; margin-top: 6px; }
  .more-work { display: flex; justify-content: space-between; align-items: center; gap: 40px; padding: 28px 0; border-top: 1px solid var(--line); }
  .more-work h2 { font-size: 1.5rem; margin-top: 8px; }
  .more-links { display: flex; flex-wrap: wrap; gap: 4px 24px; }
  .more-links a { display: flex; align-items: center; gap: 12px; min-height: var(--touch); color: var(--teal); font-size: 1rem; font-weight: 600; }
  @media (max-width: 1050px) { .portfolio-hero { gap: 35px; } .project-section { grid-template-columns: 205px minmax(0, 1fr); gap: 25px; } }
  @media (max-width: 850px) { .portfolio { padding-top: 20px; } .portfolio-hero { grid-template-columns: 1fr; gap: 32px; padding-bottom: 40px; } .project-section { grid-template-columns: 1fr; gap: 20px; padding: 36px 0; } .portfolio-section-heading > p { max-width: 60ch; } .more-work { align-items: start; flex-direction: column; gap: 14px; } }
  @media (max-width: 600px) { .portfolio-hero { padding-top: 20px; } h1 { font-size: clamp(2.375rem, 10vw, 3.25rem); } .hero-intro { font-size: 1.0625rem; } .portfolio-index { padding: 18px; } .project-grid, .local-layout { grid-template-columns: 1fr; } .more-links { flex-direction: column; width: 100%; gap: 0; } .more-links a { justify-content: space-between; border-bottom: 1px solid var(--line); } }
</style>

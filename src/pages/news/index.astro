---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';
import { groupNews } from '../../lib/news-categories';

const posts = await getCollection('news', ({ data }) => !data.draft);
const areas = groupNews(posts);
const orderedPosts = areas.flatMap(area => area.topics.flatMap(topic => topic.posts));
const description = 'News and investigations by Tom Pickup, organised by Burnley, Lancashire and national issues, from public spending and housing to health and policing.';
const schema = {
  '@type': 'CollectionPage', '@id': 'https://tompickup.co.uk/news/',
  url: 'https://tompickup.co.uk/news/', name: 'News & investigations', description,
  inLanguage: 'en-GB', isPartOf: { '@id': 'https://tompickup.co.uk/#website' },
  mainEntity: {
    '@type': 'ItemList', itemListOrder: 'https://schema.org/ItemListUnordered',
    numberOfItems: orderedPosts.length,
    itemListElement: orderedPosts.map((post, i) => ({
      '@type': 'ListItem', position: i + 1,
      url: `https://tompickup.co.uk/news/${post.id}/`, name: post.data.title,
    })),
  },
};
---

<Layout title="News & investigations | Tom Pickup" description={description} schema={schema}>
  <div class="news-page">
    <header class="news-header">
      <p class="news-eyebrow">Reporting by Tom Pickup</p>
      <h1>News &amp; investigations.</h1>
      <p>Start with a place, then explore the issues. Public records, local decisions and the stories behind them.</p>
    </header>

    <nav class="area-nav" aria-label="Browse news by area">
      {areas.map((area, i) => <a href={`#${area.id}`}>
        <span class="area-number">0{i + 1}</span>
        <span><strong>{area.title}</strong><small>{area.count} articles</small></span>
        <span class="area-arrow" aria-hidden="true">↘</span>
      </a>)}
    </nav>

    {areas.map((area, i) => <section class="news-area" id={area.id} aria-labelledby={`${area.id}-title`}>
      <header class="area-heading">
        <div><p class="news-eyebrow">0{i + 1} / {area.count} articles</p><h2 id={`${area.id}-title`}>{area.title}</h2><p>{area.description}</p></div>
        <a href="#main" class="back-top">Back to areas <span aria-hidden="true">↑</span></a>
      </header>
      <nav class="topic-nav" aria-label={`${area.title} topics`}>
        {area.topics.map(topic => <a href={`#${area.id}-${topic.id}`}>{topic.title}<span>{topic.posts.length}</span></a>)}
      </nav>
      {area.topics.map(topic => <section class="topic-section" id={`${area.id}-${topic.id}`} aria-labelledby={`${area.id}-${topic.id}-title`}>
        <header class="topic-heading"><h3 id={`${area.id}-${topic.id}-title`}>{topic.title}</h3><span>{topic.posts.length} {topic.posts.length === 1 ? 'article' : 'articles'}</span></header>
        <div class="posts-grid">
          {topic.posts.map(post => <NewsCard
            title={post.data.title}
            date={post.data.date.toISOString()}
            description={post.data.description}
            slug={post.id}
            image={post.data.image}
            headingLevel="h4"
          />)}
        </div>
      </section>)}
    </section>)}

    {posts.length === 0 && <p class="empty-state">No articles published yet.</p>}
    <div class="news-footer"><a href="/projects/">Explore the projects <span aria-hidden="true">→</span></a><a href="/rss.xml">Subscribe via RSS <span aria-hidden="true">↗</span></a></div>
  </div>
</Layout>

<style>
  .news-page { max-width: 1200px; margin: 0 auto; padding: 70px 32px 30px; color: #f2f1ed; }
  .news-page a { background-image: none; }
  .news-page a:focus-visible { outline: 2px solid #85d6e1; outline-offset: 5px; }
  .news-header { margin-bottom: 36px; }
  .news-eyebrow { font-size: .67rem; letter-spacing: .13em; text-transform: uppercase; color: #9fbdc5; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.8rem); letter-spacing: -.055em; font-weight: 600; margin: 18px 0; }
  .news-header > p:last-child { color: #b0bac2; font-size: 1rem; max-width: 59ch; }
  .area-nav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; padding-bottom: 48px; border-bottom: 1px solid #2a2e32; }
  .area-nav > a { display: flex; align-items: center; gap: 18px; padding: 23px; border: 1px solid #30383d; border-radius: 12px; color: #edf1f3; background: #101416; }
  .area-nav > a:hover { border-color: #70a7b3; }
  .area-number { color: #9eb3bc; font-size: .7rem; }
  .area-nav strong { display: block; font-size: 1.1rem; font-weight: 600; }
  .area-nav small { display: block; color: #a9b6be; margin-top: 4px; }
  .area-arrow { color: #91d4df; margin-left: auto; }
  .news-area { padding: 50px 0; border-bottom: 1px solid #2a2e32; scroll-margin-top: 90px; }
  .area-heading { display: flex; justify-content: space-between; gap: 24px; align-items: end; }
  .area-heading h2 { font-size: clamp(2rem, 4vw, 2.7rem); font-weight: 600; margin: 12px 0; letter-spacing: -.045em; }
  .area-heading div > p:last-child { color: #b0bac2; font-size: .9rem; }
  .back-top { font-size: .75rem; white-space: nowrap; color: #a5cbd4; padding: 8px 0; }
  .topic-nav { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 26px; }
  .topic-nav a { display: inline-flex; gap: 12px; align-items: center; padding: 8px 13px; border: 1px solid #39434a; border-radius: 6px; color: #c6d7df; font-size: .75rem; }
  .topic-nav a:hover { border-color: #8bcbd6; background: #152227; }
  .topic-nav span { color: #a5b6bf; font-size: .67rem; }
  .topic-section { padding-top: 35px; scroll-margin-top: 65px; }
  .topic-heading { display: flex; align-items: center; gap: 13px; margin-bottom: 18px; }
  .topic-heading h3 { font-size: 1.08rem; font-weight: 600; }
  .topic-heading > span { font-size: .68rem; color: #a5b6bf; }
  .posts-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .news-footer { display: flex; justify-content: space-between; gap: 24px; padding: 28px 0; }
  .news-footer a { color: #b8d8df; font-size: .85rem; }
  .empty-state { padding: 48px 0; color: #b0bac2; }
  @media (max-width: 900px) { .posts-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .area-nav > a { padding: 20px 16px; gap: 12px; } }
  @media (max-width: 600px) { .news-page { padding: 40px 20px 20px; } .area-nav { grid-template-columns: 1fr; gap: 10px; padding-bottom: 30px; } .area-nav > a { padding: 18px; } .area-nav strong, .area-nav small { display: inline; } .area-nav small { margin-left: 12px; } .news-area { padding: 35px 0; } .area-heading { align-items: start; flex-direction: column; gap: 12px; } .posts-grid { grid-template-columns: 1fr; } .news-footer { flex-wrap: wrap; } }
</style>

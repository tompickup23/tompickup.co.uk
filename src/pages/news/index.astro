---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';
import { groupNews } from '../../lib/news-categories';

const posts = await getCollection('news', ({ data }) => !data.draft);
const areas = groupNews(posts);
const orderedPosts = areas.flatMap(area => area.topics.flatMap(topic => topic.posts));
const description =
  'News and investigations by Tom Pickup on Burnley and Padiham, Lancashire and national issues: public spending, housing, health and policing.';
const schema = {
  '@type': 'CollectionPage', '@id': 'https://tompickup.co.uk/news/',
  url: 'https://tompickup.co.uk/news/', name: 'News & investigations', description,
  inLanguage: 'en-GB', isPartOf: { '@id': 'https://tompickup.co.uk/#website' },
  mainEntity: {
    '@type': 'ItemList', itemListOrder: 'https://schema.org/ItemListUnordered',
    numberOfItems: orderedPosts.length,
    itemListElement: orderedPosts.map((post, i) => ({
      '@type': 'ListItem', position: i + 1,
      url: `https://tompickup.co.uk/news/${post.id}/`, name: post.data.title,
    })),
  },
};
---

<Layout title="News & investigations | Tom Pickup" description={description} schema={schema}>
  <div class="news-page">
    <header class="news-header">
      <p class="news-eyebrow">Reporting by Tom Pickup</p>
      <h1>News &amp; investigations.</h1>
      <p>Start with a place, then explore the issues. Public records, local decisions and the stories behind them.</p>
    </header>

    <nav class="area-nav" aria-label="Browse news by area">
      {areas.map((area, i) => <a href={`#${area.id}`}>
        <span class="area-number">0{i + 1}</span>
        <span><strong>{area.title}</strong><small>{area.count} articles</small></span>
        <span class="area-arrow" aria-hidden="true">↘</span>
      </a>)}
    </nav>

    <a class="debates-link" href="/news/public-debates/"><strong>Public debates</strong><span>Debates, speeches and public appearances <span aria-hidden="true">→</span></span></a>

    {areas.map((area, i) => <section class="news-area" id={area.id} aria-labelledby={`${area.id}-title`}>
      <header class="area-heading">
        <div><p class="news-eyebrow">0{i + 1} / {area.count} articles</p><h2 id={`${area.id}-title`}>{area.title}</h2><p>{area.description}</p></div>
        <a href="#main" class="back-top">Back to areas <span aria-hidden="true">↑</span></a>
      </header>
      <nav class="topic-nav" aria-label={`${area.title} topics`}>
        {area.topics.map(topic => <a href={`#${area.id}-${topic.id}`}>{topic.title}<span>{topic.posts.length}</span></a>)}
      </nav>
      {area.topics.map(topic => <section class="topic-section" id={`${area.id}-${topic.id}`} aria-labelledby={`${area.id}-${topic.id}-title`}>
        <header class="topic-heading"><h3 id={`${area.id}-${topic.id}-title`}>{topic.title}</h3><span>{topic.posts.length} {topic.posts.length === 1 ? 'article' : 'articles'}</span></header>
        <div class="posts-grid">
          {topic.posts.map(post => <NewsCard
            title={post.data.title}
            date={post.data.date.toISOString()}
            description={post.data.description}
            slug={post.id}
            image={post.data.image}
            headingLevel="h4"
          />)}
        </div>
      </section>)}
    </section>)}

    {posts.length === 0 && <p class="empty-state">No articles published yet.</p>}
    <div class="news-footer"><a href="/projects/">Explore the projects <span aria-hidden="true">→</span></a><a href="/rss.xml">Subscribe via RSS <span aria-hidden="true">↗</span></a></div>
  </div>
</Layout>

<style>
  .news-page { max-width: 1200px; margin: 0 auto; padding: 56px var(--gutter) 30px; color: var(--ink); }
  .debates-link { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 4px 24px; padding: 18px 0; border-bottom: 1px solid var(--line); color: var(--teal); font-weight: 600; }
  .debates-link > span { color: var(--muted); font-size: 0.9375rem; font-weight: 400; }
  .news-header { margin-bottom: 32px; }
  .news-eyebrow { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--teal); }
  h1 { font-size: clamp(2.25rem, 5vw, 3.5rem); margin: 12px 0 14px; }
  .news-header > p:last-child { color: var(--muted); font-size: 1.125rem; max-width: 60ch; }
  .area-nav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .area-nav > a { display: flex; align-items: center; gap: 16px; min-height: var(--touch); padding: 18px 20px 18px 0; color: var(--ink); text-decoration: none; }
  .area-nav > a + a { border-left: 1px solid var(--line); padding-left: 20px; }
  .area-nav > a:hover strong { color: var(--teal); text-decoration: underline; }
  .area-number { color: var(--gold); font-size: 0.9375rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .area-nav strong { display: block; font-family: var(--font-display); font-size: 1.3125rem; font-weight: 600; }
  .area-nav small { display: block; color: var(--muted); font-size: 0.9375rem; margin-top: 2px; }
  .area-arrow { color: var(--teal); margin-left: auto; }
  .news-area { padding: 44px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 80px; }
  .area-heading { display: flex; justify-content: space-between; gap: 24px; align-items: end; }
  .area-heading h2 { font-size: clamp(1.875rem, 4vw, 2.5rem); margin: 8px 0; }
  .area-heading div > p:last-child { color: var(--muted); font-size: 1rem; }
  .back-top { display: inline-flex; align-items: center; min-height: var(--touch); font-size: 0.9375rem; white-space: nowrap; color: var(--teal); }
  .topic-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .topic-nav a { display: inline-flex; gap: 10px; align-items: center; min-height: 40px; padding: 0 12px; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); color: var(--ink); font-size: 0.9375rem; text-decoration: none; }
  .topic-nav a:hover { border-color: var(--teal); color: var(--teal); }
  .topic-nav span { color: var(--muted); font-size: 0.875rem; font-variant-numeric: tabular-nums; }
  .topic-section { padding-top: 32px; scroll-margin-top: 72px; }
  .topic-heading { display: flex; align-items: baseline; gap: 12px; margin-bottom: 16px; }
  .topic-heading h3 { font-size: 1.375rem; }
  .topic-heading > span { font-size: 0.9375rem; color: var(--muted); }
  .posts-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 24px; }
  .news-footer { display: flex; justify-content: space-between; gap: 24px; padding: 24px 0; }
  .news-footer a { color: var(--teal); font-size: 1rem; font-weight: 600; }
  .empty-state { padding: 48px 0; color: var(--muted); }
  @media (max-width: 900px) { .posts-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .news-page { padding: 32px var(--gutter) 20px; } .area-nav { grid-template-columns: 1fr; } .area-nav > a, .area-nav > a + a { padding: 14px 0; border-left: 0; } .area-nav > a + a { border-top: 1px solid var(--line); } .news-area { padding: 32px 0; } .area-heading { align-items: start; flex-direction: column; gap: 4px; } .posts-grid { grid-template-columns: 1fr; } .news-footer { flex-wrap: wrap; } }
</style>

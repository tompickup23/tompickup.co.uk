---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';
import { newsTopic } from '../../lib/news-categories';

const posts = (await getCollection('news', ({ data }) => !data.draft))
  .filter(post => newsTopic(post).id === 'public-debates')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title));
const description = 'Public debates, speeches and appearances by Tom Pickup, with event reports, photographs and coverage.';
const schema = {
  '@type': 'CollectionPage', name: 'Public debates', description,
  url: 'https://tompickup.co.uk/news/public-debates/', inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://tompickup.co.uk/#website' },
  mainEntity: {
    '@type': 'ItemList', numberOfItems: posts.length,
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem', position: i + 1,
      name: post.data.title, url: `https://tompickup.co.uk/news/${post.id}/`,
    })),
  },
};
---

<Layout title="Public debates | Tom Pickup" description={description} schema={schema}>
  <div class="debates-page">
    <a class="back-link" href="/news/">← All news</a>
    <header>
      <p class="eyebrow">Debates, speeches &amp; public appearances</p>
      <h1>Public debates.</h1>
      <p class="intro">A record of my contributions to public discussion, with reports, photographs and coverage from the events.</p>
      <p class="scope">From community debates to Lancashire County Council, the Combined Authority and Reform UK events.</p>
    </header>
    <section aria-labelledby="reports-title">
      <div class="section-heading"><h2 id="reports-title">Event reports</h2><span>{posts.length} {posts.length === 1 ? 'article' : 'articles'}</span></div>
      <div class="posts-grid">
        {posts.map(post => <NewsCard
          title={post.data.title} date={post.data.date.toISOString()}
          description={post.data.description} slug={post.id} image={post.data.image}
        />)}
      </div>
    </section>
  </div>
</Layout>

<style>
  .debates-page { max-width: 1200px; margin: 0 auto; padding: 60px 32px 70px; color: #f2f1ed; }
  .back-link { color: #a5cbd4; font-size: .85rem; background-image: none; }
  header { max-width: 760px; margin: 38px 0 44px; }
  .eyebrow { font-size: .7rem; text-transform: uppercase; letter-spacing: .12em; color: #9fbdc5; }
  h1 { font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 600; letter-spacing: -.05em; margin: 16px 0 20px; }
  .intro { color: #d4dde2; font-size: 1.15rem; line-height: 1.7; }
  .scope { color: #aab4bd; font-size: .95rem; margin-top: 16px; }
  .section-heading { display: flex; align-items: baseline; gap: 16px; padding-top: 24px; margin-bottom: 24px; border-top: 1px solid #2a2e32; }
  h2 { font-size: 1.25rem; font-weight: 600; }
  .section-heading span { color: #aab4bd; font-size: .8rem; }
  .posts-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 900px) { .posts-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .debates-page { padding: 35px 20px 45px; } .posts-grid { grid-template-columns: 1fr; } }
</style>

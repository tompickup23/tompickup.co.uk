---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';

const posts = (await getCollection('news', ({ data }) => !data.draft && data.tags.includes('stocks-massey')))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const description = 'A short history of the Edward Stocks Massey Bequest Fund, with articles about its support for Burnley organisations and students.';
const schema = {
  '@type': 'CollectionPage',
  '@id': 'https://tompickup.co.uk/stocks-massey/',
  url: 'https://tompickup.co.uk/stocks-massey/',
  name: 'Stocks Massey: history and awards', description,
  inLanguage: 'en-GB',
  mainEntity: {
    '@type': 'ItemList', numberOfItems: posts.length,
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem', position: i + 1, name: post.data.title,
      url: `https://tompickup.co.uk/news/${post.id}/`,
    })),
  },
};
---

<Layout title="Stocks Massey: history & awards | Tom Pickup" description={description} schema={schema}>
  <div class="bequest-page">
    <a class="back-link" href="/projects/#burnley">← Burnley projects</a>
    <header class="bequest-hero">
      <div>
        <p class="eyebrow">Burnley · History &amp; charitable legacy</p>
        <h1>Stocks Massey<span>A legacy for Burnley.</span></h1>
        <p class="full-name">The Edward Stocks Massey Bequest Fund</p>
        <p class="intro">From a brewer’s bequest to support for the next generation. The story of a local charity sustaining education, music and the arts.</p>
        <p class="chair-role">I chair the <a href="https://council.lancashire.gov.uk/mgOutsideBodyDetails.aspx?ID=589">Edward Stocks Massey Bequest Fund Joint Advisory Committee</a>.</p>
        <nav aria-label="On this page"><a href="#history">A short history <span aria-hidden="true">↓</span></a><a href="#articles">Awards &amp; articles <span aria-hidden="true">↓</span></a></nav>
      </div>
      <aside class="legacy-note" aria-label="The original bequest">
        <span class="eyebrow">The original gift</span>
        <strong>£135,000</strong>
        <p>Left to Burnley in Edward Stocks Massey’s will.</p>
        <span class="legacy-foot">A gift that continues to serve the town.</span>
      </aside>
    </header>

    <section class="history-section" id="history" aria-labelledby="history-title">
      <div class="history-heading"><p class="eyebrow">01 / The beginnings</p><h2 id="history-title">A short history</h2></div>
      <div class="history-copy">
        <p>Edward Stocks Massey was born in Brierfield in 1850. He made his fortune in Burnley’s brewing industry, becoming a partner in Massey’s Brewery alongside his brother Charles in 1883. Music was also part of his life: he served as choirmaster at St Luke’s Church in Brierfield.</p>
        <p>When he died in 1909, he left £135,000 to benefit the people of Burnley. The bequest fund was established in 1910. The town’s corporation invested the gift, and trustees have maintained it over the years so it can continue to provide grants.</p>
        <p>Its purpose spans education, science, learning, music and the arts. The Edward Stocks Massey Gallery at Towneley Hall and the Massey Music Library at Burnley Central Library are part of that legacy. Today, the fund supports local organisations and student scholarships.</p>
        <p class="history-source">Sources: <a href="https://burnley.gov.uk/council-democracy/stocks-massey/">Burnley Borough Council’s history of the bequest</a> and <a href="https://council.lancashire.gov.uk/documents/s258695/Report.pdf">Lancashire County Council’s account of the fund’s origins and purpose (PDF)</a>.</p>
      </div>
    </section>

    <section class="articles-section" id="articles" aria-labelledby="articles-title">
      <header class="articles-heading"><div><p class="eyebrow">02 / The continuing legacy</p><h2 id="articles-title">Awards &amp; articles</h2><p>Reports on the people and organisations supported by the fund.</p></div><span class="article-count">{posts.length} articles</span></header>
      <div class="articles-grid">
        {posts.map(post => <div class="article-entry">
          <NewsCard title={post.data.title} date={post.data.date.toISOString()} description={post.data.description} slug={post.id} image={post.data.image} />
          {post.data.imageCredit && <p class="image-credit">{post.data.imageCredit}</p>}
        </div>)}
      </div>
    </section>
    <div class="page-footer"><a href="/projects/#burnley">← More Burnley projects</a><a href="/news/#burnley">All Burnley articles →</a></div>
  </div>
</Layout>

<style>
  .bequest-page { --gold: #d9bd83; --line: #30302d; max-width: 1120px; margin: 0 auto; padding: 40px 32px 25px; color: #f2f1ed; }
  .bequest-page a { background-image: none; }
  .bequest-page a:focus-visible { outline: 2px solid var(--gold); outline-offset: 5px; }
  .back-link, .page-footer a { color: #b8c3c9; font-size: .82rem; }
  .bequest-hero { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); gap: 65px; align-items: center; padding: 60px 0; border-bottom: 1px solid var(--line); }
  .eyebrow { color: var(--gold); font-size: .66rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  h1 { font-size: clamp(2.7rem, 5.5vw, 4.5rem); font-weight: 600; line-height: 1.06; letter-spacing: -.055em; margin: 22px 0; }
  h1 span { display: block; font-size: .65em; color: var(--gold); margin-top: 12px; letter-spacing: -.04em; }
  .full-name { color: #e6e2d8; font-size: 1rem; margin: 25px 0 12px; }
  .intro { color: #b7bec3; font-size: 1rem; line-height: 1.8; max-width: 48ch; }
  .chair-role { color: #c4c9cb; font-size: .9rem; line-height: 1.8; margin-top: 18px; max-width: 52ch; }
  .chair-role a { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
  nav { display: flex; flex-wrap: wrap; gap: 18px 30px; margin-top: 30px; }
  nav a { display: flex; gap: 20px; color: #e1d5bb; font-size: .85rem; padding: 8px 0; border-bottom: 1px solid #65563b; }
  .legacy-note { background: #141411; border: 1px solid #423c2e; border-radius: 16px; padding: 34px 28px; }
  .legacy-note strong { display: block; font-size: clamp(2.1rem, 3.8vw, 3.2rem); font-weight: 500; letter-spacing: -.05em; color: #f0d7a6; margin: 25px 0 15px; font-variant-numeric: tabular-nums; }
  .legacy-note p { color: #c2c1b9; font-size: .9rem; line-height: 1.8; }
  .legacy-foot { display: block; border-top: 1px solid #38362e; padding-top: 20px; margin-top: 25px; color: #b0ad9f; font-size: .76rem; line-height: 1.7; }
  section { scroll-margin-top: 95px; }
  .history-section { display: grid; grid-template-columns: 1fr 2fr; gap: 65px; padding: 55px 0; border-bottom: 1px solid var(--line); }
  h2 { font-size: 1.8rem; font-weight: 600; letter-spacing: -.04em; line-height: 1.2; margin: 14px 0 20px; }
  .history-copy > p { color: #c0c6ca; line-height: 1.85; margin: 0 0 20px; }
  .history-copy .history-source { font-size: .76rem; color: #a9b1b6; margin-bottom: 0; }
  .history-source a { color: #d9bd83; text-decoration: underline; text-underline-offset: 3px; }
  .articles-section { padding: 50px 0; }
  .articles-heading { display: flex; align-items: end; justify-content: space-between; gap: 25px; margin-bottom: 28px; }
  .articles-heading h2 { margin-bottom: 12px; }
  .articles-heading p:last-child { color: #b7bec3; font-size: .92rem; }
  .article-count { color: #b7af9e; font-size: .76rem; white-space: nowrap; }
  .articles-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .article-entry { display: grid; grid-template-rows: 1fr auto; min-width: 0; }
  .image-credit { color: #a9b1b6; font-size: .65rem; line-height: 1.6; margin-top: 10px; }
  .page-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 20px; padding: 25px 0; border-top: 1px solid var(--line); }
  @media (max-width: 800px) { .bequest-hero { gap: 30px; grid-template-columns: 1fr; padding: 40px 0; } .legacy-note { padding: 25px; } .legacy-note strong { margin: 16px 0 10px; } .history-section { gap: 24px; grid-template-columns: 1fr; padding: 36px 0; } .history-heading h2 { margin-bottom: 0; } }
  @media (max-width: 600px) { .bequest-page { padding: 28px 20px 20px; } .articles-grid { grid-template-columns: 1fr; } .articles-heading { align-items: start; } .articles-section { padding: 36px 0; } h1 { font-size: clamp(2.5rem, 10vw, 3.5rem); } }
</style>

---
// Lancashire Voice: a clickable prototype of the engagement platform idea. Draft, unlinked, noindex.
// The page is generated in Reports (Lancashire_Voice_Game/build.py, prototype_template.html). Do not edit it by hand.
// It collects nothing: the build rejects any network, storage or form call in the template.
// The page skips the site Layout so its own styles stay intact, so it renders the imprint itself.
import { imprint as imp } from '../../data/imprint';
import { CONTACT_EMAIL } from '../../config';
import page from '../../data/lancashire-voice/prototype.html?raw';

const title = 'Lancashire Voice: prototype';
const ogImage = 'https://tompickup.co.uk/images/share/lancashire-voice.png';
const description = 'A clickable prototype of a resident engagement platform for Lancashire. Not a council service; nothing you enter is collected.';
const imprintLine = imp.show
  ? `Promoted by ${imp.promoter} on behalf of ${imp.onBehalfOf}, both at ${imp.address}${imp.party ? `, and by ${imp.party}` : ''}.`
  : '';
// The feedback link uses the site's one contact address.
const body = page
  .replaceAll('__CONTACT_EMAIL__', CONTACT_EMAIL)
  .replace(/<title>[\s\S]*?<\/title>/, '')
  .replace(
    '<!--IMPRINT-->',
    `<p class="src"><a href="/">tompickup.co.uk</a></p>` + (imprintLine ? `<p class="src">${imprintLine}</p>` : ''),
  );
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <style is:global>
      .site-home {
        margin: 0 auto;
        padding: 0 16px;
        max-width: 980px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font: 600 0.82rem/1 var(--f-body);
        letter-spacing: 0.02em;
      }
      .site-home-bar { background: var(--surface); border-bottom: 1px solid var(--line); }
      .site-home a { text-decoration: none; color: var(--ink); }
      .site-home a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <div class="site-home-bar">
      <header class="site-home">
        <a class="brand-home" href="/">tompickup.co.uk</a>
        <nav aria-label="Site"><a href="/about/">About Tom</a></nav>
      </header>
    </div>
    <Fragment set:html={body} />
  </body>
</html>

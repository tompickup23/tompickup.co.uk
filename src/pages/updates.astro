---
import Layout from '../layouts/Layout.astro';

// Ways to follow new posts. There is no mailing list: this page collects no
// personal data. It replaced a signup form on 7 October 2026.
const ROUTES = [
  {
    name: 'RSS feed',
    href: '/rss.xml',
    note: 'Every new post on this site, in any feed reader. Nothing to sign up to.',
    external: false,
  },
  {
    name: 'Substack',
    href: 'https://tompickup.substack.com/',
    note: 'Shorter versions of the main investigations, published on the web.',
    external: true,
  },
  {
    name: 'X',
    href: 'https://x.com/tompickup',
    note: 'New posts and council business as it happens. @tompickup',
    external: true,
  },
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/tompickupburnley',
    note: 'Local news for Padiham and Burnley.',
    external: true,
  },
];
---

<Layout
  title="Follow new posts | Tom Pickup"
  description="Follow new investigations and council decisions on Padiham, Burnley and Lancashire by RSS, on Substack or on social media."
>
  <section class="updates-page">
    <div class="container-narrow">
      <h1>Follow new posts</h1>
      <p class="updates-intro">
        New investigations and council decisions on Padiham, Burnley and Lancashire, each with
        its sources. There is no mailing list; follow whichever way suits you.
      </p>

      <ul class="follow-list">
        {ROUTES.map((r) => (
          <li>
            <a
              href={r.href}
              target={r.external ? '_blank' : undefined}
              rel={r.external ? 'noopener noreferrer' : undefined}
            >
              {r.name}{r.external && <span aria-hidden="true"> &#8599;</span>}
            </a>
            <p>{r.note}</p>
          </li>
        ))}
      </ul>

      <p class="updates-help">
        Need help with a council issue rather than news? <a href="/contact/">Get in touch</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .updates-page {
    padding: 7rem 0 var(--space-2xl);
  }

  .updates-page h1 {
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    margin-bottom: var(--space-md);
  }

  .updates-intro {
    font-size: 1.125rem;
    color: var(--muted);
    margin-bottom: var(--space-xl);
  }

  .follow-list {
    border-top: 1px solid var(--line);
    margin-bottom: var(--space-xl);
  }

  .follow-list li {
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--line);
  }

  .follow-list a {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .follow-list p {
    margin-top: var(--space-xs);
    color: var(--muted);
  }

  .updates-help {
    color: var(--muted);
  }
</style>

---
// Young Lancashire Voice: a prototype of the young people's side of Lancashire Voice.
// A short Full Council meeting played from a seat in the chamber, a motion built from fixed
// parts, a vote, and a hand-over to Lancashire Voice (the motion travels as four numbers after
// the #, never as typed words). Draft, noindex. It collects, stores and sends nothing.
// Motion parts: src/data/young-lancashire-voice/motions.json (also read by the Lancashire
// Voice wrapper). Research: docs/COUNTY-HALL-YOUTH-VOICE-DESIGN-2026-11-13.md.
// Offices only: no named councillor, no party, no real seating plan.
// 14 Nov 2026: class meeting on one screen (role cards, speech clock, the room's own show of
// hands, casting vote, debrief), tap-to-explain words, read aloud and sound (both off until
// asked for), "how the vote went", and the figures turn to whoever is speaking.
import Layout from '../../layouts/Layout.astro';

const title = 'Young Lancashire Voice';
const description = 'A prototype: take a seat in the county council chamber, bring your own motion and put it to Lancashire. Not a council service; nothing is collected.';
const ogImage = 'https://tompickup.co.uk/images/share/lancashire-voice.png';
---

<Layout
  title={`${title}: prototype | Tom Pickup`}
  description={description}
  ogImage={ogImage}
  ogImageAlt="Lancashire Voice, a prototype engagement platform"
  ogImageWidth={1200}
  ogImageHeight={630}
  breadcrumbLabel={title}
  noindex
>
  <div class="ylv">
    <p class="ylv-proto" role="note">
      <b>Prototype</b>
      Built by Tom Pickup for his own website. Not a council service and not part of the UK Youth Parliament. Nothing you enter is collected, stored or sent.
    </p>
    <header class="ylv-head">
      <div>
        <p class="ylv-eyebrow">The young people's side of <a href="/lancashire-voice/">Lancashire Voice</a></p>
        <h1>Young Lancashire Voice</h1>
      </div>
      <nav class="ylv-tabs" id="ylv-tabs" aria-label="Sections"></nav>
    </header>
    <main id="ylv-app" class="ylv-app">
      <noscript>
        <p>This prototype needs JavaScript. In short: you build a motion from set parts, sit through a short county council meeting, vote, and see how the same motion would be put to all of Lancashire.</p>
      </noscript>
    </main>
    <p class="ylv-sr" id="ylv-sr" aria-live="polite"></p>
  </div>
</Layout>

<script>
  import M from '../../data/young-lancashire-voice/motions.json';

  const $ = (s, r = document) => r.querySelector(s);
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
  const TABS = ['Home', 'Your motion', 'Take your seat', 'Ask Lancashire', 'What happens next', 'How it works'];
  const SEATS = 84;

  // A motion is four small numbers. The pattern is strict so a link cannot put words on the screen.
  const CODE = /^([0-6])\.([0-2])\.([0-2])\.([0-2])$/;
  function fromHash() {
    const m = new URLSearchParams(location.hash.slice(1)).get('m');
    const k = m && m.match(CODE);
    return k ? k.slice(1).map(Number) : null;
  }
  const S = {
    tab: 0,
    motion: fromHash() || [0, 0, 0, 1],
    built: !!fromHash(),
    seat: 0,
    step: 0,
    log: {},
    result: null,
    votes: [],
    hands: { f: 0, a: 0 },
    cam: 'seat',
    d3: true,
    cls: false,
    room: { report: null, motion: null },
    tie: null,
    voice: false,
    sound: false,
  };
  const code = () => S.motion.join('.');
  function motionText(m = S.motion) {
    const s = M.subjects[m[0]];
    return {
      subject: s.name,
      service: s.service,
      notes: `This Council notes that ${s.notes[m[1]]}.`,
      resolves: `This Council resolves to ${s.actions[m[2]]}, paid for ${M.money[m[3]]}.`,
      short: cap(s.actions[m[2]]) + '.',
    };
  }

  /* Words a young person may not know. One list feeds the tap-to-explain buttons in the meeting
     and the word list on How it works. [name, pattern, meaning]; longer patterns come first. */
  const TERMS = [
    ['Full Council', 'Full Council', 'The meeting of all the county councillors together.'],
    ['Friendly amendment', 'friendly amendment', 'A change to a motion that the mover accepts, so it is added with no vote.'],
    ['Supplementary question', 'supplementary question|supplementary', 'One follow-up question on the same subject.'],
    ['Chief Executive', 'Chief Executive', 'The council\'s most senior officer.'],
    ['Cabinet Member', 'Cabinet Members?', 'A councillor in charge of one of the council\'s services, such as roads or libraries.'],
    ['Notice of motion', 'notices? of motion', 'A motion sent in ahead of the meeting, so that it is on the agenda.'],
    ['Right of reply', 'right to reply|right of reply', 'The mover\'s last word before the vote.'],
    ['Show of hands', 'show of hands', 'A vote by raising a hand. Nobody counts the hands unless it is close.'],
    ['Named vote', 'named vote', 'A vote where each councillor\'s name and vote is written down. Six councillors must stand to ask for one.'],
    ['Casting vote', 'casting vote', 'When the votes are equal, the Chairman has one more vote to settle it.'],
    ['Through the Chair', 'through the Chair', 'Speaking to the Chairman, and not straight to another councillor.'],
    ['Chairman', 'Chairman', 'The councillor who runs the meeting and keeps it to the rules.'],
    ['Apologies', 'apologies', 'The councillors who could not come to the meeting.'],
    ['Declare', 'declare', 'To say out loud that a decision could affect you or people close to you.'],
    ['Seconder', 'seconder', 'The councillor who backs a motion so that it can be debated.'],
    ['Amendment', 'amendments?', 'A change to the words of a motion.'],
    ['Motion', 'motions?', 'A councillor asking the council to do something.'],
    ['Mover', 'mover', 'The councillor who puts a motion to the council.'],
    ['Agenda', 'agenda', 'The list of things the meeting will deal with, in order.'],
    ['Officer', 'officers?', 'Someone who works for the council. Officers are not elected and do not vote.'],
    ['Division', 'division', 'The area a county councillor is elected for.'],
    ['Carried', 'carried', 'Agreed. The council said yes.'],
    ['Abstain', 'abstain|abstentions?', 'To be there and vote neither for nor against.'],
  ];
  const TERM_RE = new RegExp('\\b(?:' + TERMS.map((t) => `(${t[1]})`).join('|') + ')\\b', 'gi');
  // Escapes the text, then turns the first use of each known word into a button that explains it.
  function words(text) {
    const seen = new Set();
    return esc(text).replace(TERM_RE, (hit, ...g) => {
      const i = g.findIndex((x, k) => k < TERMS.length && x != null);
      if (i < 0 || seen.has(i)) return hit;
      seen.add(i);
      return `<button type="button" class="ylv-term" data-term="${i}">${hit}</button>`;
    });
  }

  /* Read aloud and sound. Both are off until asked for, and both are made on the device. */
  const canSpeak = 'speechSynthesis' in window;
  function speak(text) {
    if (!canSpeak) return;
    speechSynthesis.cancel();
    if (!S.voice || !text) return;
    const u = new SpeechSynthesisUtterance(text);
    u.lang = 'en-GB'; u.rate = 0.95;
    speechSynthesis.speak(u);
  }
  let ac = null;
  function sound(kind) {
    if (!S.sound) return;
    try {
      ac ||= new (window.AudioContext || window.webkitAudioContext)();
      if (ac.state === 'suspended') ac.resume();
      const t = ac.currentTime, out = ac.createGain();
      out.connect(ac.destination);
      if (kind === 'item') {
        // Two soft notes when the meeting moves to a new item.
        [[587, 0], [784, 0.16]].forEach(([f, at]) => {
          const o = ac.createOscillator(), g = ac.createGain();
          o.type = 'sine'; o.frequency.value = f;
          g.gain.setValueAtTime(0.0001, t + at); g.gain.exponentialRampToValueAtTime(0.09, t + at + 0.02); g.gain.exponentialRampToValueAtTime(0.0001, t + at + 0.7);
          o.connect(g).connect(out); o.start(t + at); o.stop(t + at + 0.75);
        });
      } else {
        // A low murmur in the room when a vote is announced.
        const len = Math.floor(ac.sampleRate * 1.6), buf = ac.createBuffer(1, len, ac.sampleRate), d = buf.getChannelData(0);
        for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * (0.6 + 0.4 * Math.sin(i / 900));
        const n = ac.createBufferSource(), f = ac.createBiquadFilter(), g = ac.createGain();
        n.buffer = buf; f.type = 'bandpass'; f.frequency.value = 320; f.Q.value = 0.8;
        g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.12, t + 0.3); g.gain.exponentialRampToValueAtTime(0.0001, t + 1.55);
        n.connect(f).connect(g).connect(out); n.start(t);
      }
    } catch { S.sound = false; }
  }
  // The speech clock for a class meeting. Ten seconds here stand for each minute in the real chamber.
  let clock = 0;
  function startClock(secs) {
    clearInterval(clock);
    const out = $('#ylv-clock-out'), end = Date.now() + secs * 1000;
    const tick = () => {
      const left = Math.max(0, Math.ceil((end - Date.now()) / 1000));
      if (!out.isConnected) return clearInterval(clock);
      out.textContent = left > 0 ? `${left} seconds left` : 'Time. The Chairman says: sum up, please, councillor.';
      out.classList.toggle('over', left === 0);
      if (!left) { clearInterval(clock); sound('item'); }
    };
    tick(); clock = setInterval(tick, 250);
  }
  // Print one part of the page (the motion paper, the role cards) and nothing else.
  function printOnly(sel) {
    const el = $(sel);
    if (!el) return;
    el.classList.add('ylv-printme'); document.documentElement.classList.add('ylv-print');
    addEventListener('afterprint', () => { el.classList.remove('ylv-printme'); document.documentElement.classList.remove('ylv-print'); }, { once: true });
    window.print();
  }
  const ROLES = [
    ['The Chairman', 'Runs the meeting. Reads the Chairman\'s words, calls each speaker and announces every result.'],
    ['The Chief Executive', 'Reads the apologies, and helps the Chairman count the hands.'],
    ['A Cabinet Member', 'Answers the questions and moves the report on library rules.'],
    ['The questioner', 'Asks the public question about the crossing, from the public seats.'],
    ['The mover', 'Sits in the chosen seat. Asks a question, moves the class motion and has the last word. Makes the choices on the screen, with help from the room.'],
    ['The seconder', 'Backs the report, and then the motion, so that each can be debated.'],
    ['A councillor with an amendment', 'Asks for one change to the motion.'],
    ['A speaker for the motion', 'Makes a short speech for it. Read the words on the screen or use your own.'],
    ['A speaker against the motion', 'Makes a short speech against it. Argue with the idea, never the person.'],
    ['Councillors', 'Everyone else. Listen to the debate, then vote by raising a hand.'],
    ['Reporters', 'One or two people who do not vote. Write one sentence that says what the meeting decided.'],
  ];
  const DEBRIEF = [
    'Did anyone change their mind during the debate? What changed it?',
    'Was the amendment a fair change, or did it weaken the motion?',
    'Who did not speak, and what would they have said?',
    'If this cost money, what would you spend less on to pay for it?',
    'Which of the real ways to be heard would you use to take this further?',
  ];

  /* The chamber, drawn as a plan. Seat positions are not the real seating plan. */
  const PLAN = (() => {
    const rows = [11, 14, 17, 20, 22];
    const seats = [];
    rows.forEach((n, r) => {
      const rad = 112 + r * 29;
      const half = n / 2;
      for (let i = 0; i < n; i++) {
        const left = i < half;
        const k = left ? i : i - Math.ceil(half);
        const span = left ? Math.ceil(half) : Math.floor(half);
        const a0 = left ? 166 : 84, a1 = left ? 96 : 14;
        const a = ((a0 + (a1 - a0) * (span === 1 ? 0.5 : k / (span - 1))) * Math.PI) / 180;
        seats.push({ x: 300 + rad * Math.cos(a), y: 118 + rad * Math.sin(a) });
      }
    });
    return seats;
  })();
  const WHERE = { chair: [300, 40], ce: [252, 46], cab: 3, pupil: [218, 150], second: null, amend: 40, for: 12, against: 70 };

  function chamber(opts = {}) {
    const { speaker, tally } = opts;
    const me = S.seat - 1;
    const second = me >= 0 ? (me === 0 ? 1 : me - 1) : 5;
    const at = (who) => {
      if (who === 'me') return me >= 0 ? PLAN[me] : null;
      const w = who === 'second' ? second : WHERE[who];
      if (w == null) return null;
      return Array.isArray(w) ? { x: w[0], y: w[1] } : PLAN[w];
    };
    const sp = speaker ? at(speaker) : null;
    const seatDots = PLAN.map((p, i) => {
      let cls = 'seat';
      if (tally) cls += ' ' + tally[i];
      if (i === me) cls += ' me';
      const pick = opts.pick ? ` data-seat="${i + 1}" tabindex="-1"` : '';
      return `<circle class="${cls}" cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="6.4"${pick}><title>Seat ${i + 1}</title></circle>`;
    }).join('');
    return `<svg class="ylv-plan" viewBox="0 0 600 372" role="img" aria-label="Plan of the council chamber: the Chairman's dais at the top, a table in the middle and curved rows of numbered seats facing it.">
      <rect class="wall" x="6" y="6" width="588" height="360" rx="10"/>
      <g class="pillars">${[40, 560].map((x) => [70, 190, 310].map((y) => `<circle cx="${x}" cy="${y}" r="9"/>`).join('')).join('')}</g>
      <rect class="dais" x="196" y="18" width="208" height="46" rx="6"/>
      <path class="canopy" d="M272 18 q28 -14 56 0 z"/>
      <text class="lbl" x="300" y="80" text-anchor="middle">IN CONCILIO CONSILIUM</text>
      <ellipse class="table" cx="300" cy="150" rx="46" ry="22"/>
      <rect class="aisle" x="292" y="226" width="16" height="132" rx="3"/>
      <text class="lbl" x="300" y="362" text-anchor="middle">Public gallery</text>
      ${seatDots}
      <circle class="office" cx="300" cy="40" r="8"><title>The Chairman</title></circle>
      <circle class="office" cx="252" cy="46" r="7"><title>The Chief Executive</title></circle>
      <circle class="office" cx="348" cy="46" r="7"><title>An officer</title></circle>
      ${speaker === 'pupil' ? `<circle class="guest" cx="218" cy="150" r="7"/>` : ''}
      ${sp ? `<circle class="talk" cx="${sp.x.toFixed(1)}" cy="${sp.y.toFixed(1)}" r="13"/>` : ''}
    </svg>`;
  }

  /* The room in 3D. The plan above stays as the fallback and as a choice. The module loads only
     when the chamber tab is opened, and one canvas is kept and moved between renders. */
  let room = null, roomHost = null, roomLoading = null;
  const roomBox = (svg, tools = '') => S.d3
    ? `<div class="ylv-room" id="ylv-room">${svg}</div><p class="ylv-roomtools">${tools}<button type="button" class="ylv-chip" data-d3="0">Show the flat plan</button></p>`
    : `${svg}<p class="ylv-roomtools"><button type="button" class="ylv-chip" data-d3="1">Show the room in 3D</button></p>`;
  function who3d(w) {
    const me = S.seat - 1;
    if (w === 'me') return 'me';
    if (w === 'chair') return 84;
    if (w === 'ce') return 85;
    if (w === 'pupil') return 87;
    let i = w === 'second' ? (me === 0 ? 1 : me - 1) : WHERE[w];
    if (i === me) i = (i + 2) % SEATS;
    return i;
  }
  function roomState() {
    if (!S.seat) return { seat: -1, speaker: null, tally: null, mode: 'over', pick: true, item: 'Choose your seat', who: '' };
    const all = steps(), st = all[Math.min(S.step, all.length - 1)];
    return { seat: S.seat - 1, speaker: who3d(st.who), tally: st.tally || null, mode: st.tally ? 'chair' : S.cam, pick: false, item: AGENDA[st.item][0], who: st.who === 'me' ? `The councillor in seat ${S.seat}` : WHO[st.who] };
  }
  function mountRoom() {
    const slot = $('#ylv-room');
    if (!slot) return;
    if (room) { slot.replaceChildren(roomHost); room.set(roomState()); room.resize(); return; }
    if (roomLoading) return;
    roomLoading = import('../../games/ylv/chamber.js').then((mod) => {
      roomHost = document.createElement('div');
      roomHost.className = 'ylv-roomhost';
      roomHost.tabIndex = 0;
      roomHost.setAttribute('role', 'img');
      roomHost.setAttribute('aria-label', 'The council chamber as a room: curved rows of green benches rising towards the back, facing the Chairman on a raised bench under a carved canopy. Drag, or use the arrow keys, to look round.');
      room = mod.createRoom(roomHost, { plan: PLAN, reduced: matchMedia('(prefers-reduced-motion: reduce)').matches });
      room.onPick = (i) => { S.seat = i + 1; S.step = 0; render('[data-next]'); };
      mountRoom();
    }).catch(() => { S.d3 = false; room = null; if (S.tab === 2) render(); });
  }

  /* The meeting. Offices only. The forms of words follow those used in the chamber. */
  const WHO = {
    chair: 'The Chairman',
    ce: 'The Chief Executive',
    cab: 'A Cabinet Member',
    pupil: 'A pupil, from the public seats',
    me: 'You',
    second: 'The councillor beside you',
    amend: 'A councillor across the chamber',
    for: 'A councillor in the front rows',
    against: 'A councillor at the back',
  };
  function tallyFor(n) {
    // Spread the votes over the seats in a fixed, shuffled order so the plan looks like a chamber, not a block.
    const order = PLAN.map((_, i) => i).sort((a, b) => ((a * 37 + 11) % SEATS) - ((b * 37 + 11) % SEATS));
    const t = new Array(SEATS).fill('against');
    const me = S.seat - 1;
    const others = order.filter((i) => i !== me);
    others.forEach((i, k) => (t[i] = k < n.f - (n.mine === 'for' ? 1 : 0) ? 'for' : k >= others.length - n.abs ? 'abstain' : 'against'));
    t[me] = n.mine;
    return t;
  }
  // A class meeting: the hands counted in the room, set out over the seats. The other seats stay as they are.
  function roomTally(v) {
    const order = PLAN.map((_, i) => i).sort((a, b) => ((a * 37 + 11) % SEATS) - ((b * 37 + 11) % SEATS));
    const t = new Array(SEATS).fill('empty');
    let k = 0;
    for (const [key, n] of [['for', v.f], ['against', v.a], ['abstain', v.abs]]) for (let j = 0; j < n && k < SEATS; j++) t[order[k++]] = key;
    return t;
  }
  const won = (v) => v.f > v.a || (v.f === v.a && v.cast === 'for');
  // What moved votes in the made-up count: [what you did, votes it won or lost].
  function sway() {
    const L = S.log;
    return [
      ['Councillors who liked the idea before anyone spoke, and you', 31],
      [`Saying it would be paid for ${M.money[S.motion[3]]}`, [3, 6, 3][S.motion[3]]],
      [L.open === 2 ? 'Opening with what it costs' : L.open === 1 ? 'Opening with why it is fair' : 'Opening with one young person\'s story', L.open === 2 ? 4 : 2],
      [L.friendly ? 'Accepting the friendly amendment' : 'Refusing the amendment', L.friendly ? 10 : 0],
      [['Answering the question about money', 'A polite reply that left the money question hanging', 'Going for the person and not the idea'][L.reply ?? 1], [8, 2, -6][L.reply ?? 1]],
    ];
  }
  function count() {
    if (S.cls && S.room.motion) { const v = S.room.motion; return { f: v.f, a: v.a, abs: v.abs, mine: 'for', carried: won(v), cast: v.f === v.a ? v.cast : null }; }
    const forAll = sway().reduce((n, x) => n + x[1], 0);
    const abs = 5;
    const against = SEATS - abs - forAll;
    return { f: forAll, a: against, abs, mine: 'for', carried: forAll > against };
  }
  function steps() {
    const t = motionText();
    const L = S.log;
    const n = count();
    const C = S.cls, R = S.room.report, V = S.room.motion;
    const own = C ? ' The speaker can read these words or use their own.' : '';
    const room = (v) => `In your room it was ${v.f} for and ${v.a} against, with ${v.abs} not voting.${v.f === v.a ? ' The votes were equal, so the Chairman used the casting vote.' : ''}`;
    return [
      { item: 0, who: 'chair', say: 'Good afternoon and welcome to this meeting of the Full Council. A reminder: you speak when I call your name, and not otherwise.', plain: 'The Chairman runs the meeting and does not take sides. Everyone speaks to the Chairman, not to each other.' },
      { item: 1, who: 'chair', say: 'Apologies. I invite the Chief Executive to read the apologies, please.', plain: 'Apologies are the councillors who could not come today.' },
      { item: 1, who: 'ce', say: 'Thank you, Chairman. We have received apologies from two councillors.', plain: 'The Chief Executive is the council\'s most senior officer. Officers work for the council. They are not elected and do not vote.' },
      { item: 2, who: 'chair', say: 'Are there any matters on today\'s agenda that members wish to declare?', plain: 'Item 5 is about the rules for libraries. Imagine your mum works in a library. What do you do?',
        ask: 'declare', choices: ['Stand and declare it', 'Say nothing'] },
      { item: 2, who: 'chair', say: 'Thank you. That is noted.', plain: L.declare === 1
          ? 'You said nothing, so the councillor beside you nudged you. Councillors say so when a decision could affect them or people close to them. That way everyone can see the decision is fair.'
          : 'Well done. Councillors say so when a decision could affect them or people close to them. That way everyone can see the decision is fair.' },
      { item: 3, who: 'chair', say: 'Public question time. It is great to see public questions. I invite our questioner to read out the question, please.', plain: 'Members of the public can ask the council a question at this meeting. The rules set no age limit. A question can be up to 150 words.' },
      { item: 3, who: 'pupil', say: 'Children at my school have to cross a busy road every morning. Will the council look at a crossing patrol for us?', plain: 'A question has to be sent in ahead of the meeting, so the answer can be got ready.' },
      { item: 3, who: 'cab', say: 'Thank you for your question. Officers will look at the road, and I will write to you with what they find.', plain: 'Cabinet Members are the councillors in charge of each service. They answer the questions.' },
      { item: 4, who: 'chair', say: 'Question time. Councillor, please read out your question.', plain: 'Now it is your turn. Councillors can ask one question each. Pick yours.',
        ask: 'q', choices: ['How many of our libraries are open after six in the evening?', 'How long does it take to mend a pothole once it is reported?', 'How many youth club nights run in each district?'] },
      { item: 4, who: 'cab', say: 'I thank the councillor for the question. I do not have that figure with me, and I will send a written answer.', plain: 'Each spoken answer can take up to three minutes. If the answer is not to hand, it comes later in writing.' },
      { item: 4, who: 'chair', say: 'Councillor, do you have a supplementary question?', plain: 'A supplementary is one follow-up question on the same subject.',
        ask: 'supp', choices: ['Will you ask young people what they think before you decide?', 'I just want to say this matters a great deal to everyone I know.'] },
      L.supp === 1
        ? { item: 4, who: 'chair', say: 'It is a supplementary question, not a statement.', plain: 'The Chairman keeps people to the rules. A follow-up has to be a question. The time for speeches comes later.' }
        : { item: 4, who: 'cab', say: 'Yes. I am happy to do that.', plain: 'A short, clear question got a short, clear answer.' },
      { item: 5, who: 'chair', say: 'Item 5, the rules for our libraries. Cabinet Member, to move the report, please.', plain: 'A report asks the whole council to agree something. To move it means to ask the council to say yes.' },
      { item: 5, who: 'cab', say: 'Chairman, I am happy to move the recommendation.', plain: 'Nothing can be debated until one councillor moves it and another seconds it.' },
      { item: 5, who: 'second', say: 'Chairman, I am happy to second that.', plain: 'To second is to say: I agree this is worth deciding.' },
      { item: 5, who: 'chair', say: 'Would any member like to speak? I do not see any indicating. Can I have a show of hands? All those in favour, please?', plain: C ? 'The first vote. Each councillor has one vote. The Chairman asks for those in favour, then those against. Count the hands and type the numbers in.' : 'Your first vote. Each councillor has one vote.',

        ? { item: 5, who: 'chair', say: won(R) ? (R.a ? 'That is carried.' : 'Clearly carried.') : 'That is lost.', plain: `${room(R)} Carried means the council said yes. Most votes are a show of hands like this one.`, tally: roomTally(R) }
        : { item: 5, who: 'chair', say: 'Clearly carried.', plain: 'Carried means the council said yes. Most votes are a show of hands like this one.',

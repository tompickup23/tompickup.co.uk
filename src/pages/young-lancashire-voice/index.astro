      { item: 6, who: 'chair', say: 'Notices of motion. Councillor, please put forward your notice of motion.', plain: 'A motion is a councillor asking the council to do something. This one is yours. How do you open your speech?', motion: true,
        ask: 'open', choices: ['Tell the story of one young person this would help', 'Say why it is fair', 'Say what it costs and where the money comes from'] },
      { item: 6, who: 'me', say: `Chairman, I rise to propose the motion in your papers. ${t.notes} ${t.resolves}`, plain: 'In the real chamber the mover of a motion can speak for up to five minutes. Everyone else gets three.' + own, motion: true, clock: 50 },
      { item: 6, who: 'chair', say: 'Is there a seconder to that motion?', plain: 'Without a seconder the motion falls and is not debated.', motion: true },

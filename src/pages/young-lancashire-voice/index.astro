      { item: 6, who: 'amend', say: 'Chairman, I would like to move an amendment: that the council reports back on the cost before the work starts.', plain: 'The Chairman now asks whether you accept this as a friendly amendment. If you accept it, it is added with no vote.', motion: true,
        ask: 'friendly', choices: ['Accept it as a friendly amendment', 'Refuse it'] },
      L.friendly
        ? { item: 6, who: 'chair', say: 'The mover accepts the friendly amendment. We continue with the motion as amended.', plain: 'You gave a little and kept the councillor on your side. That is how many motions get through.', motion: true }
        : { item: 6, who: 'chair', say: 'The mover does not accept the amendment, so we vote on it. All those in favour of the amendment? The amendment is carried.', plain: 'The council added it anyway, and a few councillors noticed you would not bend.', motion: true },
      { item: 6, who: 'for', say: 'Chairman, I support this motion. Young people in my division have asked for exactly this.', plain: 'A division is the area a county councillor is elected for.' + own, motion: true, clock: 30 },
      { item: 6, who: 'against', say: 'Chairman, I am not against the idea. But every pound can only be spent once. What gives way to pay for this?', plain: 'This is the heart of most debates: not whether something is good, but what to spend less on.' + own, motion: true, clock: 30 },
      { item: 6, who: 'chair', say: 'Councillor, you now have the right to reply before the vote.', plain: 'The mover always gets the last word. How do you use it?', motion: true,
        ask: 'reply', choices: ['Answer the question about money', 'Thank everyone and say your motion again', 'Say the last speaker does not care about young people'] },
      L.reply === 2
        ? { item: 6, who: 'chair', say: 'Through the Chair, please. Councillors will debate the motion, not each other.', plain: 'You lost some votes there. In the chamber you argue with the idea, never the person.', motion: true }
        : { item: 6, who: 'me', say: L.reply === 0 ? `Chairman, the councillor asks a fair question. This would be paid for ${M.money[S.motion[3]]}. I ask the council to support the motion.` : 'Chairman, I thank members for the debate, and I ask the council to support the motion.', plain: (L.reply === 0 ? 'You answered the hardest question in the room. That wins votes.' : 'Polite, but the question about money is still hanging.') + own, motion: true, clock: 30 },

      C && V
        ? { item: 6, who: 'chair', say: won(V) ? 'That is carried.' : 'That is lost.', plain: `${room(V)} This vote was real: it is the count from your room.`, motion: true, tally: roomTally(V), end: true }
        : L.named === 1

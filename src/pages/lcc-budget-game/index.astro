---
// Lancashire Budget Challenge: a standalone game page.
// The game data is generated in Reports from the LCC budget model. Do not edit it by hand.
// The page skips the site Layout so the game's own styles stay intact, so it renders the imprint itself.
import { imprint as imp } from '../../data/imprint';
import { personRef } from '../../data/person';
import game from '../../data/lcc-budget-game/game.html?raw';

const title = 'Lancashire Budget Challenge';
// The browser tab and search result carry the site name, as every Layout page does.
const pageTitle = `${title} | Tom Pickup`;
const description = "Where Lancashire County Council's money goes, what has changed since May 2025, and whether you can balance next year's budget.";
const ogImage = 'https://tompickup.co.uk/images/share/lcc-budget-game.png';
// The game as a WebApplication node, in the same shape as the AI DOGE page's.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://tompickup.co.uk/lcc-budget-game/#app',
  name: title,
  url: 'https://tompickup.co.uk/lcc-budget-game/',
  description,
  image: ogImage,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web browser',
  isAccessibleForFree: true,
  inLanguage: 'en-GB',
  author: personRef,
  creator: personRef,
};
const imprintLine = imp.show
  ? `Promoted by ${imp.promoter} on behalf of ${imp.onBehalfOf}, both at ${imp.address}${imp.party ? `, and by ${imp.party}` : ''}.`
  : '';
// Keep the footer imprint link; the site header sits outside the game.
// Link colour uses the game's own rose accent so anchors are not browser blue.
const body = game
  .replace(/<title>[\s\S]*?<\/title>/, '')
  .replace(
    '<!--IMPRINT-->',
    `<p class="src"><a href="/">tompickup.co.uk</a></p>` + (imprintLine ? `<p class="src">${imprintLine}</p>` : ''),
  );
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href="https://tompickup.co.uk/lcc-budget-game/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://tompickup.co.uk/lcc-budget-game/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <style is:global>
      a { color: var(--rose); }
      a:hover { color: var(--ink); }
      /* Links on the dark hero use its brighter rose colour. */
      .hero a { color: #ff7a8a; }
      .hero a:hover { color: var(--hero-ink); }
      .site-home {
        margin: 0;
        padding: 0 16px;
        max-width: 1040px;
        margin-inline: auto;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--surface);
        border-bottom: 1px solid var(--line);
        font: 600 0.82rem/1 var(--f-body);
        letter-spacing: 0.02em;
      }
      .site-home a { text-decoration: none; }
      .site-home nav { display: flex; }
      /* Reserve the square populated by the game script before its first paint. */
      #heroWaffle { width: 100%; max-width: 340px; aspect-ratio: 1; margin-inline: auto; }
      #heroLegend { min-height: 3.5rem; }
      #heroCap { min-height: 2.5em; }
      .site-home a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <header class="site-home">
      <a class="brand" href="/">tompickup.co.uk</a>
      <nav aria-label="Site"><a href="/about/">About Tom</a></nav>
    </header>
    <Fragment set:html={body} />
  </body>
</html>

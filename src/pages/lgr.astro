---
import Layout from '../layouts/Layout.astro';
import '../styles/doge.css';

// ============================================================
// Local Government Reorganisation (LGR) — Lancashire.
// ALL data comes from the canonical dataset in src/data/lgr/
// (authorities.json, county.json, decision.json — every figure
// individually sourced), assembled by scripts/lgr_build.py into
// model.json. The same model is published at /data/lgr-model.json.
// Never hand-edit figures here: change the canonical dataset and
// re-run the build script.
// ============================================================
import model from '../data/lgr/model.json';

const C = model.county;
const DEC = model.decision;

// Map cards, in decision order (North, West, East, South).
const UNITARIES = model.unitaries
  .slice()
  .sort((a, b) => ['North', 'West', 'East', 'South'].findIndex((p) => a.name.startsWith(p))
                - ['North', 'West', 'East', 'South'].findIndex((p) => b.name.startsWith(p)));

const RESERVES = C.reserves.map((r) => ({ year: r.year, total: r.total_m, months: r.monthsCover, rating: r.rating }));
const RES_MAX = Math.max(...RESERVES.map((r) => r.total));

// Population chart, largest first.
const POP = model.unitaries.slice().sort((a, b) => b.population - a.population)
  .map((u) => ({ name: u.name, pop: u.population, accent: u.accent }));
const POP_TOTAL = model.totalPop;
const POP_MAX = Math.max(...POP.map((p) => p.pop));
const fmt = (n: number) => n.toLocaleString('en-GB');

// LCC 2026/27 net budget by directorate (spend-by-service). Verified against
// the council's own budget papers via the AI DOGE handover facts.
const SPEND = C.directorates.map((d) => ({ name: d.name, m: d.m }));
const SPEND_MAX = Math.max(...SPEND.map((s) => s.m));

// Largest external suppliers by processed spend (AI DOGE spending corpus).
// Excludes lawfully redacted payments to individuals (Care Act / GDPR).
const SUPPLIERS = C.topSuppliers.map((s) => ({ name: s.name, m: s.m }));
const SUP_MAX = Math.max(...SUPPLIERS.map((s) => s.m));

// ============================================================
// FOUR-UNITARY MODEL — all figures from model.json (see header note).
// ============================================================
const LCC_BUDGET = model.lcc.budget_m;
const LCC_PER_CAPITA = model.lcc.perCapita;

// Type lookup for the constituent-council chips.
const OWN_BUDGET: Record<string, { type: 'd' | 'u' }> = {};
for (const u of model.unitaries)
  for (const o of u.owns) OWN_BUDGET[o.council] = { type: o.type === 'unitary' ? 'u' : 'd' };

const BASELINE: Record<string, number> = model.baseline;

// need: 'high' = a higher value signals greater service need/disadvantage;
// 'low' = higher is better; 'neutral' = contextual.
const METRICS = [
  { key: 'healthDemandScore', label: 'Adult social-care demand', suffix: '', need: 'high', help: 'Composite health-need score' },
  { key: 'empRate', label: 'Employment rate', suffix: '%', need: 'low', help: 'Share of adults in work' },
  { key: 'noQuals', label: 'No qualifications', suffix: '%', need: 'high', help: 'Adults with no formal qualifications' },
  { key: 'fsmPct', label: 'Free school meals', suffix: '%', need: 'high', help: 'Pupils eligible for FSM' },
  { key: 'crimeRate', label: 'Crime rate', suffix: '/1k', need: 'high', help: 'Recorded crimes per 1,000 people' },
  { key: 'socialRentPct', label: 'Social renting', suffix: '%', need: 'neutral', help: 'Households in social housing' },
  { key: 'ealPct', label: 'English as additional language', suffix: '%', need: 'neutral', help: 'Pupils with EAL' },
  { key: 'hmoPer1k', label: 'HMOs per 1,000', suffix: '', need: 'neutral', help: 'Houses in multiple occupation' },
];

// Explorer order: East first (home unitary), then South, North, West.
const EXPLORER_ORDER = ['East', 'South', 'North', 'West'];
const MODEL = model.unitaries
  .slice()
  .sort((a, b) => EXPLORER_ORDER.findIndex((p) => a.name.startsWith(p))
                - EXPLORER_ORDER.findIndex((p) => b.name.startsWith(p)))
  .map((u) => ({
    name: u.name, accent: u.accent, councils: u.councils, metrics: u.metrics,
    pop: u.population, lccServedPop: u.lccServedPop,
    countyApportioned: u.countyApportioned.population,
    countyApportionedNeeds: u.countyApportioned.needs,
    perCapitaCounty: u.perCapitaCounty,
    owns: u.owns.map((o) => ({ c: o.council, m: o.m, type: o.type === 'unitary' ? 'u' : 'd' })),
    ownTotal: u.ownTotal,
    combined: u.combined.population,
    combinedNeeds: u.combined.needs,
    combinedPerCapita: u.combinedPerCapita,
    bandD: u.bandD,
  }));
const UNITS = MODEL;
// Per-metric max across unitaries (for bar scaling), padded 15%.
const METRIC_MAX: Record<string, number> = {};
for (const m of METRICS) {
  METRIC_MAX[m.key] = Math.max(...UNITS.map((u) => (u.metrics as any)[m.key]), BASELINE[m.key]) * 1.15;
}
// Delta vs county baseline, with a plain-English direction for colouring.
function deltaInfo(key: string, val: number, need: string) {
  const base = BASELINE[key];
  const diff = Math.round((val - base) * 10) / 10;
  let tone: 'high' | 'low' | 'flat' = 'flat';
  if (Math.abs(diff) >= 0.1) {
    const above = diff > 0;
    if (need === 'neutral') tone = 'flat';
    else if (need === 'high') tone = above ? 'high' : 'low';
    else tone = above ? 'low' : 'high'; // need 'low' inverts
  }
  return { diff, tone };
}
const MODEL_JSON = JSON.stringify(MODEL);
const META_JSON = JSON.stringify({ BASELINE, METRICS, LCC_BUDGET, LCC_PER_CAPITA });
---

<Layout
  title="Lancashire is being redrawn: the LGR decision | Tom Pickup"
  description="On 16 July 2026 the government decided Lancashire's 15 councils will be replaced by four new unitary authorities from April 2028. The decision, the new map, and the county's finances going into it — every figure sourced."
>
  <div class="doge-page">
    <nav class="doge-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <span class="here">Local Government Reorganisation</span>
    </nav>

    <header class="doge-head">
      <span class="doge-eyebrow"><span class="dot"></span> Local Government Reorganisation</span>
      <h1 class="doge-title">Lancashire is being redrawn</h1>
      <p class="doge-sub">
        On 16 July 2026 the government announced its decision: Lancashire's 15 councils will be abolished and
        replaced by <strong>four new unitary authorities</strong> from April 2028. It is the biggest change to
        local government here in more than 50 years. This is what was decided, the new map, and the financial
        state of the county going into it — with every figure traceable to a published source.
      </p>
    </header>

    <div class="doge-statband">
      <div class="doge-stat"><div class="v teal">4</div><div class="l">New unitary councils</div></div>
      <div class="doge-stat"><div class="v">15 &rarr; 4</div><div class="l">Councils replaced</div></div>
      <div class="doge-stat"><div class="v">May 2027</div><div class="l">Shadow council elections</div></div>
      <div class="doge-stat"><div class="v">1 Apr 2028</div><div class="l">Vesting day (go-live)</div></div>
    </div>

    <!-- The decision -->
    <section class="doge-section">
      <h2 class="doge-h2">The decision</h2>
      <p class="doge-note">
        The Secretary of State for Housing, Communities and Local Government announced on
        <strong>16 July 2026</strong> that Lancashire's current structure — one county council, twelve district
        councils and two unitary authorities (Blackpool and Blackburn with Darwen) — will be reorganised into
        four unitary councils. Elections to shadow authorities are due in <strong>May 2027</strong>, with the new
        councils taking over all local services on <strong>1 April 2028</strong>. The change is subject to
        Parliamentary approval. Until vesting day, all 15 existing councils continue to run services as now.
      </p>
    </section>

    <!-- The new map -->
    <section class="doge-section">
      <h2 class="doge-h2">The four new unitary councils</h2>
      <p class="doge-note">Each new unitary is built from existing districts and boroughs, as set out in the government's decision.</p>
      <div class="lgr-unitaries">
        {UNITARIES.map((u) => (
          <div class="lgr-uni" style={`--accent:${u.accent}`}>
            <div class="lgr-uni-head">
              <span class="lgr-uni-name">{u.name}</span>
              {u.home && <span class="lgr-uni-tag">Padiham &amp; Burnley West</span>}
            </div>
            <ul class="lgr-uni-list">
              {u.councils.map((c) => <li>{c}</li>)}
            </ul>
            {u.note && <p class="lgr-uni-note">{u.note}</p>}
          </div>
        ))}
      </div>
    </section>

    <!-- Scale of the new councils -->
    <section class="doge-section">
      <h2 class="doge-h2">The scale of the four new councils</h2>
      <p class="doge-note">
        Resident population of each new unitary, summed from its constituent authorities (ONS Census 2021). Together
        the four cover <strong>{fmt(POP_TOTAL)}</strong> residents. Notably, <strong>all four fall below the
        ~500,000 population the government has used as a working guideline</strong> for new unitaries — East
        Lancashire comes closest at {fmt(498255)}, while the other three sit between 334,000 and 353,000.
      </p>
      <div class="doge-panel">
        <div class="doge-bars">
          {POP.map((u) => (
            <div class="dg-row">
              <div class="dg-top">
                <span class="dg-name">{u.name}</span>
                <span class="dg-val">{fmt(u.pop)}</span>
              </div>
              <div class="dg-track">
                <div class="dg-fill" style={`width:${(u.pop / POP_MAX * 100).toFixed(1)}%;background:linear-gradient(90deg, ${u.accent}aa, ${u.accent})`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <p class="doge-note" style="margin-top:0.9rem;">
        For scale, Lancashire County Council's £1,329.312m net budget works out at roughly <strong>£1,076 per
        resident</strong> across the 1.24 million people in the county area it serves (Blackpool and Blackburn with
        Darwen are already unitary) — spending on county services (adult social care, children's services,
        highways) that will pass to the new unitaries.
      </p>
    </section>

    <!-- ===== INTERACTIVE MODEL EXPLORER ===== -->
    <section class="doge-section" id="model">
      <span class="doge-eyebrow"><span class="dot"></span> Interactive model</span>
      <h2 class="doge-h2">Explore the four-unitary model</h2>
      <p class="doge-note">
        Pick a proposed council to see what it would actually be — who it merges, how many people it serves, the
        money it would run, and the depth of need it would have to meet. Money figures combine the
        <strong>verified</strong> budgets of every body that merges with a <strong>modelled</strong> split of the
        county's £1,329.312m across each area by population. Full method below.
      </p>

      <div class="lgr-cmp-wrap">
        <table class="lgr-cmp">
          <thead>
            <tr>
              <th class="lgr-cmp-rowh">At a glance</th>
              {MODEL.map((u) => <th style={`--accent:${u.accent}`}><span class="lgr-cmp-uni">{u.name.replace(' Lancashire', '')}</span></th>)}
            </tr>
          </thead>
          <tbody>
            <tr><td class="lgr-cmp-rowh">Population</td>{MODEL.map((u) => <td>{fmt(u.pop)}</td>)}</tr>
            <tr><td class="lgr-cmp-rowh">Combined net budget</td>{MODEL.map((u) => <td>{u.combined ? `£${fmt(u.combined)}m` : '—'}</td>)}</tr>
            <tr><td class="lgr-cmp-rowh">Spend per resident</td>{MODEL.map((u) => <td>{u.combinedPerCapita ? `£${fmt(u.combinedPerCapita)}` : '—'}</td>)}</tr>
            <tr><td class="lgr-cmp-rowh">Councils merged</td>{MODEL.map((u) => <td>{u.councils.length}</td>)}</tr>
            <tr><td class="lgr-cmp-rowh">Social-care demand</td>{MODEL.map((u) => <td>{u.metrics.healthDemandScore}</td>)}</tr>
            <tr><td class="lgr-cmp-rowh">Employment rate</td>{MODEL.map((u) => <td>{u.metrics.empRate}%</td>)}</tr>
            <tr><td class="lgr-cmp-rowh">Free school meals</td>{MODEL.map((u) => <td>{u.metrics.fsmPct}%</td>)}</tr>
          </tbody>
        </table>
      </div>

      <div class="lgr-mx" data-model={MODEL_JSON} data-meta={META_JSON}>
        <p class="lgr-mx-hint">Select a council for the full breakdown ↓</p>
        <div class="lgr-mx-tabs" role="tablist">
          {MODEL.map((u, i) => (
            <button class={`lgr-mx-tab${i === 0 ? ' active' : ''}`} data-i={i} role="tab" style={`--accent:${u.accent}`}>
              <span class="lgr-mx-tabname">{u.name.replace(' Lancashire', '')}</span>
              <span class="lgr-mx-tabpop">{fmt(u.pop)}</span>
            </button>
          ))}
        </div>

        {MODEL.map((u, i) => (
          <div class={`lgr-mx-panel${i === 0 ? ' active' : ''}`} data-i={i} style={`--accent:${u.accent}`}>
            <div class="lgr-mx-head">
              <div>
                <h3 class="lgr-mx-title">{u.name}</h3>
                <div class="lgr-mx-chips">
                  {u.councils.map((c) => <span class="lgr-mx-chip">{c}{OWN_BUDGET[c].type === 'u' ? ' ·unitary' : ''}</span>)}
                </div>
              </div>
              <div class="lgr-mx-viab">
                <span class="lgr-mx-viab-v">{fmt(u.pop)}</span>
                <span class="lgr-mx-viab-l">residents · {fmt(500000 - u.pop)} below the 500k guideline</span>
              </div>
            </div>

            <div class="lgr-mx-money">
              <div class="lgr-mx-stat big">
                <span class="lgr-mx-stat-v">{u.combined ? `£${fmt(u.combined)}m` : '—'}</span>
                <span class="lgr-mx-stat-l">Estimated combined net budget{u.combined ? '' : ' (gathering district figures)'}</span>
              </div>
              <div class="lgr-mx-stat">
                <span class="lgr-mx-stat-v">£{u.countyApportioned}m</span>
                <span class="lgr-mx-stat-l">County services apportioned in ({fmt(u.perCapitaCounty)}/head)</span>
              </div>
              <div class="lgr-mx-stat">
                <span class="lgr-mx-stat-v">{u.combinedPerCapita ? `£${fmt(u.combinedPerCapita)}` : '—'}</span>
                <span class="lgr-mx-stat-l">Total spend per resident</span>
              </div>
            </div>

            <div class="lgr-mx-build">
              <div class="lgr-mx-build-h">How the combined budget is built</div>
              <div class="lgr-mx-brow">
                <span class="lgr-mx-bname">County services (LCC, apportioned by population)</span>
                <span class="lgr-mx-bval">£{u.countyApportioned}m</span>
              </div>
              {u.owns.map((o) => (
                <div class="lgr-mx-brow">
                  <span class="lgr-mx-bname">{o.c}{o.type === 'u' ? ' (existing unitary — full budget)' : ' (district)'}</span>
                  <span class="lgr-mx-bval">{o.m !== null ? `£${o.m}m` : 'gathering…'}</span>
                </div>
              ))}
              <div class="lgr-mx-brow total">
                <span class="lgr-mx-bname">Estimated combined net budget</span>
                <span class="lgr-mx-bval">{u.combined ? `£${fmt(u.combined)}m` : '—'}</span>
              </div>
              <div class="lgr-mx-brow alt">
                <span class="lgr-mx-bname">…if county spend were split by social-care need instead of population</span>
                <span class="lgr-mx-bval">£{fmt(u.combinedNeeds)}m</span>
              </div>
            </div>

            <div class="lgr-mx-build">
              <div class="lgr-mx-build-h">The council-tax gap it must close</div>
              <p class="lgr-mx-bnote">
                What a Band D household currently pays for council services (own council + county precept where
                applicable; police, fire and parish excluded) differs across the merging councils. A single new
                council must eventually harmonise these:
              </p>
              <div class="lgr-mx-brow">
                <span class="lgr-mx-bname">Lowest today — {u.bandD.lowest.council}</span>
                <span class="lgr-mx-bval">£{u.bandD.lowest.bill.toFixed(2)}</span>
              </div>
              <div class="lgr-mx-brow">
                <span class="lgr-mx-bname">Highest today — {u.bandD.highest.council}</span>
                <span class="lgr-mx-bval">£{u.bandD.highest.bill.toFixed(2)}</span>
              </div>
              <div class="lgr-mx-brow total">
                <span class="lgr-mx-bname">Gap to harmonise (per Band D household, per year)</span>
                <span class="lgr-mx-bval">£{u.bandD.spread.toFixed(2)}</span>
              </div>
              <div class="lgr-mx-brow alt">
                <span class="lgr-mx-bname">Dwelling-weighted average across the new council</span>
                <span class="lgr-mx-bval">£{u.bandD.dwellingWeightedAvg.toFixed(2)}</span>
              </div>
            </div>

            <div class="lgr-mx-needs-h">The need it would have to meet <span>vs Lancashire average</span></div>
            <div class="lgr-mx-needs">
              {METRICS.map((m) => {
                const val = (u.metrics as any)[m.key];
                const { diff, tone } = deltaInfo(m.key, val, m.need);
                const w = Math.min(100, (val / METRIC_MAX[m.key]) * 100);
                const bw = Math.min(100, (BASELINE[m.key] / METRIC_MAX[m.key]) * 100);
                return (
                  <div class="lgr-mx-metric">
                    <div class="lgr-mx-mtop">
                      <span class="lgr-mx-mname">{m.label}</span>
                      <span class="lgr-mx-mval">{val}{m.suffix}
                        <span class={`lgr-mx-delta ${tone}`}>{diff > 0 ? '+' : ''}{diff}{m.suffix} vs {BASELINE[m.key]}{m.suffix}</span>
                      </span>
                    </div>
                    <div class="lgr-mx-track">
                      <div class={`lgr-mx-fill ${tone}`} style={`width:${w.toFixed(1)}%`}></div>
                      <div class="lgr-mx-base" style={`left:${bw.toFixed(1)}%`} title="Lancashire average"></div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>

      <p class="doge-note" style="margin-top:1rem; font-size:0.8rem;">
        <strong>Method.</strong> Population and place indicators are verified per constituent authority (ONS Census
        2021 and official statistics). County-service spend is Lancashire County Council's £1,329.312m net budget
        split across each area in proportion to the population it serves — a first-order, population-based
        apportionment, not a service-by-service costing. Blackpool and Blackburn with Darwen are already unitary, so
        their full net budgets are added and no county spend is apportioned to them. "Combined net budget" sums the
        apportioned county spend and every constituent council's own latest net revenue budget; because councils
        report on slightly different bases, treat it as an indicative scale, not an audited total. Transition costs,
        equal-pay exposure and council-tax harmonisation are not included here (see below).
      </p>
    </section>

    <!-- Where Burnley lands -->
    <section class="doge-section">
      <h2 class="doge-h2">Where Padiham &amp; Burnley West land</h2>
      <p class="doge-note">
        The division I represent falls inside the new <strong>East Lancashire</strong> unitary — the largest of
        the four by number of constituent councils, pulling together Blackburn with Darwen, Hyndburn, Rossendale,
        Pendle and Burnley. From April 2028 a single East Lancashire authority would run everything from adult
        social care and highways (today county responsibilities) to bins and planning (today borough
        responsibilities) across the whole of east Lancashire.
      </p>
    </section>

    <!-- The county's finances -->
    <section class="doge-section">
      <h2 class="doge-h2">The county's finances going into vesting</h2>
      <p class="doge-note">
        Lancashire County Council is by far the largest body being folded into the new unitaries. These are its
        headline figures, verified against the council's own 2026/27 budget papers (adopted by Full Council on
        26 February 2026) and GOV.UK / MHCLG returns.
      </p>
      <div class="doge-statband">
        <div class="doge-stat"><div class="v teal">£1,329.3m</div><div class="l">General Fund net budget, 2026/27</div></div>
        <div class="doge-stat"><div class="v">£717.1m</div><div class="l">Council tax requirement, 2026/27</div></div>
        <div class="doge-stat"><div class="v">£17.3m</div><div class="l">Forecast budget gap, 2028/29 (vesting year)</div></div>
        <div class="doge-stat"><div class="v">Score 50</div><div class="l">AI DOGE financial-resilience risk band: elevated</div></div>
      </div>

      <div class="doge-section">
        <h3 class="doge-h2" style="font-size:1.05rem;">Reserves have fallen four years running</h3>
        <p class="doge-note">
          Total usable reserves and the months of net spending they would cover, from the council's MHCLG Revenue
          Outturn returns. The adequacy rating fell from "Adequate" to "Low" over the period.
        </p>
        <div class="doge-panel">
          <div class="doge-bars">
            {RESERVES.map((r) => (
              <div class="dg-row">
                <div class="dg-top">
                  <span class="dg-name">{r.year} · {r.months} months cover · {r.rating}</span>
                  <span class="dg-val">£{r.total.toFixed(1)}m</span>
                </div>
                <div class="dg-track">
                  <div class={`dg-fill${r.rating === 'Low' ? ' amber' : ''}`} style={`width:${(r.total / RES_MAX * 100).toFixed(1)}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <p class="doge-note" style="margin-top:1rem;">
        The Medium Term Financial Strategy closes a £72.298m gross shortfall for 2026/27 and balances 2026/27 and
        2027/28, but still shows a <strong>£17.320m gap in 2028/29</strong> — the very year the new unitaries take
        over. The February 2026 Final Settlement delivered a £28m gain, and the council is building £58.4m of extra
        reserves over three years. The section 151 officer judges reserves adequate; no section 114 warning is in
        prospect. Grant dependency stands at 30% of net revenue, with council tax funding 65%.
      </p>
    </section>

    <!-- What transfers -->
    <section class="doge-section">
      <h2 class="doge-h2">What transfers to the new councils</h2>
      <p class="doge-note">
        Reorganisation moves every asset, contract and payment obligation of the abolished councils to their
        successors. For Lancashire County Council alone, the AI DOGE data pack records:
      </p>
      <div class="doge-statband">
        <div class="doge-stat"><div class="v teal">1,219</div><div class="l">Property &amp; land assets in the county estate register</div></div>
        <div class="doge-stat"><div class="v">1,214</div><div class="l">Live contract award notices</div></div>
        <div class="doge-stat"><div class="v">£3.96bn</div><div class="l">Total value of those awards</div></div>
        <div class="doge-stat"><div class="v">£4.14bn</div><div class="l">Published payments, 2024/25&ndash;2026/27 (855,890 lines)</div></div>
      </div>
      <p class="doge-note" style="margin-top:0.9rem;">
        The property register is compiled from the council's own Local Authority Land List with title, address and
        ownership enrichment — the successor East, North, West and South Lancashire authorities will each inherit
        the assets that sit within their new boundaries.
      </p>
    </section>

    <!-- The operation being merged -->
    <section class="doge-section">
      <h2 class="doge-h2">The operation being merged</h2>
      <p class="doge-note">
        The county's £1,329.312m net budget is dominated by three service blocks — all of which pass to the new
        unitaries. Adult social care alone is 42% of it. These are the operations that must be split across, or
        merged into, the four successor councils (2026/27 net budget by directorate, from the council's own papers).
      </p>
      <div class="doge-panel">
        <div class="doge-bars">
          {SPEND.map((s) => (
            <div class="dg-row">
              <div class="dg-top">
                <span class="dg-name">{s.name}</span>
                <span class="dg-val">£{s.m.toFixed(1)}m</span>
              </div>
              <div class="dg-track">
                <div class="dg-fill" style={`width:${(s.m / SPEND_MAX * 100).toFixed(1)}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="doge-section">
        <h3 class="doge-h2" style="font-size:1.05rem;">The biggest supplier relationships that transfer</h3>
        <p class="doge-note">
          Largest external suppliers by processed spend — the contracts and relationships the successor councils
          inherit. Many are long, multi-year arrangements (waste, PFI schools, homecare frameworks) that cannot
          simply be unwound on vesting day. Lawfully redacted payments to individuals (care packages) are excluded.
        </p>
        <div class="doge-panel">
          <div class="doge-bars">
            {SUPPLIERS.map((s) => (
              <div class="dg-row">
                <div class="dg-top">
                  <span class="dg-name">{s.name}</span>
                  <span class="dg-val">£{s.m.toFixed(1)}m</span>
                </div>
                <div class="dg-track">
                  <div class="dg-fill amber" style={`width:${(s.m / SUP_MAX * 100).toFixed(1)}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <p class="doge-note" style="margin-top:0.9rem;">
          Of the county's <strong>1,214 contract award notices (£3.96bn)</strong>,
          <strong>{C.contractsBeyondVesting.straddleVesting} contracts worth
          £{fmt(Math.round(C.contractsBeyondVesting.straddleValue_m))}m have end dates beyond vesting day</strong> —
          they transfer to the successor councils mid-term. The longest-running include a £204.3m public-health
          nursing contract to 2032, county-wide energy supply to September 2028, waste-recovery services to 2030 and
          an agency-staffing framework to 2029. A new East Lancashire council does not start with a blank page; it
          starts inside a decade of its predecessors' procurement decisions.
        </p>
        <p class="doge-note" style="font-size:0.78rem;">
          Mapping caveats, stated plainly: this register covers <strong>county council contracts only</strong> —
          the twelve districts' and two unitaries' own contracts are not yet mapped; {C.contractsBeyondVesting.noEndDate} notices
          carry no end date, so the £{fmt(Math.round(C.contractsBeyondVesting.straddleValue_m))}m straddling figure is a floor;
          and Contracts Finder values are self-reported at award, not final spend.
        </p>
      </div>
    </section>

    <!-- Compared to what was proposed -->
    <section class="doge-section">
      <h2 class="doge-h2">How this compares to what was proposed</h2>
      <p class="doge-note">
        The government's four-unitary decision matches none of the options that were formally submitted and
        costed during the process. Reform UK at County Hall submitted a <strong>two-unitary</strong> model as the
        best-value option; Burnley and Pendle championed a <strong>five-unitary</strong> model; three-unitary
        variants were also modelled. A four-unitary configuration was the government's own choice — which means the
        transition costs, savings and council-tax harmonisation impact for <em>these specific boundaries</em> have
        not yet been publicly modelled (see gaps below).
      </p>
    </section>

    <!-- Politics -->
    <section class="doge-section">
      <h2 class="doge-h2">The politics of reorganisation</h2>
      <p class="doge-note">
        The county leading this change is <strong>Reform UK-controlled</strong>: at Lancashire County Council,
        Reform holds <strong>53 of 84 seats</strong> (a majority of 22), the administration that inherited the
        reorganisation process and now has to deliver it. The current lower-tier councils are under mixed control —
        mostly Labour-led or in no overall control, with Reform UK the largest party in Burnley. Every one of them
        is abolished on vesting day.
      </p>
      <div class="doge-panel">
        <div class="lgr-timeline">
          <div class="lgr-tl-item">
            <span class="lgr-tl-date">16 Jul 2026</span>
            <span class="lgr-tl-text">Government confirms the four-unitary decision.</span>
          </div>
          <div class="lgr-tl-item">
            <span class="lgr-tl-date">May 2027</span>
            <span class="lgr-tl-text">All-out elections to the four new <strong>shadow authorities</strong> — the first time voters choose who runs North, West, East and South Lancashire.</span>
          </div>
          <div class="lgr-tl-item">
            <span class="lgr-tl-date">2027&ndash;28</span>
            <span class="lgr-tl-text">Shadow councils prepare the handover while the existing 15 keep running services.</span>
          </div>
          <div class="lgr-tl-item">
            <span class="lgr-tl-date">1 Apr 2028</span>
            <span class="lgr-tl-text">Vesting day: the four unitaries take over; the county and all districts cease to exist.</span>
          </div>
        </div>
      </div>
      <p class="doge-note" style="margin-top:0.9rem; font-size:0.8rem;">
        County composition is verified against the council's own member index. Lower-tier control is a May 2026
        snapshot from the elections data platform and is indicative at status level, not a seat-by-seat count.
      </p>
    </section>

    <!-- The Combined Authority layer -->
    <section class="doge-section" id="cca">
      <h2 class="doge-h2">The layer above: the Combined Authority</h2>
      <p class="doge-note">
        Reorganisation is not the whole picture. Lancashire's end-state is <strong>five bodies, not four</strong>:
        the four new unitaries plus the <strong>Lancashire Combined County Authority</strong>, formally launched on
        5 February 2025 with Lancashire County Council, Blackpool and Blackburn with Darwen as constituent members —
        and a mayor promised alongside reorganisation. Strategic functions are already lifting to CCA level:
      </p>
      <div class="doge-statband" style="grid-template-columns: repeat(2, 1fr);">
        <div class="doge-stat"><div class="v teal">£640m</div><div class="l">Four-year transport settlement — the CCA becomes Lancashire's Local Transport Authority from 1 April</div></div>
        <div class="doge-stat"><div class="v teal">£40.8m</div><div class="l">Adult Skills Fund administered by the CCA from August 2026 (previously central government)</div></div>
      </div>
      <p class="doge-note" style="margin-top:0.9rem;">
        The CCA is in its infancy: strategy and funding move up, but <strong>delivery still sits with the county
        and the two existing unitaries</strong> — and after vesting day, with the four successors, whose members
        will make up the CCA. Housing and environmental functions are proposed to follow under the devolution deal.
      </p>
      <p class="doge-note" style="font-size:0.8rem;">
        <strong>What this means for the model:</strong> the combined budgets above describe today's council-run
        services. No published disaggregation yet shows what part of any council's net budget will transfer to the
        CCA (the Adult Skills Fund is new devolved money, not a carve-out from council budgets; the transport
        settlement flows alongside, not out of, them). Until a published split exists, the model deliberately does
        not net anything off — flagged in the gaps below.
      </p>
    </section>

    <!-- Precedents -->
    <section class="doge-section" id="precedents">
      <h2 class="doge-h2">What previous reorganisations actually cost</h2>
      <p class="doge-note">
        Six English reorganisations have completed since 2019. Their record — from official business cases, closure
        reports and assurance reviews — is the best available benchmark for what Lancashire is about to attempt.
        Lancashire's <strong>{model.precedents.lancashire.months} months</strong> from decision to vesting day sits
        almost exactly on the 2023 cohort's 20.3-month track:
      </p>
      <div class="doge-panel">
        <div class="doge-bars">
          {model.precedents.cases.map((c) => (
            <div class="dg-row">
              <div class="dg-top">
                <span class="dg-name">{c.name} · {c.predecessors}→{c.unitaries} councils</span>
                <span class="dg-val">{c.months} months</span>
              </div>
              <div class="dg-track"><div class="dg-fill" style={`width:${(c.months / 24 * 100).toFixed(1)}%`}></div></div>
            </div>
          ))}
          <div class="dg-row">
            <div class="dg-top">
              <span class="dg-name"><strong>Lancashire · 15→4 councils</strong></span>
              <span class="dg-val">{model.precedents.lancashire.months} months</span>
            </div>
            <div class="dg-track"><div class="dg-fill amber" style={`width:${(model.precedents.lancashire.months / 24 * 100).toFixed(1)}%`}></div></div>
          </div>
        </div>
      </div>

      <div class="lgr-prec-grid">
        {model.precedents.cases.map((c) => (
          <div class="lgr-prec-card">
            <div class="lgr-prec-name">{c.name}</div>
            <div class="lgr-prec-row"><span>Transition budgeted</span><b>£{c.transition.budgeted_m}m</b></div>
            <div class="lgr-prec-row"><span>Transition actual</span><b>{c.transition.actual_m ? `£${c.transition.actual_m}m` : 'not published'}</b></div>
            <div class="lgr-prec-row"><span>Savings projected</span><b>{c.savings.projected}</b></div>
            <div class="lgr-prec-row"><span>Savings realised</span><b>{c.savings.realised}</b></div>
            <p class="lgr-prec-note">{c.notable}</p>
          </div>
        ))}
      </div>

      <div class="doge-panel" style="margin-top:1.1rem;">
        <div class="lgr-mx-build-h">What the precedents imply for Lancashire</div>
        <p class="doge-note" style="margin:0.4rem 0 0.6rem;">
          Budgeted transition costs ran at <strong>£{model.precedents.lancashire.perResidentEnvelope.low_gbp}–£{model.precedents.lancashire.perResidentEnvelope.high_gbp}
          per resident</strong> across the six cases. Applied to Lancashire's {fmt(model.precedents.lancashire.population)} residents, that implies a transition envelope of roughly
          <strong>£{model.precedents.lancashire.impliedTransition_m.low}m–£{model.precedents.lancashire.impliedTransition_m.high}m</strong> — before disaggregation risk.
          {model.precedents.lancashire.keyRisk}. No official costing for the four-unitary configuration has been published; this envelope is a precedent-based read-across, not a forecast.
        </p>
        <p class="doge-note" style="margin:0; font-size:0.82rem;">
          <strong>The workforce warning from 2023:</strong> {model.precedents.equalPay.cumbriaClaim.fact}. In Somerset,
          staff were {model.precedents.equalPay.somerset.fact.split('(')[0].toLowerCase().replace('workforce still', 'still')} — while
          North Yorkshire avoided the trap by completing a single job-evaluated pay structure <em>before</em> vesting.
          Birmingham shows the downside when harmonisation goes wrong: {model.precedents.equalPay.birmingham.liability}.
        </p>
      </div>
    </section>

    <!-- Gaps -->
    <section class="doge-section">
      <h2 class="doge-h2">What isn't confirmed yet</h2>
      <p class="doge-note">
        In keeping with the rule that every published figure must be traceable, these items are not yet verified
        against a published source and are deliberately left open rather than estimated:
      </p>
      <div class="doge-panel">
        <ul class="lgr-gaps">
          <li><strong>Official transition costing</strong> for the four-unitary configuration — none has been published. The £50m–£100m envelope above is a precedent read-across, not a government figure.</li>
          <li><strong>How council tax will actually be harmonised</strong> — the gaps per unitary are quantified above, but the harmonisation path (level, speed, direction) is a decision for the shadow councils and government; no scheme has been published.</li>
          <li><strong>Balance-sheet disaggregation</strong> — how LCC's assets, debt (including the bond portfolio), reserves and the £17.3m 2028/29 gap will be split across four successors is not yet determined; Northamptonshire's £953m dispute shows how contested this can be.</li>
          <li><strong>A few Band D figures</strong> (Lancaster, Preston, Ribble Valley, Fylde, Chorley) are sourced from budget papers but await confirmation against the formal council-tax resolution — marked medium-confidence in the data feed.</li>
          <li><strong>The Combined Authority split</strong> — which functions (and what money) end up at CCA rather than unitary level is still being settled; the model's combined budgets will need a CCA carve-out once a published disaggregation exists.</li>
        </ul>
      </div>
    </section>

    <!-- Sources -->
    <section class="doge-section">
      <h2 class="doge-h2">Sources</h2>
      <p class="doge-note" style="font-size:0.8rem;">
        Decision and council groupings: Lancashire County Council / MHCLG news release, 16 July 2026, and
        lancashirelgr.co.uk. Lancashire County Council finances: the council's own 2026/27 budget report (Full
        Council, 26 February 2026) and GOV.UK / MHCLG Revenue Outturn returns, compiled and verified in the AI DOGE
        Lancashire data pack (aidoge.co.uk). Reserves, resilience, contracts and property figures are drawn from
        published transparency data. Population per unitary is summed from ONS Census 2021 per-authority totals.
        Spend by directorate and largest suppliers are from the AI DOGE Lancashire pack. Each constituent council's
        net budget and Band D figure is sourced from its own 2026/27 budget papers or council-tax resolution.
        Precedent figures come from MHCLG decision documents, council business cases, KPMG/CIPFA closure and
        assurance reviews, Hansard and audited accounts. Lower-tier political control is a May 2026 snapshot from
        the elections data platform (indicative at status level). Verify against the primary source before any
        formal use. <strong>The full model — every input, its source and its confidence rating — is published as
        open data at <a href="/data/lgr-model.json">/data/lgr-model.json</a>.</strong>
      </p>
    </section>
  </div>
</Layout>

<script>
  function initModelExplorer() {
    const mx = document.querySelector('.lgr-mx');
    if (!mx) return;
    const tabs = Array.from(mx.querySelectorAll('.lgr-mx-tab'));
    const panels = Array.from(mx.querySelectorAll('.lgr-mx-panel'));
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const i = tab.getAttribute('data-i');
        tabs.forEach((t) => t.classList.toggle('active', t === tab));
        panels.forEach((p) => p.classList.toggle('active', p.getAttribute('data-i') === i));
      });
    });
  }
  initModelExplorer();
  document.addEventListener('astro:page-load', initModelExplorer);
</script>


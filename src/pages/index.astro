---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AudiencePaths from '../components/AudiencePaths.astro';
import ComparisonBar from '../components/ComparisonBar.astro';
import TrustCertificate from '../components/TrustCertificate.astro';
import NewsCard from '../components/NewsCard.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import EmailSignup from '../components/EmailSignup.astro';
import Sources from '../components/Sources.astro';
import Cite from '../components/Cite.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// The four new unitaries (from the LGR model) for the homepage showcase.
const LGR_UNITS = [
  { name: 'East Lancashire', accent: 'var(--chart-2)', pop: '498,255', councils: 5, home: true },
  { name: 'North Lancashire', accent: 'var(--chart-1)', pop: '352,338', councils: 3 },
  { name: 'South Lancashire', accent: 'var(--chart-4)', pop: '346,197', councils: 3 },
  { name: 'West Lancashire', accent: 'var(--chart-3)', pop: '334,360', councils: 3 },
];
---

<Layout
  title="Tom Pickup | Lancashire County Councillor for Padiham & Burnley West"
  description="Reform UK county councillor for Padiham and Burnley West, Cabinet Member for Adult Social Care. Investigations into how Lancashire spends public money."
>
  <!-- Section 1: Hero -->
  <Hero />

  <!-- Section 1b: Audience paths (resident / press / data) -->
  <AudiencePaths />

  <!-- Section 2: What We've Delivered -->
  <section class="achievements-section">
    <div class="container">
      <ScrollReveal>
        <div class="section-header">
          <h2 class="section-heading">The First Year, in Three Numbers</h2>
          <p class="section-subtitle">Reform took control of Lancashire County Council in May 2025. Each figure below traces to a published council document.</p>
        </div>

        <div class="achievements-grid stagger-children">
          <div class="achievement-card">
            <div class="achievement-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
            </div>
            <div class="achievement-stat">3.80%</div>
            <h3 class="achievement-title">Lowest Council Tax Rise Since 2015/16</h3>
            <p class="achievement-desc">Every county council budget from 2016/17 to 2025/26 raised council tax by 3.99% or more, peaking at 5.99% in 2018/19. The 2026/27 budget set 3.80%.<Cite n={2} /><Cite n={3} /></p>
            <span class="achievement-before">2025/26: 4.99%</span>
          </div>

          <div class="achievement-card">
            <div class="achievement-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 7c-1-2-3.5-3-6-3-3.3 0-6 2.7-6 6 0 1.5.5 2.8 1.3 3.8"></path><path d="M4 17h12"></path><path d="M4 13h8"></path><path d="M10 7v14"></path></svg>
            </div>
            <div class="achievement-stat">&pound;27.9M &rarr; &pound;2.99M</div>
            <h3 class="achievement-title">Overspend Nearly Eliminated</h3>
            <p class="achievement-desc">At the first quarter of 2025/26 the council forecast a &pound;27.9 million overspend. The year closed &pound;2.99 million over on a &pound;1.24 billion budget: an 89% reduction, and 0.24% off balance.<Cite n={1} /></p>
            <span class="achievement-before">Quarter 1 forecast: &pound;27.9M overspend</span>
          </div>

          <div class="achievement-card">
            <div class="achievement-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </div>
            <div class="achievement-stat">&pound;350M</div>
            <h3 class="achievement-title">The Cost of Selling the Bonds</h3>
            <p class="achievement-desc">The council has &pound;519M invested in government and commercial bonds.<Cite n={5} /> Its 2026/27 treasury strategy says an immediate sale of all of them would realise a loss of some &pound;350M.<Cite n={6} /></p>
            <span class="achievement-before">Treasury Management Strategy 2026/27, para 29</span>
          </div>
        </div>

      </ScrollReveal>
    </div>
  </section>

  <!-- Section 3: Reform vs Conservative -->
  <section class="comparison-section">
    <div class="container">
      <ScrollReveal>
        <div class="comparison-card">
          <div class="comparison-header">
            <span class="badge badge-teal">Lancashire County Council</span>
            <h2 class="comparison-title">Savings Agreed, Savings Missed</h2>
            <p class="comparison-subtitle">A savings plan is a promise made in a budget. This is the share that actually landed.</p>
          </div>

          <div class="comparison-bars">
            <ComparisonBar
              title="Savings Delivery Rate"
              reformLabel="2025/26"
              reformValue="98%"
              reformPercent={98}
              conLabel="2024/25"
              conValue="48%"
              conPercent={48}
              annotation="2025/26: savings delivered, including mitigations where the original saving was delayed (80% delivered on a lasting basis). 2024/25: savings delivered against the original budget; the report gives no figure including mitigations."
            />
            <p class="comparison-sources">Sources<Cite n={7} /><Cite n={8} /></p>
          </div>

          <div class="comparison-trust">
            <TrustCertificate />
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- Section 3b: LGR model showcase -->
  <section class="lgr-teaser-section">
    <div class="container">
      <ScrollReveal>
        <div class="lgr-show">
          <div class="lgr-show-head">
            <div>
              <span class="lgr-teaser-eyebrow"><span class="dot"></span> Local Government Reorganisation</span>
              <h2 class="lgr-teaser-title">Lancashire is being redrawn</h2>
              <p class="lgr-teaser-copy">
                On 16 July 2026 the government decided Lancashire's 15 councils would be replaced by four new unitary
                authorities from April 2028. The programme was paused for review on 7 September 2026. I've built an interactive model of what each one would be: who it
                merges, the budget it would run and how its places compare. Every figure sourced.
              </p>
            </div>
            <div class="lgr-teaser-stats">
              <div class="lgr-teaser-stat"><span class="v">15&rarr;4</span><span class="l">Councils replaced</span></div>
              <div class="lgr-teaser-stat"><span class="v">2028</span><span class="l">Plan now paused</span></div>
            </div>
          </div>

          <div class="lgr-show-grid">
            {LGR_UNITS.map((u) => (
              <a href="/lgr/#model" class="lgr-show-card" style={`--accent:${u.accent}`}>
                <span class="lgr-show-name">{u.name}</span>
                <span class="lgr-show-pop">{u.pop}</span>
                <span class="lgr-show-meta">{u.councils} councils merged{u.home ? ' · incl. Burnley' : ''}</span>
              </a>
            ))}
          </div>

          <a href="/lgr/" class="lgr-show-cta">
            Explore the interactive model
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- Section 4: Latest News -->
  <section class="news-section">
    <div class="container">
      <ScrollReveal>
        <div class="section-header">
          <h2 class="section-heading">Latest News</h2>
        </div>

        {posts.length > 0 ? (
          <div class="news-grid stagger-children">
            {posts.map((post) => (
              <NewsCard
                title={post.data.title}
                date={post.data.date.toISOString()}
                description={post.data.description}
                tags={post.data.tags}
                slug={post.id}
                image={post.data.image}
              />
            ))}
          </div>
        ) : (
          <p class="empty-state text-secondary">No posts yet. Check back soon.</p>
        )}

        <div class="news-more">
          <a href="/news/" class="btn-secondary">
            View all news
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- Section 7: Email Signup -->
  <section class="signup-section">
    <div class="container">
      <ScrollReveal>
        <EmailSignup variant="inline" />
      </ScrollReveal>
    </div>
  </section>

  <!-- Section 8: Contact CTA -->
  <section class="contact-cta-section">
    <div class="container">
      <ScrollReveal>
        <div class="contact-cta-card">
          <div class="contact-cta-lines"></div>
          <div class="contact-cta-inner">
            <h2>Have a Question or Concern?</h2>
            <p>
              I'm here to help. Whether it's a local issue, a question about council decisions, or
              you just want to say hello, get in touch.
            </p>
            <div class="contact-cta-actions">
              <a href="/contact/" class="cta-btn-white">Contact Me</a>
              <a href="/contact/#get-in-touch" class="cta-btn-ghost">How to Reach Me</a>
            </div>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  {/* Numbered sources for every figure on this page, in the order first cited. */}
  <section class="home-sources">
    <div class="container">
      <Sources items={[
        {
          text: "Lancashire County Council, 'The County Council's Financial Position - 2025/26 Outturn', Cabinet report, p. 1, 2 July 2026",
          url: 'https://council.lancashire.gov.uk/documents/s281026/Report.pdf',
        },
        {
          text: 'Lancashire County Council, Full Council (budget meeting) minutes, p. 8, 26 February 2026',
          url: 'https://council.lancashire.gov.uk/documents/g15424/Public%20minutes%2026th-Feb-2026%2013.00%20Full%20Council.pdf?T=11',
        },
        {
          text: "MHCLG, 'Band D Council Tax figures 1993 onwards', Table 4 (percentage change), Lancashire row, 2026-27 edition",
          url: 'https://www.gov.uk/government/statistical-data-sets/live-tables-on-council-tax',
        },
        {
          text: 'Lancashire County Council, councillors by political party, checked 28 September 2026',
          url: 'https://council.lancashire.gov.uk/mgMemberIndex.aspx?VW=TABLE&PIC=1&FN=PARTY',
        },
        {
          text: "Lancashire County Council, 'Budget Report 2026/27', Full Council, p. 13, 26 February 2026",
          url: 'https://council.lancashire.gov.uk/documents/s272627/Report.pdf',
        },
        {
          text: "Lancashire County Council, 'Treasury Management Strategy 2026/27', para. 29, p. 6",
          url: 'https://council.lancashire.gov.uk/documents/s270741/Appendix%20A.pdf',
        },
        {
          text: "Lancashire County Council, 'The County Council's Financial Position - 2024/25 Outturn', Cabinet report, p. 1, 10 July 2025",
          url: 'https://council.lancashire.gov.uk/documents/s259171/Report.pdf',
        },
        {
          text: "Lancashire County Council, 'The County Council's Financial Position - 2025/26 Outturn', Cabinet report, p. 4, 2 July 2026",
          url: 'https://council.lancashire.gov.uk/documents/s281026/Report.pdf',
        },
      ]} />
    </div>
  </section>
</Layout>

<style>
  .home-sources {
    padding: 0 0 var(--space-2xl);
  }

  .achievements-section,
  .news-section,
  .comparison-section {
    padding: var(--space-2xl) 0;
  }

  .signup-section {
    padding: 0 0 var(--space-xl);
  }

  .contact-cta-section {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .section-header {
    margin-bottom: var(--space-lg);
  }

  .section-subtitle {
    color: var(--muted);
    font-size: 1.125rem;
    margin-top: var(--space-sm);
    max-width: 60ch;
  }

  /* ---- The first year, in three numbers ---- */
  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .achievement-card {
    padding-top: var(--space-md);
    border-top: 2px solid var(--ink);
  }

  .achievement-icon {
    display: none;
  }

  .achievement-stat {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variant-numeric: tabular-nums lining-nums;
    line-height: 1.1;
    margin-bottom: 8px;
  }

  .achievement-title {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--ink);
    margin: 0 0 var(--space-sm);
    line-height: 1.3;
  }

  .achievement-desc {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0 0 var(--space-sm);
  }

  .achievement-before {
    display: inline-block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--muted);
  }

  /* ---- Savings agreed, savings missed ---- */
  .comparison-card {
    background: var(--panel);
    border-top: 3px solid var(--teal);
    border-radius: var(--radius-sm);
    padding: var(--space-xl);
  }

  .comparison-header {
    margin-bottom: var(--space-lg);
  }

  .comparison-title {
    font-size: clamp(1.625rem, 3vw, 2.125rem);
    margin: var(--space-sm) 0 var(--space-xs);
  }

  .comparison-subtitle {
    font-size: 1.0625rem;
    color: var(--muted);
  }

  .comparison-bars {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .comparison-sources {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  /* ---- Latest news ---- */
  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .news-more {
    margin-top: var(--space-lg);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-2xl) var(--space-lg);
  }

  /* ---- Contact ---- */
  .contact-cta-card {
    position: relative;
    background: var(--ink);
    border-radius: var(--radius-sm);
    padding: var(--space-2xl) var(--space-xl);
  }

  .contact-cta-lines {
    display: none;
  }

  .contact-cta-inner {
    max-width: 640px;
  }

  .contact-cta-inner h2 {
    color: var(--paper);
    margin-bottom: var(--space-sm);
  }

  .contact-cta-inner p {
    color: #c5d1d0;
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 0 0 var(--space-lg);
  }

  .contact-cta-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .cta-btn-white,
  .cta-btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch);
    padding: 0 1.5rem;
    font-weight: 600;
    font-size: 1rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .cta-btn-white {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--paper);
  }

  .cta-btn-white:hover {
    background: #e7ece9;
    color: var(--ink);
  }

  .cta-btn-ghost {
    color: var(--paper);
    border: 1px solid #5b7076;
  }

  .cta-btn-ghost:hover {
    border-color: var(--paper);
    color: var(--paper);
  }

  @media (max-width: 768px) {
    .achievements-grid,
    .news-grid {
      grid-template-columns: 1fr;
    }

    .achievements-section,
    .news-section,
    .comparison-section {
      padding: var(--space-xl) 0;
    }

    .comparison-card {
      padding: var(--space-lg) 18px;
    }

    .contact-cta-card {
      padding: var(--space-xl) 18px;
    }

    .contact-cta-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .achievement-stat {
      font-size: 1.875rem;
    }
  }
</style>

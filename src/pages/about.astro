---
import Layout from '../layouts/Layout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import EmailSignup from '../components/EmailSignup.astro';
---

<Layout
  title="About | Tom Pickup"
  description="About Tom Pickup."
>
  <!-- Section 1: Page Header + Bio -->
  <section class="page-header-section">
    <div class="container">
      <div class="bio-grid">
        <div class="bio-photo-wrap">
          <div class="bio-photo-glow"></div>
          <div class="bio-photo">
            <img src="/images/headshot.jpg" alt="Tom Pickup, Reform UK county councillor for Padiham and Burnley West" loading="eager" decoding="async" width="240" height="240" />
          </div>
        </div>

        <div class="bio-text">
          <h1>Tom <span class="gradient-text">Pickup</span></h1>

          <div class="bio-body">
            <p>
              I'm the Reform UK county councillor for <strong>Padiham and Burnley West</strong>,
              elected to Lancashire County Council in May 2025. Since May 2026 I've served as the
              council's <strong>Cabinet Member for Adult Social Care</strong>.
            </p>
            <p>
              I grew up in this area, and I care about transparency, accountability, and getting
              value out of public money. Before Adult Social Care I led on the council's finances
              and efficiency. Whatever the brief, the approach stays the same.
            </p>
            <p>
              I dig into the numbers and I ask the questions that need asking. The people paying
              the bills have a right to know where their money goes.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Council Roles -->
  <section class="roles-section">
    <div class="container">
      <ScrollReveal>
        <div class="roles-card card">
          <h2>My Council Work</h2>
          <p class="roles-intro">
            Alongside the Adult Social Care portfolio, my work at County Hall runs across
            these committees and appointments.
          </p>
          <ul class="roles-list">
            <li>
              <strong>Cabinet</strong>
              <span>Cabinet Member for Adult Social Care.</span>
            </li>
            <li>
              <strong>Company Member Cabinet Committee</strong>
              <span>The council's shareholder role in the companies it owns.</span>
            </li>
            <li>
              <strong>Lancashire Health and Wellbeing Board</strong>
              <span>Where the council and the NHS set shared health priorities.</span>
            </li>
            <li>
              <strong>Edward Stocks Massey Bequest Fund</strong>
              <span>Joint Advisory Committee, awarding grants for the benefit of Burnley.</span>
            </li>
            <li>
              <strong>Arthur Edmondson Quinn Bequest</strong>
              <span>A further Burnley charitable trust the council nominates to.</span>
            </li>
            <li>
              <strong>Full Council</strong>
              <span>County Councillor for the Padiham and Burnley West division.</span>
            </li>
          </ul>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- Section 2: Accessibility Statement -->
  <section class="accessibility-section" id="accessibility">
    <div class="container-narrow">
      <ScrollReveal>
        <div class="accessibility-card card">
          <h2>Accessibility Statement</h2>
          <p>
            This website aims to be accessible to as many people as possible, in line with
            <strong>WCAG 2.1 Level AA</strong> guidelines. The site is built with semantic HTML,
            supports keyboard navigation, provides sufficient colour contrast, and respects user
            preferences for reduced motion.
          </p>
          <p>
            If you encounter any accessibility issues or have suggestions for improvement,
            please <a href="/contact/">get in touch</a>. I take accessibility seriously and
            will work to resolve any barriers as quickly as possible.
          </p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- Section 3: Email signup -->
  <section class="signup-section">
    <div class="container-narrow">
      <EmailSignup variant="inline" />
    </div>
  </section>
</Layout>

<style>
  /* ---- Bio Header Section ---- */
  .page-header-section {
    padding: 7rem 0 var(--space-xl);
  }

  .bio-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  /* Photo */
  .bio-photo-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .bio-photo-glow {
    position: absolute;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(18, 182, 207, 0.2) 0%, transparent 70%);
    filter: blur(40px);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -55%);
    pointer-events: none;
  }

  .bio-photo {
    position: relative;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid rgba(18, 182, 207, 0.3);
    box-shadow: 0 0 40px rgba(18, 182, 207, 0.15), 0 20px 60px rgba(0, 0, 0, 0.4);
  }

  .bio-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Bio text */
  .bio-text h1 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: #fff;
    margin: 0 0 var(--space-lg);
  }

  .bio-body p {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.75;
    margin-bottom: var(--space-md);
  }

  .bio-body p:last-child {
    margin-bottom: 0;
  }

  /* ---- Council Roles ---- */
  .roles-section {
    padding: 0 0 var(--space-xl);
  }

  .roles-card {
    border-left: 3px solid var(--accent);
  }

  .roles-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }

  .roles-intro {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .roles-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .roles-list li {
    position: relative;
    padding-left: 18px;
  }

  .roles-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.7;
  }

  .roles-list strong {
    display: block;
    font-size: 0.9375rem;
    font-weight: 650;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .roles-list span {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 2px;
  }

  /* ---- Accessibility ---- */
  .accessibility-section {
    padding: 0 0 var(--space-xl);
  }

  /* ---- Email signup ---- */
  .signup-section {
    padding: 0 0 var(--space-2xl);
  }

  .accessibility-card {
    border-left: 3px solid var(--accent);
  }

  .accessibility-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .accessibility-card p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  .accessibility-card p:last-child {
    margin-bottom: 0;
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .page-header-section {
      padding: 6rem 0 var(--space-lg);
    }

    .bio-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
      text-align: center;
    }

    .bio-photo-wrap {
      order: -1;
    }

    .bio-photo {
      width: 200px;
      height: 200px;
    }

    .bio-photo-glow {
      width: 240px;
      height: 240px;
    }

    .bio-body p {
      text-align: left;
    }

    .roles-list {
      grid-template-columns: 1fr;
      text-align: left;
    }
  }

  @media (max-width: 480px) {
    .bio-photo {
      width: 160px;
      height: 160px;
    }

    .bio-photo-glow {
      width: 200px;
      height: 200px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bio-photo-glow {
      display: none;
    }
  }
</style>

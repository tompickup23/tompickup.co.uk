---
import Layout from '../layouts/Layout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import EmailSignup from '../components/EmailSignup.astro';
import Cite from '../components/Cite.astro';
import Sources from '../components/Sources.astro';
import { person } from '../data/person';

const title = 'About Tom Pickup | Tom Pickup';
const description =
  'Tom Pickup, Lancashire County Councillor for Padiham and Burnley West and Cabinet Member for Adult Social Care: career, council roles and sources.';

const LCC = 'https://council.lancashire.gov.uk';

/* Numbered in the order they are first cited on the page. */
const sources = [
  { text: "Dunnockshaw Parish Council, 'Your Councillors', parish councillors list, checked 28 September 2026", url: 'https://dunnockshawpc.weebly.com/your-councillors.html' },
  { text: "Lancashire County Council, 'Change to a Cabinet Appointment', Leader's decision, 20 May 2026", url: `${LCC}/ieDecisionDetails.aspx?ID=29999` },
  { text: "Ministry of Housing, Communities and Local Government, 'Local authority revenue expenditure and financing England: 2024 to 2025 individual local authority data - outturn', RSX, Adult Social Care Total Expenditure (C3), updated 11 June 2026", url: 'https://www.gov.uk/government/statistics/local-authority-revenue-expenditure-and-financing-england-2024-to-2025-individual-local-authority-data-outturn' },
  { text: "Lancashire County Council, 'Appointment of a Cabinet, Lead Members, Champions and Other Positions', report, p. 3, 22 May 2025", url: `${LCC}/documents/s256315/Report.pdf` },
  { text: "Lancashire County Council, 'The County Council's Financial Position - 2025/26 Outturn', Cabinet report, p. 1, 2 July 2026", url: `${LCC}/documents/s281026/Report.pdf` },
  { text: 'Lancashire County Council, Cabinet minutes, p. 1, 4 June 2026', url: `${LCC}/documents/g16271/Printed%20minutes%2004th-Jun-2026%2014.00%20Cabinet.pdf?T=1` },
  { text: 'Lancashire County Council, Company Member Cabinet Committee minutes, p. 1, 26 June 2025', url: `${LCC}/documents/g15346/Printed%20minutes%2026th-Jun-2025%2011.00%20Company%20Member%20Cabinet%20Committee.pdf?T=1` },
  { text: 'Lancashire Combined County Authority, Audit and Governance Committee minutes, p. 2, 22 September 2025', url: `${LCC}/documents/g15780/Printed%20minutes%2022nd-Sep-2025%2015.00%20Lancashire%20Combined%20County%20Authority%20-%20Audit%20and%20Governance%20Co.pdf?T=1` },
  { text: "Lancashire County Council, 'Lancashire Health and Wellbeing Board Membership', Full Council, Appendix A, p. 1, 16 July 2026", url: `${LCC}/documents/s282483/Appendix%20A.pdf` },
  { text: "Lancashire County Council, 'List of Outside Bodies and Appointments', Cabinet, Appendix A, p. 3, 5 June 2025", url: `${LCC}/documents/s256601/Appendix%20A.pdf` },
  { text: 'Lancashire Combined County Authority, Overview and Scrutiny Committee minutes, p. 1, 28 July 2025', url: `${LCC}/documents/g15778/Printed%20minutes%2028th-Jul-2025%2015.00%20Lancashire%20Combined%20County%20Authority%20-%20Overview%20and%20Scrutiny%20C.pdf?T=1` },
  { text: 'Lancashire County Council, Pension Fund Committee minutes, p. 1, 23 January 2026', url: `${LCC}/documents/g16599/Printed%20minutes%2023rd-Jan-2026%2014.00%20Pension%20Fund%20Committee.pdf?T=1` },
  { text: 'Lancashire County Council, Pension Fund Committee minutes, p. 2, 19 June 2026', url: `${LCC}/documents/g16280/Printed%20minutes%2019th-Jun-2026%2010.00%20Pension%20Fund%20Committee.pdf?T=1` },
  { text: "Pickup, T. (2026) 'The Financial Case for Local Government Reorganisation in Lancashire: A Transparent Component Model of Five Structural Proposals, with a Postscript on the 2026 Decisions', working paper, version 3.1, Zenodo, 28 September 2026, doi:10.5281/zenodo.23016761", url: 'https://doi.org/10.5281/zenodo.23016761' },
];

/* Each role links to its council page; `cites` are numbers in the list above. */
type Role = {
  name: string;
  url: string;
  detail: string;
  cites?: number[];
};

const current: Role[] = [
  { name: 'Cabinet', url: `${LCC}/mgCommitteeDetails.aspx?ID=122`, detail: 'Cabinet Member for Adult Social Care, 2026/27.', cites: [2, 6] },
  { name: 'Company Member Cabinet Committee', url: `${LCC}/mgCommitteeDetails.aspx?ID=1876`, detail: 'Member since 2025.', cites: [7] },
  { name: 'Lancashire Combined County Authority Audit and Governance Committee', url: `${LCC}/mgCommitteeDetails.aspx?ID=1989`, detail: 'Member since 2025.', cites: [8] },
  { name: 'Lancashire Health and Wellbeing Board', url: `${LCC}/mgCommitteeDetails.aspx?ID=825`, detail: 'Member, 2026/27.', cites: [9] },
  { name: 'Local Councillor Decision, Padiham and Burnley West', url: `${LCC}/mgExecPostDetails.aspx?ID=363`, detail: 'Decision maker for the division.' },
  { name: 'Edward Stocks Massey Bequest Fund Joint Advisory Committee', url: `${LCC}/mgOutsideBodyDetails.aspx?ID=589`, detail: 'Chair.', cites: [10] },
  { name: 'Arthur Edmondson Quinn Bequest', url: `${LCC}/mgOutsideBodyDetails.aspx?ID=433`, detail: 'Council representative.' },
  { name: 'Dunnockshaw & Clowbridge Parish Council', url: 'https://burnley.moderngov.co.uk/mgParishCouncilDetails.aspx?ID=181', detail: 'Parish Councillor.', cites: [1] },
];

const previous: Role[] = [
  { name: 'Lead Member for Finance and Resources', url: `${LCC}/ieDecisionDetails.aspx?ID=27678`, detail: '2025/26.', cites: [4] },
  { name: 'Lancashire Combined County Authority Overview and Scrutiny Committee', url: `${LCC}/mgCommitteeDetails.aspx?ID=1990`, detail: 'Member, 2025/26.', cites: [11] },
  { name: 'Pension Fund Committee', url: `${LCC}/mgCommitteeDetails.aspx?ID=183`, detail: 'Member, 2026.', cites: [12, 13] },
];

const schema = {
  '@type': 'ProfilePage',
  '@id': 'https://tompickup.co.uk/about/',
  url: 'https://tompickup.co.uk/about/',
  name: title,
  description,
  inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://tompickup.co.uk/#website' },
  mainEntity: person,
};
---

<Layout title={title} description={description} schema={schema} breadcrumbLabel="About">
  <section class="page-header-section">
    <div class="container">
      <div class="bio-grid">
        <div class="bio-photo-wrap">
          <div class="bio-photo-glow"></div>
          <div class="bio-photo">
            <img src="/images/headshot.jpg" alt="Tom Pickup, Reform UK county councillor for Padiham and Burnley West" loading="eager" decoding="async" width="240" height="240" />
          </div>
        </div>

        <div class="bio-text">
          <h1>Tom <span class="gradient-text">Pickup</span></h1>

          <div class="bio-body">
            <p>
              I'm the Reform UK county councillor for Padiham and Burnley West, elected to
              Lancashire County Council in 2025, and a parish councillor for Dunnockshaw &amp;
              Clowbridge.<Cite n={1} /> I'm the council's Cabinet Member for Adult Social Care
              for 2026/27,<Cite n={2} /> the third-biggest adult social care portfolio in
              England: in 2024/25 the council's gross spending on adult social care was
              &pound;829.3 million, behind only Kent and Essex.<Cite n={3} />
            </p>
            <p>
              I was Lead Member for Finance and Resources in 2025/26.<Cite n={4} /> That year
              the council's forecast overspend fell from &pound;27.9 million at the first quarter
              to a final outturn of &pound;2.99 million.<Cite n={5} />
            </p>
            <p>
              Before elected office I was a consultant to businesses, helping them cut costs and
              raise profits through software, energy, procurement and more. I also worked in
              procurement inside Lancashire County Council, on construction and assets.
            </p>
            <p>
              Since 2025 I've built a set of open-source public data sites, listed on the
              <a href="/projects/">projects page</a>, and written an
              <a href="https://doi.org/10.5281/zenodo.23016761">independent working paper</a> on
              the financial modelling of local government reorganisation in Lancashire.<Cite n={14} />
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="roles-section">
    <div class="container">
      <ScrollReveal>
        <div class="roles-card card">
          <h2>Committees and appointments</h2>
          <p class="roles-intro">
            Each entry links to the council's record. My full member profile is on
            <a href="https://council.lancashire.gov.uk/mgUserInfo.aspx?UID=33781">Lancashire County Council's website</a>.
          </p>

          <h3 class="roles-subhead">Current</h3>
          <ul class="roles-list">
            {current.map((role) => (
              <li>
                <strong><a href={role.url}>{role.name}</a></strong>
                <span>{role.detail}{role.cites?.map((n) => <Cite n={n} />)}</span>
              </li>
            ))}
          </ul>

          <h3 class="roles-subhead">Previous</h3>
          <ul class="roles-list">
            {previous.map((role) => (
              <li>
                <strong><a href={role.url}>{role.name}</a></strong>
                <span>{role.detail}{role.cites?.map((n) => <Cite n={n} />)}</span>
              </li>
            ))}
          </ul>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <section class="accessibility-section" id="accessibility">
    <div class="container-narrow">
      <ScrollReveal>
        <div class="accessibility-card card">
          <h2>Accessibility statement</h2>
          <p>
            This website aims to be accessible to as many people as possible, in line with
            <strong>WCAG 2.1 Level AA</strong> guidelines. The site is built with semantic HTML,
            supports keyboard navigation, provides sufficient colour contrast, and respects user
            preferences for reduced motion.
          </p>
          <p>
            If you encounter any accessibility issues or have suggestions for improvement,
            please <a href="/contact/">get in touch</a>. I take accessibility seriously and
            will work to resolve any barriers as quickly as possible.
          </p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <section class="signup-section">
    <div class="container-narrow">
      <EmailSignup variant="inline" />
    </div>
  </section>

  <section class="sources-section">
    <div class="container">
      <Sources items={sources} />
    </div>
  </section>
</Layout>

<style>
  /* ---- Bio Header Section ---- */
  .page-header-section {
    padding: 7rem 0 var(--space-xl);
  }

  .bio-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  /* Photo */
  .bio-photo-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .bio-photo-glow {
    position: absolute;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    display: none;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -55%);
    pointer-events: none;
  }

  .bio-photo {
    position: relative;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .bio-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Bio text */
  .bio-text h1 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0 0 var(--space-lg);
  }

  .bio-body p {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.75;
    margin-bottom: var(--space-md);
  }

  .bio-body p:last-child {
    margin-bottom: 0;
  }

  .bio-body a,
  .roles-card a {
    color: var(--accent);
    text-decoration: none;
  }

  .bio-body a:hover,
  .roles-card a:hover {
    text-decoration: underline;
  }

  /* ---- Council Roles ---- */
  .roles-section {
    padding: 0 0 var(--space-xl);
  }

  .roles-card {
    border-left: 3px solid var(--accent);
  }

  .roles-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }

  .roles-subhead {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin: var(--space-lg) 0 var(--space-md);
  }

  .roles-intro {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 0;
  }

  .roles-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .roles-list li {
    position: relative;
    padding-left: 18px;
  }

  .roles-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.7;
  }

  .roles-list strong {
    display: block;
    font-size: 0.9375rem;
    font-weight: 650;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .roles-list strong a {
    color: var(--text-primary);
  }

  .roles-list span {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 2px;
  }

  /* ---- Accessibility ---- */
  .accessibility-section {
    padding: 0 0 var(--space-xl);
  }

  /* ---- Email signup ---- */
  .signup-section {
    padding: 0 0 var(--space-xl);
  }

  .sources-section {
    padding: 0 0 var(--space-2xl);
  }

  .accessibility-card {
    border-left: 3px solid var(--accent);
  }

  .accessibility-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .accessibility-card p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  .accessibility-card p:last-child {
    margin-bottom: 0;
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .page-header-section {
      padding: 6rem 0 var(--space-lg);
    }

    .bio-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
      text-align: center;
    }

    .bio-photo-wrap {
      order: -1;
    }

    .bio-photo {
      width: 200px;
      height: 200px;
    }

    .bio-photo-glow {
      width: 240px;
      height: 240px;
    }

    .bio-body p {
      text-align: left;
    }

    .roles-list {
      grid-template-columns: 1fr;
      text-align: left;
    }
  }

  @media (max-width: 480px) {
    .bio-photo {
      width: 160px;
      height: 160px;
    }

    .bio-photo-glow {
      width: 200px;
      height: 200px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bio-photo-glow {
      display: none;
    }
  }
</style>

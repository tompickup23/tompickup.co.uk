---
import Layout from '../../../../layouts/Layout.astro';
import BizFooter from '../../../../components/BizFooter.astro';
import '../../../../styles/doge.css';
import '../../../../styles/lgr.css';
---

<Layout
  title="Companies in the Observatory: the profiled firms | Lancashire Business Observatory"
  description="Every company the Lancashire Business Observatory profiles, and why it is included: council suppliers, growth candidates, Innovate UK winners and larger employers registered in Lancashire. Or search the full register of Lancashire-registered companies. Register facts with a source link on each profile."
>
  <div class="doge-page">
    <nav class="doge-crumbs" aria-label="Breadcrumb">
      <a href="/lancs/">Lancashire</a>
      <span class="sep">›</span>
      <a href="/lancs/business/">Business Observatory</a>
      <span class="sep">›</span>
      <span class="here">Companies</span>
    </nav>

    <header class="doge-head">
      <span class="doge-eyebrow"><span class="dot"></span> Company profiles</span>
      <h1 class="doge-title">The companies in the Observatory</h1>
      <p class="doge-sub">
        This is the list of companies the Observatory profiles, and why each one is here. Every profile is built
        from public registers, with a link to the Companies House record. It is a record of companies that touch
        public money or public data, not a directory of people, and it carries no search of directors. You can
        also search the full register of Lancashire-registered companies.
      </p>
    </header>

    <div class="doge-disclaimer" style="margin-top:1rem;">
      <strong>Inclusion criteria.</strong> <span id="co-criteria">…</span>
    </div>

    <div class="doge-statband">
      <div class="doge-stat"><div class="v teal" id="co-total">…</div><div class="l">Companies profiled</div></div>
      <div class="doge-stat"><div class="v" id="co-suppliers">…</div><div class="l">Recorded public suppliers</div></div>
      <div class="doge-stat"><div class="v" id="co-growth">…</div><div class="l">Growth candidates</div></div>
      <div class="doge-stat"><div class="v" id="co-areas">…</div><div class="l">Areas represented</div></div>
    </div>

    <section class="doge-section">
      <h2 class="doge-h2">Search the companies</h2>
      <div class="biz-toggle" role="tablist" aria-label="Search scope">
        <button class="biz-toggle-btn active" id="scope-profiles" role="tab" aria-selected="true">Profiled companies</button>
        <button class="biz-toggle-btn" id="scope-register" role="tab" aria-selected="false">Full register (<span id="scope-reg-count">104,161</span>)</button>
      </div>

      <!-- profiled companies (default) -->
      <div id="co-profiles-panel">
        <p class="doge-note">Search by name, filter by area, and sort any column. Each row opens the full company profile.</p>
        <div class="bsp-controls">
          <input class="bsp-search" id="co-search" type="search" placeholder="Search company name…" aria-label="Search profiled companies" />
          <select class="bsp-sel" id="co-area" aria-label="Area"><option value="">All areas</option></select>
          <select class="bsp-sel" id="co-badge" aria-label="Type">
            <option value="">All companies</option>
            <option value="supplier">Public suppliers</option>
            <option value="growth">Growth candidates</option>
          </select>
        </div>
        <div class="bsp-tablewrap">
          <table class="bsp-table biz-cmp-table">
            <thead>
              <tr id="co-head">
                <th data-k="name" class="biz-sortable">Company</th>
                <th data-k="lad" class="biz-sortable">Area today</th>
                <th data-k="sic2" class="biz-sortable">Sector</th>
                <th>Included as</th>
              </tr>
            </thead>
            <tbody id="co-body"></tbody>
          </table>
        </div>
        <div class="bsp-more"><button class="bsp-morebtn" id="co-more">Show more</button></div>
      </div>

      <!-- full register -->
      <div id="co-register-panel" hidden>
        <p class="doge-note">
          Search every Lancashire-registered company on the register, not only the profiled ones. Type at least
          two letters of a company name; filter by area if you like.
        </p>
        <div class="bsp-controls">
          <input class="bsp-search" id="reg-search" type="search" placeholder="Search the whole register…" aria-label="Search the full register" />
          <select class="bsp-sel" id="reg-area" aria-label="Area"><option value="">All areas</option></select>
        </div>
        <p class="biz-reg-hint" id="reg-hint">Register extract held at Companies House.</p>
        <div class="bsp-tablewrap">
          <table class="bsp-table biz-cmp-table">
            <thead>
              <tr>
                <th>Company</th>
                <th>Area today</th>
                <th>Record</th>
              </tr>
            </thead>
            <tbody id="reg-body"></tbody>
          </table>
        </div>
        <p class="biz-reg-clip" id="reg-clip" hidden></p>
      </div>
    </section>

    <BizFooter attributions={[
      'Company facts and registered offices: Companies House.',
      'Supplier status: Lancashire councils’ published payments-over-£500 transparency data (Open Government Licence v3.0).',
      'Growth and innovation flags: Companies House filed accounts and Innovate UK / UKRI funded-projects data.',
    ]} />
  </div>

  <script is:inline>
  (function () {
    var all = [], view = [], shown = 0, PAGE = 60, query = '', areaFilter = '', badgeFilter = '', sortK = 'name', sortDir = 1;

    // SIC section labels (2-digit division to a readable sector)
    var SIC = {
      '01': 'Agriculture', '10': 'Food manufacture', '41': 'Construction of buildings',
      '42': 'Civil engineering', '43': 'Specialised construction', '45': 'Motor trade',
      '46': 'Wholesale', '47': 'Retail', '49': 'Land transport', '52': 'Warehousing',
      '55': 'Accommodation', '56': 'Food and drink service', '62': 'Computer services',
      '68': 'Real estate', '69': 'Legal and accounting', '70': 'Head offices and consultancy',
      '71': 'Architecture and engineering', '77': 'Rental and leasing', '78': 'Employment services',
      '79': 'Travel', '81': 'Building and landscape services', '82': 'Business support',
      '85': 'Education', '86': 'Human health', '87': 'Residential care', '88': 'Social work',
      '90': 'Arts', '93': 'Sport and recreation', '94': 'Membership organisations'
    };
    function sector(sic2) { return SIC[sic2] || (sic2 ? 'SIC ' + sic2 : '-'); }

    function el2(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
    function td(v, cls) { var t = document.createElement('td'); if (cls) t.className = cls; t.textContent = v; return t; }

    function apply() {
      view = all.filter(function (c) {
        if (areaFilter && c.lad !== areaFilter) return false;
        if (badgeFilter === 'supplier' && !c.hasPayments) return false;
        if (badgeFilter === 'growth' && !c.isGrowth) return false;
        if (query && c.name.toLowerCase().indexOf(query) < 0) return false;
        return true;
      });
      view.sort(function (a, b) {
        var av = a[sortK], bv = b[sortK];
        av = av == null ? '' : String(av); bv = bv == null ? '' : String(bv);
        return sortDir * av.localeCompare(bv);
      });
      document.getElementById('co-body').textContent = ''; shown = 0; renderMore();
      Array.prototype.forEach.call(document.querySelectorAll('#co-head th'), function (th) {
        th.classList.remove('sorted-asc', 'sorted-desc');
        if (th.getAttribute('data-k') === sortK) {
          th.classList.add(sortDir < 0 ? 'sorted-desc' : 'sorted-asc');
          th.setAttribute('aria-sort', sortDir < 0 ? 'descending' : 'ascending');
        } else {
          th.removeAttribute('aria-sort');
        }
      });
    }

    function renderMore() {
      var body = document.getElementById('co-body');
      for (var i = shown; i < view.length && i < shown + PAGE; i++) {
        var c = view[i];
        var tr = el2('tr');
        var c0 = el2('td');
        var a = el2('a', 'biz-arealink', c.name);
        a.href = '/lancs/business/company/' + c.crn + '/';
        c0.appendChild(a);
        tr.appendChild(c0);
        tr.appendChild(td(c.lad || '-'));
        tr.appendChild(td(sector(c.sic2)));
        var bcell = el2('td');
        if (c.hasPayments) bcell.appendChild(el2('span', 'biz-chip tier-rooted', 'public supplier'));
        if (c.isGrowth) bcell.appendChild(el2('span', 'biz-chip', 'growth candidate'));
        if (!c.hasPayments && !c.isGrowth) bcell.appendChild(el2('span', 'biz-chip', 'larger employer'));
        tr.appendChild(bcell);
        body.appendChild(tr);
      }
      shown = Math.min(shown + PAGE, view.length);
      document.getElementById('co-more').style.display = shown < view.length ? '' : 'none';
      if (!view.length) { var tr = el2('tr'); tr.appendChild(td('No companies match.')); body.appendChild(tr); }
    }
    document.getElementById('co-more').addEventListener('click', renderMore);

    fetch('/data/biz-companies-index.json').then(function (r) { return r.json(); }).then(function (d) {
      all = d.companies || [];
      var meta = d.$meta || {};
      if (meta.criteria) {
        document.getElementById('co-criteria').textContent =
          'A company is included where it meets any of these tests: ' + meta.criteria + '.';
      }
      document.getElementById('co-total').textContent = all.length.toLocaleString('en-GB');
      document.getElementById('co-suppliers').textContent = all.filter(function (c) { return c.hasPayments; }).length.toLocaleString('en-GB');
      document.getElementById('co-growth').textContent = all.filter(function (c) { return c.isGrowth; }).length.toLocaleString('en-GB');
      var areas = {}; all.forEach(function (c) { if (c.lad) areas[c.lad] = true; });
      var areaKeys = Object.keys(areas).sort();
      document.getElementById('co-areas').textContent = areaKeys.length;
      var sel = document.getElementById('co-area');
      areaKeys.forEach(function (a) { var o = document.createElement('option'); o.value = a; o.textContent = a; sel.appendChild(o); });
      sel.addEventListener('change', function () { areaFilter = sel.value; apply(); });
      document.getElementById('co-badge').addEventListener('change', function (e) { badgeFilter = e.target.value; apply(); });
      var t; document.getElementById('co-search').addEventListener('input', function (e) { clearTimeout(t); t = setTimeout(function () { query = e.target.value.toLowerCase().trim(); apply(); }, 160); });
      Array.prototype.forEach.call(document.querySelectorAll('#co-head th.biz-sortable'), function (th) {
        th.addEventListener('click', function () {
          var k = th.getAttribute('data-k');
          if (k === sortK) sortDir = -sortDir; else { sortK = k; sortDir = 1; }
          apply();
        });
      });
      apply();
    }).catch(function () {
      document.getElementById('co-body').textContent = 'The company list could not be loaded.';
    });

    // ---- full-register search (lazy-loaded gzipped index) ----
    var REG_MAX = 200;
    var regRows = null, regMeta = null, regQuery = '', regArea = '', regLoading = false, regFailed = false;

    function regNote(msg, warn) {
      var hint = document.getElementById('reg-hint');
      hint.textContent = msg;
      hint.classList.toggle('warn', !!warn);
    }

    function renderRegister() {
      var body = document.getElementById('reg-body');
      var clip = document.getElementById('reg-clip');
      body.textContent = '';
      clip.hidden = true;
      if (!regRows) { return; }
      if (regQuery.length < 2 && !regArea) {
        var tr0 = document.createElement('tr');
        tr0.appendChild(td('Type at least two letters to search the register.'));
        body.appendChild(tr0);
        return;
      }
      var matched = 0, drawn = 0;
      for (var i = 0; i < regRows.length; i++) {
        var r = regRows[i];
        var name = r[1], lad = r[2], nonActive = r[3], hasDossier = r[4];
        if (regArea && lad !== regArea) continue;
        if (regQuery && String(name).toLowerCase().indexOf(regQuery) < 0) continue;
        matched++;
        if (drawn >= REG_MAX) continue;
        drawn++;
        var crn = r[0];
        var tr = document.createElement('tr');
        // company
        var c0 = document.createElement('td');
        if (hasDossier) {
          var a = document.createElement('a'); a.className = 'biz-arealink';
          a.href = '/lancs/business/company/' + crn + '/'; a.textContent = name;
          c0.appendChild(a);
        } else {
          c0.className = 'bsp-sup'; c0.textContent = name;
        }
        tr.appendChild(c0);
        // area (with inactive tag)
        var c1 = document.createElement('td');
        c1.appendChild(document.createTextNode(lad || '-'));
        if (nonActive === 1) {
          var tag = document.createElement('span'); tag.className = 'biz-tag'; tag.textContent = 'no longer active';
          c1.appendChild(tag);
        }
        tr.appendChild(c1);
        // record link
        var c2 = document.createElement('td');
        var link = document.createElement('a'); link.className = 'biz-arealink';
        if (hasDossier) {
          link.href = '/lancs/business/company/' + crn + '/'; link.textContent = 'Observatory profile →';
        } else {
          link.href = 'https://find-and-update.company-information.service.gov.uk/company/' + crn;
          link.target = '_blank'; link.rel = 'noopener'; link.textContent = 'Companies House →';
        }
        c2.appendChild(link);
        tr.appendChild(c2);
        body.appendChild(tr);
      }
      if (!matched) {
        var trn = document.createElement('tr');
        trn.appendChild(td('No companies on the register match.'));
        body.appendChild(trn);
      } else if (matched > REG_MAX) {
        clip.hidden = false;
        clip.textContent = 'Showing the first ' + REG_MAX.toLocaleString('en-GB') + ' of ' +
          matched.toLocaleString('en-GB') + ' matches. Refine your search to narrow it down.';
      }
    }

    function loadRegister() {
      if (regRows || regLoading || regFailed) { return; }
      regLoading = true;
      regNote('Loading the full register (about 1.5 MB)…');
      fetch('/data/biz-register-index.json.gz').then(function (resp) {
        if (!resp.ok) throw new Error('fetch');
        return resp.arrayBuffer();
      }).then(function (buf) {
        var bytes = new Uint8Array(buf);
        // gzip magic bytes: raw file (Cloudflare / GitHub Pages). Some dev servers
        // send Content-Encoding: gzip and hand back already-decompressed bytes.
        if (bytes.length > 2 && bytes[0] === 0x1f && bytes[1] === 0x8b) {
          if (typeof DecompressionStream === 'undefined') { throw { noDS: true }; }
          var stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));
          return new Response(stream).text();
        }
        return new TextDecoder().decode(bytes);
      }).then(function (text) {
        var d = JSON.parse(text);
        regRows = d.rows || [];
        regMeta = d.$meta || {};
        regLoading = false;
        if (regMeta.n) document.getElementById('scope-reg-count').textContent = Number(regMeta.n).toLocaleString('en-GB');
        regNote('Register extract as at ' + (regMeta.generated || 'the retrieval date') + '. Full records are held at Companies House.');
        // area dropdown from the register
        var areas = {}; regRows.forEach(function (r) { if (r[2]) areas[r[2]] = true; });
        var sel = document.getElementById('reg-area');
        Object.keys(areas).sort().forEach(function (a) { var o = document.createElement('option'); o.value = a; o.textContent = a; sel.appendChild(o); });
        renderRegister();
      }).catch(function (err) {
        regLoading = false; regFailed = true;
        if (err && err.noDS) {
          regNote('Full-register search needs a current browser. Your browser cannot decompress the register file; the profiled-companies search above still works.', true);
        } else {
          regNote('The full register could not be loaded. The profiled-companies search above still works.', true);
        }
      });
    }

    var rt;
    document.getElementById('reg-search').addEventListener('input', function (e) {
      clearTimeout(rt);
      var v = e.target.value.toLowerCase().trim();
      rt = setTimeout(function () { regQuery = v; renderRegister(); }, 180);
    });
    document.getElementById('reg-area').addEventListener('change', function (e) { regArea = e.target.value; renderRegister(); });

    // scope toggle
    function setScope(reg) {
      document.getElementById('scope-profiles').classList.toggle('active', !reg);
      document.getElementById('scope-register').classList.toggle('active', reg);
      document.getElementById('scope-profiles').setAttribute('aria-selected', String(!reg));
      document.getElementById('scope-register').setAttribute('aria-selected', String(reg));
      document.getElementById('co-profiles-panel').hidden = reg;
      document.getElementById('co-register-panel').hidden = !reg;
      if (reg) { loadRegister(); }
    }
    document.getElementById('scope-profiles').addEventListener('click', function () { setScope(false); });
    document.getElementById('scope-register').addEventListener('click', function () { setScope(true); });
  })();
  </script>
</Layout>

---
import Layout from '../../../../layouts/Layout.astro';
import BizFooter from '../../../../components/BizFooter.astro';
import { CONTACT_EMAIL } from '../../../../config';
import '../../../../styles/doge.css';
import '../../../../styles/lgr.css';
import indexData from '../../../../../public/data/biz-companies-index.json';
import fs from 'node:fs';
import path from 'node:path';

// One route per company in the index. The full dossier is still fetched client-side
// from /data/company/{crn}.json for the interactive body, but the register facts are
// also read at build time and rendered into the HTML below. Without that, every one
// of these pages served byte-identical boilerplate to any crawler that does not run
// JavaScript, which is what a duplicate-page cluster looks like from outside.
const DOSSIER_DIR = path.resolve('./public/data/company');

function readDossier(crn) {
  try {
    return JSON.parse(fs.readFileSync(path.join(DOSSIER_DIR, `${crn}.json`), 'utf-8'));
  } catch {
    return null;
  }
}

export function getStaticPaths() {
  return (indexData.companies || []).map((c) => ({
    params: { crn: c.crn },
    props: { crn: c.crn, name: c.name, lad: c.lad },
  }));
}

const { crn, name, lad } = Astro.props;
const PROPS = JSON.stringify({ crn, name, lad });
const subject = encodeURIComponent('Company profile correction: ' + name + ' (' + crn + ')');

const dossier = readDossier(crn);
const reg = dossier?.register ?? {};
const pageUrl = `https://tompickup.co.uk/lancs/business/company/${crn}/`;

function ukYear(dmy) {
  if (!dmy) return null;
  const m = String(dmy).match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
  return m ? m[3] : (String(dmy).match(/^(\d{4})/)?.[1] ?? null);
}
function isoDate(dmy) {
  if (!dmy) return null;
  const m = String(dmy).match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
  return m ? `${m[3]}-${m[2]}-${m[1]}` : null;
}

const incorporatedYear = ukYear(reg.incorporated);
const latestAccounts = (dossier?.accountsSeries ?? []).at(-1) ?? null;
const paymentCount = (dossier?.payments ?? []).length;

// Facts, in a fixed order, only where the register actually holds a value.
const facts = [
  ['Company number', crn],
  ['Status', reg.status],
  ['Company type', reg.companyType],
  ['Incorporated', reg.incorporated],
  ['Registered district', reg.lad ?? lad],
  ['Registered postcode', reg.registeredPostcode],
  ['Nature of business (SIC)', reg.sic],
  ['Employees, latest accounts', latestAccounts?.employees != null
    ? Number(latestAccounts.employees).toLocaleString('en-GB') : null],
].filter(([, v]) => v != null && v !== '');

// A description built from this company's own facts. Every one of these pages
// previously shared a single 242-character boilerplate description.
const descBits = [
  reg.companyType ? `${reg.companyType.toLowerCase()}` : 'company',
  incorporatedYear ? `incorporated ${incorporatedYear}` : null,
  (reg.lad ?? lad) ? `registered in ${reg.lad ?? lad}` : null,
  reg.status ? `status ${reg.status.toLowerCase()}` : null,
].filter(Boolean).join(', ');

const paymentsBit = paymentCount > 0
  ? ` Council payments on record.`
  : '';

// Build up to the SERP limit by whole clauses. Cutting mid-word leaves a snippet
// ending in "from...", which reads as broken rather than truncated.
const descLead = `${name} (${crn}): ${descBits}.`;
const descTail = ' Public register facts from Companies House and council spending.';
const metaDescription = (descLead + paymentsBit + descTail).length <= 158
  ? descLead + paymentsBit + descTail
  : (descLead + paymentsBit).length <= 158
    ? descLead + paymentsBit
    : descLead.length <= 158
      ? descLead
      : `${name} (${crn}): public register facts, ${reg.lad ?? lad}, Lancashire.`;

const pageTitle = `${name} (${crn}), ${reg.lad ?? lad} company records`;

// WebPage about an Organization, not Organization on its own: this is a profile
// of a third party built from public registers, it is not the company's own page.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      url: pageUrl,
      name: pageTitle,
      description: metaDescription,
      inLanguage: 'en-GB',
      isPartOf: { '@id': 'https://tompickup.co.uk/#website' },
      about: { '@id': `${pageUrl}#organization` },
      ...(dossier?.$meta?.generated ? { dateModified: dossier.$meta.generated } : {}),
    },
    {
      '@type': 'Organization',
      '@id': `${pageUrl}#organization`,
      name,
      identifier: crn,
      ...(reg.chUrl ? { sameAs: [reg.chUrl] } : {}),
      ...(dossier?.website ? { url: dossier.website } : {}),
      ...(isoDate(reg.incorporated) ? { foundingDate: isoDate(reg.incorporated) } : {}),
      ...(latestAccounts?.employees != null
        ? { numberOfEmployees: { '@type': 'QuantitativeValue', value: latestAccounts.employees } }
        : {}),
      ...((reg.registeredPostcode || reg.lad || lad) ? {
        address: {
          '@type': 'PostalAddress',
          ...(reg.registeredPostcode ? { postalCode: reg.registeredPostcode } : {}),
          ...((reg.lad ?? lad) ? { addressLocality: reg.lad ?? lad } : {}),
          addressRegion: 'Lancashire',
          addressCountry: 'GB',
        },
      } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Lancashire', item: 'https://tompickup.co.uk/lancs/' },
        { '@type': 'ListItem', position: 2, name: 'Business Observatory', item: 'https://tompickup.co.uk/lancs/business/' },
        { '@type': 'ListItem', position: 3, name: 'Companies', item: 'https://tompickup.co.uk/lancs/business/companies/' },
        { '@type': 'ListItem', position: 4, name, item: pageUrl },
      ],
    },
  ],
};
---

<Layout title={pageTitle} description={metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="doge-page" data-props={PROPS}>
    <nav class="doge-crumbs" aria-label="Breadcrumb">
      <a href="/lancs/">Lancashire</a>
      <span class="sep">›</span>
      <a href="/lancs/business/">Business Observatory</a>
      <span class="sep">›</span>
      <a href="/lancs/business/companies/">Companies</a>
      <span class="sep">›</span>
      <span class="here">{name}</span>
    </nav>

    <header class="doge-head biz-dossier-head">
      <span class="doge-eyebrow"><span class="dot"></span> Company profile</span>
      <h1 class="doge-title" id="cp-name">{name}</h1>
      <div class="biz-dossier-meta" id="cp-meta-strip"></div>
    </header>

    <p class="biz-footprint" id="cp-footprint"></p>

    {facts.length > 0 && (
      <section class="cp-register-facts">
        <h2>Register facts</h2>
        <dl>
          {facts.map(([label, value]) => (
            <>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </>
          ))}
        </dl>
        {reg.chUrl && (
          <p class="cp-register-source">
            Source: <a href={reg.chUrl} rel="nofollow noopener" target="_blank">Companies House register entry for {name}</a>.
            {dossier?.$meta?.generated && <> Snapshot taken {dossier.$meta.generated}.</>}
          </p>
        )}
      </section>
    )}

    <div id="cp-body"></div>

    <div class="biz-respond">
      Is something on this profile wrong or out of date? These are register facts and Observatory assessments,
      not judgements about the company. Respond to this profile at
      <a id="cp-respond" href={`mailto:${CONTACT_EMAIL}?subject=${subject}`}>{CONTACT_EMAIL}</a>.
      Reports are acknowledged within 48 hours and re-checked at the primary source; where a figure is wrong it is
      corrected within five working days and logged.
    </div>

    <BizFooter />
  </div>

  <script is:inline>
  (function () {
    var el = document.querySelector('.doge-page[data-props]');
    var P = JSON.parse(el.getAttribute('data-props'));

    var LAD = {
      E06000008: 'Blackburn with Darwen', E06000009: 'Blackpool',
      E07000117: 'Burnley', E07000118: 'Chorley', E07000119: 'Fylde',
      E07000120: 'Hyndburn', E07000121: 'Lancaster', E07000122: 'Pendle',
      E07000123: 'Preston', E07000124: 'Ribble Valley', E07000125: 'Rossendale',
      E07000126: 'South Ribble', E07000127: 'West Lancashire', E07000128: 'Wyre'
    };
    function ladName(x) { return LAD[x] || x; }

    var TIER_LABEL = {
      rooted: 'Rooted local', tradingExternal: 'Trades here, owned away',
      nonLocal: 'Non-local', unclassified: 'Not classified',
      councilOwned: 'Council-owned'
    };
    var TIER_CLS = {
      rooted: 'tier-rooted', tradingExternal: 'tier-trading',
      nonLocal: 'tier-nonlocal', unclassified: 'tier-unclassified',
      councilOwned: 'tier-unclassified'
    };

    function n(v) { return (v === null || v === undefined) ? '-' : v.toLocaleString('en-GB'); }
    function moneyM(v) { return (v === null || v === undefined) ? '-' : '£' + v.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + 'm'; }
    function poundsFull(v) {
      if (v === null || v === undefined) return '-';
      if (Math.abs(v) >= 1000000) return '£' + (v / 1000000).toFixed(2) + 'm';
      if (Math.abs(v) >= 1000) return '£' + (v / 1000).toFixed(1) + 'k';
      return '£' + v.toLocaleString('en-GB');
    }
    function ukDate(iso) {
      if (!iso) return '-';
      var p = String(iso).split('-');
      if (p.length === 3) return p[2] + '/' + p[1] + '/' + p[0];
      return iso;
    }
    function el2(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
    function td(v, cls) { var t = document.createElement('td'); if (cls) t.className = cls; t.textContent = v; return t; }

    // small inline SVG sparkline from a numeric series
    function sparkline(values, width, height) {
      var svgns = 'http://www.w3.org/2000/svg';
      var vals = values.filter(function (v) { return v !== null && v !== undefined; });
      if (vals.length < 2) return null;
      var min = Math.min.apply(null, vals), max = Math.max.apply(null, vals);
      var span = (max - min) || 1;
      var svg = document.createElementNS(svgns, 'svg');
      svg.setAttribute('viewBox', '0 0 ' + width + ' ' + height);
      svg.setAttribute('width', String(width)); svg.setAttribute('height', String(height));
      svg.setAttribute('class', 'biz-spark');
      svg.setAttribute('role', 'img');
      var pts = [];
      for (var i = 0; i < values.length; i++) {
        if (values[i] === null || values[i] === undefined) continue;
        var x = (values.length === 1) ? 0 : (i / (values.length - 1)) * (width - 4) + 2;
        var y = height - 3 - ((values[i] - min) / span) * (height - 6);
        pts.push([x, y]);
      }
      var poly = document.createElementNS(svgns, 'polyline');
      poly.setAttribute('points', pts.map(function (p) { return p[0].toFixed(1) + ',' + p[1].toFixed(1); }).join(' '));
      poly.setAttribute('fill', 'none'); poly.setAttribute('stroke', '#12b6cf'); poly.setAttribute('stroke-width', '1.6');
      poly.setAttribute('stroke-linejoin', 'round'); poly.setAttribute('stroke-linecap', 'round');
      svg.appendChild(poly);
      var last = pts[pts.length - 1];
      var dot = document.createElementNS(svgns, 'circle');
      dot.setAttribute('cx', last[0].toFixed(1)); dot.setAttribute('cy', last[1].toFixed(1)); dot.setAttribute('r', '2');
      dot.setAttribute('class', 'biz-spark-dot');
      svg.appendChild(dot);
      return svg;
    }

    function panel(title, sub) {
      var p = el2('section', 'biz-panel');
      p.appendChild(el2('h2', 'biz-panel-h', title));
      if (sub) p.appendChild(el2('p', 'biz-panel-sub', sub));
      return p;
    }

    function render(d) {
      var reg = d.register || {};

      // The register facts are rendered server-side so crawlers and no-JS readers
      // get real content. Once the full dossier loads, the richer interactive
      // version below supersedes it, so drop the static block to avoid showing
      // the same fields twice.
      var staticFacts = document.querySelector('.cp-register-facts');
      if (staticFacts && staticFacts.parentNode) staticFacts.parentNode.removeChild(staticFacts);

      // header meta strip: status, CRN link, type, CIC
      var strip = document.getElementById('cp-meta-strip');
      var status = reg.status || 'Unknown';
      var sl = status.toLowerCase();
      var statusCls = sl.indexOf('active') >= 0 ? 'active'
        : (sl.indexOf('dissolved') >= 0 || sl.indexOf('closed') >= 0) ? 'dissolved' : 'warn';
      strip.appendChild(el2('span', 'biz-status ' + statusCls, status));
      var crnLink = el2('a', 'biz-crn-link', 'Companies House ' + P.crn + ' ↗');
      crnLink.href = reg.chUrl || ('https://find-and-update.company-information.service.gov.uk/company/' + P.crn);
      crnLink.target = '_blank'; crnLink.rel = 'noopener';
      strip.appendChild(crnLink);
      if (reg.cic) strip.appendChild(el2('span', 'biz-cic', 'Community interest company'));
      if (d.$meta && d.$meta.generated) {
        strip.appendChild(el2('span', 'biz-datestamp',
          'Register facts retrieved to ' + d.$meta.generated + '; figures reflect the register at that date.'));
      }

      // meta grid
      var grid = el2('div', 'biz-metagrid');
      function metacell(k, v) {
        if (v == null || v === '') return;
        var c = el2('div', 'biz-metacell');
        c.appendChild(el2('div', 'biz-meta-k', k));
        c.appendChild(el2('div', 'biz-meta-v', v));
        grid.appendChild(c);
      }
      metacell('Company type', reg.companyType);
      metacell('Sector', reg.sicLabel || (reg.sic ? reg.sic.split(' - ')[0] : null));
      metacell('SIC code', reg.sic ? reg.sic.split(' - ')[0] : null);
      metacell('Incorporated', reg.incorporated);
      metacell('Registered postcode', reg.registeredPostcode);
      metacell('Area today', reg.lad);
      metacell('From April 2028', reg.unitary2028 ? reg.unitary2028 + ' unitary council' : null);
      metacell('Accounts category', reg.accountsCategory);
      document.getElementById('cp-body').appendChild(grid);

      // verified website. Shown only when the site itself proved the match,
      // and always with the basis and the quoted evidence.
      var w = d.website;
      if (w && w.url) {
        var wrow = el2('p', 'biz-infoline');
        wrow.appendChild(el2('strong', null, 'Website. '));
        var wa = el2('a', 'biz-arealink',
          w.url.replace(/^https?:\/\//, '').replace(/\/$/, ''));
        wa.href = w.url; wa.target = '_blank'; wa.rel = 'nofollow noopener';
        wrow.appendChild(wa);
        var basis = w.matchedOn === 'crn'
          ? ' Matched because company registration number ' + P.crn + ' appears on the site itself'
          : ' Matched because the registered company name and the registered office postcode both appear on the site itself';
        var when = w.checkedAt ? (', checked ' + ukDate(String(w.checkedAt).slice(0, 10))) : '';
        wrow.appendChild(document.createTextNode(basis + when + '. Quoted from the page: '));
        wrow.appendChild(el2('span', 'biz-basis', '"' + w.evidence + '"'));
        wrow.appendChild(document.createTextNode(' Linking is not endorsement and the Observatory is not responsible for the content of external sites.'));
        document.getElementById('cp-body').appendChild(wrow);
      }

      if (reg.addressClusterNote) {
        var info = el2('p', 'biz-infoline', reg.addressClusterNote);
        document.getElementById('cp-body').appendChild(info);
      }

      // footprint strip
      var fp = d.footprint || {};
      var fpEl = document.getElementById('cp-footprint');
      var evLads = (fp.evidenceLads || []).map(ladName);
      var fpParts = [];
      fpParts.push('Registered in ' + (fp.registeredLad || reg.lad || 'Lancashire') + '.');
      if (fp.unitary2028) fpParts.push('Part of the new ' + fp.unitary2028 + ' unitary council from April 2028.');
      if (evLads.length) fpParts.push('Register evidence of activity in: ' + evLads.join(', ') + '.');
      var strong = el2('strong', null, 'Footprint. ');
      fpEl.appendChild(strong);
      fpEl.appendChild(document.createTextNode(fpParts.join(' ')));

      var body = document.getElementById('cp-body');

      // accounts series
      var acc = d.accountsSeries || [];
      if (acc.length) {
        var ap = panel('Filed accounts', 'Figures as filed at Companies House under section 411 of the Companies Act 2006. The register at each period end.');
        var wrap = el2('div', 'bsp-tablewrap');
        var table = el2('table', 'bsp-table biz-cmp-table');
        var thead = el2('thead');
        var htr = el2('tr');
        ['Period end', 'Employees', 'Shareholders’ equity', 'Total assets', 'Cash'].forEach(function (h, i) {
          htr.appendChild(el2('th', i === 0 ? '' : 'num', h));
        });
        thead.appendChild(htr); table.appendChild(thead);
        var tb = el2('tbody');
        acc.forEach(function (a) {
          var tr = el2('tr');
          tr.appendChild(td(ukDate(a.periodEnd), 'bsp-date'));
          tr.appendChild(td(a.employees == null ? '-' : n(a.employees), 'num'));
          tr.appendChild(td(poundsFull(a.equity), 'num biz-amt'));
          tr.appendChild(td(poundsFull(a.totalAssets), 'num'));
          tr.appendChild(td(poundsFull(a.cash), 'num'));
          tb.appendChild(tr);
        });
        table.appendChild(tb); wrap.appendChild(table); ap.appendChild(wrap);
        // employee mini trend
        var empSeries = acc.map(function (a) { return a.employees; });
        var haveEmp = empSeries.filter(function (v) { return v != null; });
        if (haveEmp.length >= 2) {
          var trendWrap = el2('p', 'biz-panel-sub');
          trendWrap.style.marginTop = '0.8rem'; trendWrap.style.marginBottom = '0';
          trendWrap.appendChild(document.createTextNode('Employees over the filed periods: ' + haveEmp.join(' to ') + '  '));
          var sp = sparkline(empSeries, 90, 22);
          if (sp) { sp.setAttribute('aria-label', 'Employee trend: ' + haveEmp.join(' to ')); trendWrap.appendChild(sp); }
          ap.appendChild(trendWrap);
        }
        body.appendChild(ap);
      }

      // public payments
      var pays = d.payments || [];
      if (pays.length) {
        var pp = panel('Public money received', 'Payments recorded in Lancashire councils’ published payments-over-£500 transparency data. This is not a complete account of any body’s budget: it excludes payments below the threshold and lawfully redacted payments.');
        var pwrap = el2('div', 'bsp-tablewrap');
        var ptable = el2('table', 'bsp-table biz-cmp-table');
        var pthead = el2('thead'); var pthr = el2('tr');
        pthr.appendChild(el2('th', '', 'Public body'));
        pthr.appendChild(el2('th', 'num', 'Recorded spend'));
        pthr.appendChild(el2('th', '', 'Years'));
        pthead.appendChild(pthr); ptable.appendChild(pthead);
        var ptb = el2('tbody');
        pays.forEach(function (pay) {
          var tr = el2('tr');
          tr.appendChild(td(pay.body, 'bsp-sup'));
          tr.appendChild(td(moneyM(pay.totalM), 'num biz-amt'));
          tr.appendChild(td((pay.years || []).join(', '), 'biz-basis'));
          ptb.appendChild(tr);
        });
        ptable.appendChild(ptb); pwrap.appendChild(ptable); pp.appendChild(pwrap);
        body.appendChild(pp);
      }

      // innovation awards
      var innov = d.innovation || [];
      if (innov.length) {
        var ip = panel('Innovation funding', 'Research and development grants recorded in the published Innovate UK / UKRI funded-projects data.');
        var iwrap = el2('div', 'bsp-tablewrap');
        var itable = el2('table', 'bsp-table biz-cmp-table');
        var ithead = el2('thead'); var ithr = el2('tr');
        ithr.appendChild(el2('th', '', 'Project'));
        ithr.appendChild(el2('th', '', 'Type'));
        ithr.appendChild(el2('th', 'num', 'Year'));
        ithr.appendChild(el2('th', 'num', 'Award'));
        ithead.appendChild(ithr); itable.appendChild(ithead);
        var itb = el2('tbody');
        innov.forEach(function (a) {
          var tr = el2('tr');
          tr.appendChild(td(a.title, 'bsp-sup'));
          tr.appendChild(td(a.type || '-'));
          tr.appendChild(td(a.year || '-', 'num bsp-date'));
          tr.appendChild(td(a.awardK == null ? '-' : (a.awardK >= 1000 ? '£' + (a.awardK / 1000).toFixed(2) + 'm' : '£' + a.awardK.toLocaleString('en-GB') + 'k'), 'num biz-amt'));
          itb.appendChild(tr);
        });
        itable.appendChild(itb); iwrap.appendChild(itable); ip.appendChild(iwrap);
        body.appendChild(ip);
      }

      // gazette notices (only if present)
      var gaz = d.gazetteNotices || [];
      if (gaz.length) {
        var gp = panel('Gazette notices', 'Notices published about this company in The Gazette, the official public record. Shown verbatim with a link to each source notice.');
        var gwrap = el2('div', 'bsp-tablewrap');
        var gtable = el2('table', 'bsp-table biz-cmp-table');
        var gthead = el2('thead'); var gthr = el2('tr');
        gthr.appendChild(el2('th', '', 'Date'));
        gthr.appendChild(el2('th', '', 'Notice'));
        gthr.appendChild(el2('th', 'num', 'Source'));
        gthead.appendChild(gthr); gtable.appendChild(gthead);
        var gtb = el2('tbody');
        gaz.forEach(function (g) {
          var tr = el2('tr');
          tr.appendChild(td(ukDate(g.date), 'bsp-date'));
          tr.appendChild(td(g.type || '-'));
          var srcTd = el2('td', 'num');
          if (g.uri) {
            var a = el2('a', 'biz-arealink', 'Gazette ↗'); a.href = g.uri; a.target = '_blank'; a.rel = 'noopener';
            srcTd.appendChild(a);
          } else { srcTd.textContent = '-'; }
          tr.appendChild(srcTd);
          gtb.appendChild(tr);
        });
        gtable.appendChild(gtb); gwrap.appendChild(gtable); gp.appendChild(gwrap);
        body.appendChild(gp);
      }

      // ownership
      var ow = d.ownership || {};
      var hasOwn = ow.tier || (ow.chain && ow.chain.length) || (ow.pscIndividuals && ow.pscIndividuals.length);
      if (hasOwn) {
        var op = panel('Ownership and control', 'Where control of the company sits, read from the register. The tier is an Observatory assessment; the facts it rests on are shown alongside.');
        if (ow.tier) {
          var chiprow = el2('div', 'biz-chiprow');
          var chip = el2('span', 'biz-chip ' + (TIER_CLS[ow.tier] || 'tier-unclassified'), TIER_LABEL[ow.tier] || ow.tier);
          chiprow.appendChild(chip);
          op.appendChild(chiprow);
        }
        if (ow.chain && ow.chain.length) {
          op.appendChild(el2('div', 'biz-meta-k', 'Ownership chain per the register'));
          var cl = el2('ul', 'biz-chain-list');
          ow.chain.forEach(function (c) {
            var li = el2('li');
            var where = c.where ? (', registered ' + (/^[A-Z]{1,2}\d/.test(c.where) ? 'at ' + c.where : 'in ' + c.where)) : '';
            li.textContent = c.name + (c.crn ? ' (' + c.crn + ')' : '') + where + '.';
            cl.appendChild(li);
          });
          op.appendChild(cl);
        }
        if (ow.pscIndividuals && ow.pscIndividuals.length) {
          op.appendChild(el2('div', 'biz-meta-k', 'Persons with significant control per the register'));
          var pl = el2('ul', 'biz-psc-list');
          ow.pscIndividuals.forEach(function (psc) {
            var li = el2('li');
            li.appendChild(document.createTextNode(psc.name + ' '));
            if (psc.country) li.appendChild(el2('span', 'country', '(' + psc.country + ')'));
            pl.appendChild(li);
          });
          op.appendChild(pl);
        }
        op.appendChild(el2('p', 'biz-assess', 'Observatory assessment. The tier above is our reading of the ownership and registered-office facts shown; it is not a statement about the company’s conduct, solvency or probity. '));
        (function(){var a=document.createElement('a');a.href='/lancs/business/method/';a.textContent='How tiers are set';op.lastChild.appendChild(a);})();
        body.appendChild(op);
      }

      // growth assessment
      var gr = d.growth;
      if (gr) {
        var grp = panel('Growth assessment', 'Read from employee numbers disclosed in the filed accounts. This is an Observatory opinion, not a statement of fact about the company.');
        var series = (gr.series || []).map(function (s) { return s.employees; });
        if (series.filter(function (v) { return v != null; }).length >= 2) {
          var line = el2('p', 'biz-panel-sub'); line.style.marginBottom = '0';
          line.appendChild(document.createTextNode('Employees: ' + series.filter(function (v) { return v != null; }).join(' to ') + '  '));
          var sp2 = sparkline(series, 90, 22);
          if (sp2) { sp2.setAttribute('aria-label', 'Employee growth: ' + series.join(' to ')); line.appendChild(sp2); }
          grp.appendChild(line);
        }
        var crow = el2('div', 'biz-chiprow'); crow.style.marginTop = '0.7rem';
        if (gr.cagrPct != null) crow.appendChild(el2('span', 'biz-chip tier-rooted', 'Compound growth ' + gr.cagrPct.toFixed(1) + '% a year'));
        var FLAG_LABEL = { 'ons-definition': 'meets ONS high-growth definition', 'emerging': 'emerging (small base)', 'young-company': 'under 6 years old', 'eurostat-10': 'meets Eurostat 10%+ measure' };
        (gr.flags || []).forEach(function (f) { crow.appendChild(el2('span', 'biz-chip', FLAG_LABEL[f] || f)); });
        grp.appendChild(crow);
        if (gr.basis) grp.appendChild(el2('p', 'biz-assess', 'Observatory assessment. Basis: ' + gr.basis));
        body.appendChild(grp);
      }

      // momentum (only if present)
      var mo = d.momentum;
      if (mo) {
        var mp = panel('Register momentum', 'Recent filing activity on the register.');
        var allot = (mo.equityAllotments24m != null) ? mo.equityAllotments24m : (mo.equityAllotments != null ? mo.equityAllotments : (mo.allotments != null ? mo.allotments : 0));
        var charges = (mo.newCharges != null) ? mo.newCharges : (mo.charges != null ? mo.charges : 0);
        mp.appendChild(el2('p', 'biz-panel-sub', 'Equity allotment filings in the last 24 months: ' + n(allot) + '; new charges registered: ' + n(charges) + '. Register facts.'));
        body.appendChild(mp);
      }
    }

    fetch('/data/company/' + P.crn + '.json').then(function (r) {
      if (!r.ok) throw new Error('not found');
      return r.json();
    }).then(render).catch(function () {
      var b = document.getElementById('cp-body');
      b.appendChild(el2('p', 'biz-empty', 'The full record for this company could not be loaded. The register entry is at Companies House.'));
    });
  })();
  </script>
</Layout>

{
  "name": "tompickup.co.uk",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:observatory": "bash scripts/parked-dev.sh observatory",
    "dev:doge": "bash scripts/parked-dev.sh doge",
    "prebuild": "node scripts/guard-parked.mjs pre && node scripts/generate_budget_game_card.mjs",
    "build": "astro build",
    "postbuild": "node scripts/strip-parked-data.mjs && node scripts/guard-parked.mjs post && node scripts/guard-unreferenced.mjs && node scripts/guard-share-cards.mjs && node scripts/guard-budget-game-card.mjs && node scripts/guard-metadata.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "astro": "^5.17.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "satori": "0.63.2"
  }
}

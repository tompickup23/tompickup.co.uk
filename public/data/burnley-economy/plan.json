  "objectives": [
   {
    "title": "Employment",
    "text": "Bring more working age residents into sustained work. The gap is inactivity, mostly ill health, not unemployment."
   },
   {
    "title": "Pay",
    "text": "Raise the pay of jobs located in Burnley towards England's. Workplace pay has stayed at about 80% of England's for ten years."
   },
   {
    "title": "Resilience",
    "text": "Widen and steady the business base. A smaller share of new firms lasts five years in Burnley than in England, wholesale and retail output is falling, and one sector carries a large share of output."
   }
